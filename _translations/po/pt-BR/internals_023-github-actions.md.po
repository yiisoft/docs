msgstr "Este documento define a convenção de nomes para os arquivos de configuração das GitHub Actions."

#. type: Title ##
#: ../src/internals/023-github-actions.md
#, no-wrap
msgid "Inputs and Outputs"
msgstr "Inputs e outputs"

#. type: Plain text
#: ../src/internals/023-github-actions.md
msgid "Input names and output names must use kebab-case format."
msgstr "Os nomes de inputs e de outputs devem usar o formato kebab-case."

#. type: Plain text
#: ../src/internals/023-github-actions.md
msgid "For example:"
msgstr "Por exemplo:"

#. type: Fenced code block (yaml)
#: ../src/internals/023-github-actions.md
#, no-wrap
msgid ""
"inputs:\n"
"  my-input:\n"
"    description: 'My input'\n"
msgstr ""
"inputs:\n"
"  my-input:\n"
"    description: 'My input'\n"

#. type: Title ##
#: ../src/internals/023-github-actions.md
#, no-wrap
msgid "Secrets and Environment Variables"
msgstr "Secrets e variáveis de ambiente"

#. type: Plain text
#: ../src/internals/023-github-actions.md
msgid "Secret names and environment variable names must use SCREAMING_SNAKE_CASE format."
msgstr "Os nomes de secrets e de variáveis de ambiente devem usar o formato SCREAMING_SNAKE_CASE."

#. type: Fenced code block (yaml)
#: ../src/internals/023-github-actions.md
#, no-wrap
msgid ""
"secrets:\n"
"  MY_SECRET:\n"
"    description: 'My secret'\n"
msgstr ""
"secrets:\n"
"  MY_SECRET:\n"
"    description: 'My secret'\n"

#. type: Fenced code block (yaml)
#: ../src/internals/023-github-actions.md
#, no-wrap
msgid ""
"env:\n"
"  MY_ENV_VAR: 1\n"
msgstr ""
"env:\n"
