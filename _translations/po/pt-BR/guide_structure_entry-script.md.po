#. type: Title #
#: ../src/guide/structure/entry-script.md
#, no-wrap
msgid "Entry scripts"
msgstr "Scripts de entrada"

#. type: Plain text
#: ../src/guide/structure/entry-script.md
msgid "Entry scripts are the first step in the application bootstrapping process. An application (either Web application or console application) has a single entry script. End users make requests to entry scripts which instantiate application instances and forward the requests to them."
msgstr "Os scripts de entrada são o primeiro passo no processo de inicialização da aplicação. Uma aplicação (seja web ou de console) tem um único script de entrada. Os usuários finais fazem requisições aos scripts de entrada, que instanciam a aplicação e encaminham as requisições para ela."

#. type: Plain text
#: ../src/guide/structure/entry-script.md
msgid "Entry scripts for Web applications must be stored under Web-accessible directories so that they can be accessed by end users. They're often named as `index.php`, but can also use any other names, provided Web servers can locate them."
msgstr "Os scripts de entrada de aplicações web devem ficar em pastas acessíveis pela web, para que os usuários finais possam acessá-los. Eles costumam se chamar `index.php`, mas podem ter qualquer outro nome, desde que os servidores web consigam localizá-los."

#. type: Plain text
#: ../src/guide/structure/entry-script.md
msgid "Entry script for console application is `./yii`."
msgstr "O script de entrada da aplicação de console é `./yii`."

#. type: Plain text
#: ../src/guide/structure/entry-script.md
msgid "Entry scripts mainly perform the following work with the help of `ApplicationRunner`:"
msgstr "Os scripts de entrada fazem principalmente o seguinte, com a ajuda do `ApplicationRunner`:"

#. type: Bullet: '* '
#: ../src/guide/structure/entry-script.md
msgid "Register [Composer autoloader](https://getcomposer.org/doc/01-basic-usage.md#autoloading);"
msgstr "Registram o [autoloader do Composer](https://getcomposer.org/doc/01-basic-usage.md#autoloading);"

#. type: Bullet: '* '
#: ../src/guide/structure/entry-script.md
msgid "Obtain configuration;"
msgstr "Obtêm a configuração;"

#. type: Bullet: '* '
#: ../src/guide/structure/entry-script.md
msgid "Use configuration to initialize a dependency injection container;"
msgstr "Usam a configuração para inicializar um container de injeção de dependência;"

#. type: Bullet: '* '
#: ../src/guide/structure/entry-script.md
msgid "Get an instance of the request."
msgstr "Obtêm uma instância da requisição."

#. type: Bullet: '* '
#: ../src/guide/structure/entry-script.md
msgid "Pass it to `Application` to handle and get a response from it."
msgstr "Passam-na para a `Application` tratar e obtêm dela uma resposta."

#. type: Bullet: '* '
#: ../src/guide/structure/entry-script.md
msgid "With the help of an emitter that transforms a response object into an actual HTTP response that's sent to the client browser."
msgstr "Com a ajuda de um emitter, transformam o objeto de resposta em uma resposta HTTP real, que é enviada ao navegador do cliente."

#. type: Title ##
#: ../src/guide/structure/entry-script.md
#, no-wrap
msgid "Web Applications"
msgstr "Aplicações web"

#. type: Plain text
#: ../src/guide/structure/entry-script.md
msgid "The following is the code in the entry script for the application template:"
msgstr "Este é o código do script de entrada do template de aplicação:"

#. type: Fenced code block (php)
#: ../src/guide/structure/entry-script.md
#, no-wrap
msgid ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"use App\\ApplicationRunner;\n"
"\n"
"// PHP built-in server routing.\n"
"if (PHP_SAPI === 'cli-server') {\n"
"    // Serve static files as is.\n"
"    if (is_file(__DIR__ . $_SERVER['REQUEST_URI'])) {\n"
"        return false;\n"
"    }\n"
"\n"
"    // Explicitly set for URLs with dot.\n"
"    $_SERVER['SCRIPT_NAME'] = '/index.php';\n"
"}\n"
"\n"
"require_once dirname(__DIR__) . '/vendor/autoload.php';\n"
"\n"
"$runner = new ApplicationRunner();\n"
"// Development mode:\n"
"$runner->debug();\n"
"// Run application:\n"
"$runner->run();\n"
msgstr ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"use App\\ApplicationRunner;\n"
"\n"
"// Roteamento do servidor embutido do PHP.\n"
"if (PHP_SAPI === 'cli-server') {\n"
"    // Serve arquivos estáticos como estão.\n"
"    if (is_file(__DIR__ . $_SERVER['REQUEST_URI'])) {\n"
"        return false;\n"
"    }\n"
"\n"
"    // Definido explicitamente para URLs com ponto.\n"
"    $_SERVER['SCRIPT_NAME'] = '/index.php';\n"
"}\n"
"\n"
"require_once dirname(__DIR__) . '/vendor/autoload.php';\n"
"\n"
"$runner = new ApplicationRunner();\n"
"// Modo de desenvolvimento:\n"
"$runner->debug();\n"
"// Executa a aplicação:\n"
"$runner->run();\n"

#. type: Title ##
#: ../src/guide/structure/entry-script.md
#, no-wrap
msgid "Console Applications"
msgstr "Aplicações de console"

#. type: Plain text
#: ../src/guide/structure/entry-script.md
msgid "Similarly, the following is the code for the entry script of a console application:"
msgstr "Da mesma forma, este é o código do script de entrada de uma aplicação de console:"

#. type: Fenced code block (php)
#: ../src/guide/structure/entry-script.md
#, no-wrap
msgid ""
"#!/usr/bin/env php\n"
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"use Psr\\Container\\ContainerInterface;\n"
"use Yiisoft\\Config\\Config;\n"
"use Yiisoft\\Di\\Container;\n"
"use Yiisoft\\Di\\ContainerConfig;\n"
"use Yiisoft\\Yii\\Console\\Application;\n"
"use Yiisoft\\Yii\\Console\\Output\\ConsoleBufferedOutput;\n"
"\n"
"define('YII_ENV', getenv('env') ?: 'production');\n"
"\n"
"require_once 'vendor/autoload.php';\n"
"\n"
"$config = new Config(\n"
"    __DIR__,\n"
"    '/config/packages',\n"
");\n"
"\n"
"$containerConfig = ContainerConfig::create()\n"
"    ->withDefinitions($config->get('console'))\n"
"    ->withProviders($config->get('providers-console'));\n"
"$container = new Container($containerConfig);\n"
"\n"
"/** @var ContainerInterface $container */\n"
"$container = $container->get(ContainerInterface::class);\n"
"\n"
"$application = $container->get(Application::class);\n"
"$exitCode = 1;\n"
"\n"
"try {\n"
"    $application->start();\n"
"    $exitCode = $application->run(null, new ConsoleBufferedOutput());\n"
"} catch (\\Error $error) {\n"
"    $application->renderThrowable($error, new ConsoleBufferedOutput());\n"
"} finally {\n"
"    $application->shutdown($exitCode);\n"
"    exit($exitCode);\n"
"}\n"
msgstr ""
"#!/usr/bin/env php\n"
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"use Psr\\Container\\ContainerInterface;\n"
"use Yiisoft\\Config\\Config;\n"
"use Yiisoft\\Di\\Container;\n"
"use Yiisoft\\Di\\ContainerConfig;\n"
"use Yiisoft\\Yii\\Console\\Application;\n"
"use Yiisoft\\Yii\\Console\\Output\\ConsoleBufferedOutput;\n"
"\n"
"define('YII_ENV', getenv('env') ?: 'production');\n"
"\n"
"require_once 'vendor/autoload.php';\n"
"\n"
"$config = new Config(\n"
"    __DIR__,\n"
"    '/config/packages',\n"
");\n"
"\n"
"$containerConfig = ContainerConfig::create()\n"
"    ->withDefinitions($config->get('console'))\n"
"    ->withProviders($config->get('providers-console'));\n"
"$container = new Container($containerConfig);\n"
"\n"
"/** @var ContainerInterface $container */\n"
"$container = $container->get(ContainerInterface::class);\n"
"\n"
"$application = $container->get(Application::class);\n"
"$exitCode = 1;\n"
"\n"
"try {\n"
"    $application->start();\n"
"    $exitCode = $application->run(null, new ConsoleBufferedOutput());\n"
"} catch (\\Error $error) {\n"
"    $application->renderThrowable($error, new ConsoleBufferedOutput());\n"
"} finally {\n"
"    $application->shutdown($exitCode);\n"
"    exit($exitCode);\n"
"}\n"

