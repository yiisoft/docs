#. type: Fenced code block (bash)
#: ../src/cookbook/deployment/angie-docker-proxy.md
#, no-wrap
msgid "curl -I https://example-demo.example.com/\n"
msgstr "curl -I https://example-demo.example.com/\n"

#. type: Fenced code block (text)
#: ../src/cookbook/deployment/angie-docker-proxy.md
#, no-wrap
msgid ""
"HTTP/1.1 200 OK\n"
"Server: Angie/...\n"
msgstr ""
"HTTP/1.1 200 OK\n"
"Server: Angie/...\n"

#. type: Plain text
#: ../src/cookbook/deployment/angie-docker-proxy.md
msgid "Check the certificate:"
msgstr "Verifique o certificado:"

#. type: Fenced code block (bash)
#: ../src/cookbook/deployment/angie-docker-proxy.md
#, no-wrap
msgid ""
"echo | openssl s_client \\\n"
"  -connect example-demo.example.com:443 \\\n"
"  -servername example-demo.example.com 2>/dev/null \\\n"
"  | openssl x509 -noout -issuer -subject -dates\n"
msgstr ""
"echo | openssl s_client \\\n"
"  -connect example-demo.example.com:443 \\\n"
"  -servername example-demo.example.com 2>/dev/null \\\n"
"  | openssl x509 -noout -issuer -subject -dates\n"

