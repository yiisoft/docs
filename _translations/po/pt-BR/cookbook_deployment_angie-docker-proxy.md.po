#. type: Title ##
#: ../src/cookbook/deployment/angie-docker-proxy.md
#, no-wrap
msgid "Configuring Docker Compose"
msgstr "Configurando o Docker Compose"

#. type: Plain text
#: ../src/cookbook/deployment/angie-docker-proxy.md
msgid "Create `docker-compose.yml` with the following configuration. Replace:"
msgstr "Crie o `docker-compose.yml` com a configuração a seguir. Substitua:"

#. type: Bullet: '- '
#: ../src/cookbook/deployment/angie-docker-proxy.md
msgid "`admin@example.com` with your email address;"
msgstr "`admin@example.com` pelo seu endereço de e-mail;"

#. type: Bullet: '- '
#: ../src/cookbook/deployment/angie-docker-proxy.md
msgid "`registry.example.com/yii-app:1.0.0` with your application image;"
msgstr "`registry.example.com/yii-app:1.0.0` pela imagem da sua aplicação;"

#. type: Bullet: '- '
#: ../src/cookbook/deployment/angie-docker-proxy.md
msgid "`example-demo.example.com` with the domain pointing to your server."
msgstr "`example-demo.example.com` pelo domínio que aponta para o seu servidor."

#. type: Fenced code block (yaml)
#: ../src/cookbook/deployment/angie-docker-proxy.md
#, no-wrap
msgid ""
"services:\n"
"  angie-proxy:\n"
"    image: angiesoftware/proxy:latest\n"
"    environment:\n"
"      - ANGIE_ACME_EMAIL=admin@example.com\n"
"      - ANGIE_ACME_URL=https://acme-v02.api.letsencrypt.org/directory\n"
"      - ANGIE_RESOLVER=1.1.1.1 8.8.8.8\n"
"      - ANGIE_RESOLVER_VALID=300s\n"
"      - ANGIE_PROXY_NETWORK=proxy\n"
"    ports:\n"
"      - \"80:80\"\n"
"      - \"443:443\"\n"
"    volumes:\n"
"      - /var/run/docker.sock:/tmp/docker.sock:ro\n"
"      - angie_acme:/var/lib/angie/acme\n"
"    networks:\n"
"      - proxy\n"
"\n"
"  yii-app:\n"
"    image: registry.example.com/yii-app:1.0.0\n"
"    environment:\n"
"      - VIRTUAL_HOST=example-demo.example.com\n"
"      - VIRTUAL_PORT=80\n"
"    networks:\n"
"      - proxy\n"
"\n"
"networks:\n"
"  proxy:\n"
"    name: proxy\n"
"\n"
"volumes:\n"
"  angie_acme:\n"
msgstr ""
"services:\n"
"  angie-proxy:\n"
"    image: angiesoftware/proxy:latest\n"
"    environment:\n"
"      - ANGIE_ACME_EMAIL=admin@example.com\n"
"      - ANGIE_ACME_URL=https://acme-v02.api.letsencrypt.org/directory\n"
"      - ANGIE_RESOLVER=1.1.1.1 8.8.8.8\n"
"      - ANGIE_RESOLVER_VALID=300s\n"
"      - ANGIE_PROXY_NETWORK=proxy\n"
"    ports:\n"
"      - \"80:80\"\n"
"      - \"443:443\"\n"
"    volumes:\n"
"      - /var/run/docker.sock:/tmp/docker.sock:ro\n"
"      - angie_acme:/var/lib/angie/acme\n"
"    networks:\n"
"      - proxy\n"
"\n"
"  yii-app:\n"
"    image: registry.example.com/yii-app:1.0.0\n"
"    environment:\n"
"      - VIRTUAL_HOST=example-demo.example.com\n"
"      - VIRTUAL_PORT=80\n"
"    networks:\n"
"      - proxy\n"
"\n"
"networks:\n"
"  proxy:\n"
"    name: proxy\n"
"\n"
"volumes:\n"
"  angie_acme:\n"

#. type: Plain text
#: ../src/cookbook/deployment/angie-docker-proxy.md
msgid "`VIRTUAL_HOST` is the application's public domain."
msgstr "`VIRTUAL_HOST` é o domínio público da aplicação."

#. type: Plain text
#: ../src/cookbook/deployment/angie-docker-proxy.md
msgid "`VIRTUAL_PORT` is the container's internal port to which Angie should proxy requests."
msgstr "`VIRTUAL_PORT` é a porta interna do container para a qual o Angie deve encaminhar as requisições."

#. type: Plain text
#: ../src/cookbook/deployment/angie-docker-proxy.md
msgid "Angie Docker Proxy automatically discovers `VIRTUAL_HOST` and `VIRTUAL_PORT` from the environment variables and issues certificates using the Angie ACME module and Let's Encrypt."
msgstr "O Angie Docker Proxy descobre `VIRTUAL_HOST` e `VIRTUAL_PORT` automaticamente pelas variáveis de ambiente e emite certificados usando o módulo ACME do Angie e o Let's Encrypt."

