#. type: Title #
#: ../src/cookbook/custom-migration-template.md
#, no-wrap
msgid "Using a custom migration template"
msgstr "Usando um template de migration personalizado"

#. type: Plain text
#: ../src/cookbook/custom-migration-template.md
msgid "The `migrate:create` command from `yiisoft/db-migration` generates migration classes from PHP view templates. Use a custom template when your project wants a standard header, strict class shape, comments, helper calls, or team-specific placeholders in every new migration."
msgstr "O comando `migrate:create` do `yiisoft/db-migration` gera classes de migration a partir de templates PHP de view. Use um template personalizado quando seu projeto quiser um cabeçalho padrão, um formato de classe rígido, comentários, chamadas a helpers ou placeholders específicos da equipe em toda nova migration."

#. type: Plain text
#: ../src/cookbook/custom-migration-template.md
msgid "This recipe assumes migrations are already configured as described in the [Database migrations](../guide/databases/db-migrations.md) guide."
msgstr "Esta receita assume que as migrations já estão configuradas como descrito no guia [Migrations de banco de dados](../guide/databases/db-migrations.md)."

#. type: Title ##
#: ../src/cookbook/custom-migration-template.md
#, no-wrap
msgid "Create a template"
msgstr "Crie um template"

#. type: Plain text
#: ../src/cookbook/custom-migration-template.md
msgid "Create `resources/migration-templates/migration.php`:"
msgstr "Crie `resources/migration-templates/migration.php`:"

#. type: Fenced code block (php)
#: ../src/cookbook/custom-migration-template.md
#, no-wrap
msgid ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"/**\n"
" * This view is used by {@see Yiisoft\\Db\\Migration\\Command\\CreateCommand}.\n"
" *\n"
" * @var \\Yiisoft\\Db\\Migration\\Service\\Generate\\PhpRenderer $this\n"
" * @var string $className The new migration class name without namespace.\n"
" * @var string $namespace The new migration class namespace.\n"
" */\n"
"\n"
"echo \"<?php\\n\";\n"
"echo \"\\ndeclare(strict_types=1);\\n\";\n"
"\n"
"if (!empty($namespace)) {\n"
"    echo \"\\nnamespace {$namespace};\\n\";\n"
"}\n"
"?>\n"
"\n"
"use Yiisoft\\Db\\Migration\\MigrationBuilder;\n"
"use Yiisoft\\Db\\Migration\\RevertibleMigrationInterface;\n"
"\n"
"final class <?= $className ?> implements RevertibleMigrationInterface\n"
"{\n"
"    public function up(MigrationBuilder $b): void\n"
"    {\n"
"        // Add forward migration code.\n"
"    }\n"
"\n"
"    public function down(MigrationBuilder $b): void\n"
"    {\n"
"        // Add rollback migration code.\n"
"    }\n"
"}\n"
msgstr ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"/**\n"
" * Esta view é usada por {@see Yiisoft\\Db\\Migration\\Command\\CreateCommand}.\n"
" *\n"
" * @var \\Yiisoft\\Db\\Migration\\Service\\Generate\\PhpRenderer $this\n"
" * @var string $className O nome da nova classe de migration, sem namespace.\n"
" * @var string $namespace O namespace da nova classe de migration.\n"
" */\n"
"\n"
"echo \"<?php\\n\";\n"
"echo \"\\ndeclare(strict_types=1);\\n\";\n"
"\n"
"if (!empty($namespace)) {\n"
"    echo \"\\nnamespace {$namespace};\\n\";\n"
"}\n"
"?>\n"
"\n"
"use Yiisoft\\Db\\Migration\\MigrationBuilder;\n"
"use Yiisoft\\Db\\Migration\\RevertibleMigrationInterface;\n"
"\n"
"final class <?= $className ?> implements RevertibleMigrationInterface\n"
"{\n"
"    public function up(MigrationBuilder $b): void\n"
"    {\n"
"        // Add forward migration code.\n"
"    }\n"
"\n"
"    public function down(MigrationBuilder $b): void\n"
"    {\n"
"        // Add rollback migration code.\n"
"    }\n"
"}\n"

#. type: Plain text
#: ../src/cookbook/custom-migration-template.md
msgid "The template is a PHP file that prints the generated migration. For the default `create` command, the most useful variables are `$className` and `$namespace`."
msgstr "O template é um arquivo PHP que imprime a migration gerada. Para o comando `create` padrão, as variáveis mais úteis são `$className` e `$namespace`."

#. type: Title ##
#: ../src/cookbook/custom-migration-template.md
#, no-wrap
msgid "Configure the generator"
msgstr "Configure o gerador"

#. type: Plain text
#: ../src/cookbook/custom-migration-template.md
msgid "Create `config/common/di/migration-generator.php`:"
msgstr "Crie `config/common/di/migration-generator.php`:"

#. type: Fenced code block (php)
#: ../src/cookbook/custom-migration-template.md
#, no-wrap
msgid ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"use Yiisoft\\Db\\Migration\\Service\\Generate\\CreateService;\n"
"\n"
"return [\n"
"    CreateService::class => [\n"
"        'setTemplate()' => [\n"
"            'create',\n"
"            dirname(__DIR__, 3) . '/resources/migration-templates/migration.php',\n"
"        ],\n"
"    ],\n"
"];\n"
msgstr ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"use Yiisoft\\Db\\Migration\\Service\\Generate\\CreateService;\n"
"\n"
"return [\n"
"    CreateService::class => [\n"
"        'setTemplate()' => [\n"
"            'create',\n"
"            dirname(__DIR__, 3) . '/resources/migration-templates/migration.php',\n"
"        ],\n"
"    ],\n"
"];\n"

#. type: Plain text
#: ../src/cookbook/custom-migration-template.md
msgid "The `create` key changes the template used by:"
msgstr "A chave `create` muda o template usado por:"

#. type: Fenced code block (shell)
#: ../src/cookbook/custom-migration-template.md
#, no-wrap
msgid "./yii migrate:create audit_log\n"
msgstr "./yii migrate:create audit_log\n"

#. type: Plain text
#: ../src/cookbook/custom-migration-template.md
msgid "The command asks for confirmation and then writes a migration using your template."
msgstr "O comando pede confirmação e então grava uma migration usando o seu template."

#. type: Plain text
#: ../src/cookbook/custom-migration-template.md
msgid "If the new DI file is not picked up, rebuild the config merge plan:"
msgstr "Se o novo arquivo de DI não for carregado, reconstrua o merge plan da configuração:"

#. type: Fenced code block (sh)
#: ../src/cookbook/custom-migration-template.md ../src/cookbook/using-yii-in-third-party-apps.md ../src/guide/structure/designing-packages.md ../src/guide/structure/module.md ../src/guide/structure/package.md ../src/guide/tutorial/i18n.md
#, no-wrap
msgid "composer yii-config-rebuild\n"
msgstr "composer yii-config-rebuild\n"

#. type: Title ##
#: ../src/cookbook/custom-migration-template.md
#, no-wrap
msgid "Configure multiple templates"
msgstr "Configure vários templates"

#. type: Plain text
#: ../src/cookbook/custom-migration-template.md
msgid "`yiisoft/db-migration` supports these template keys:"
msgstr "O `yiisoft/db-migration` suporta estas chaves de template:"

#. type: Bullet: '- '
#: ../src/cookbook/custom-migration-template.md
msgid "`create`"
msgstr "`create`"

#. type: Bullet: '- '
#: ../src/cookbook/custom-migration-template.md
msgid "`table`"
msgstr "`table`"

#. type: Bullet: '- '
#: ../src/cookbook/custom-migration-template.md
msgid "`dropTable`"
msgstr "`dropTable`"

#. type: Bullet: '- '
#: ../src/cookbook/custom-migration-template.md
msgid "`addColumn`"
msgstr "`addColumn`"

#. type: Bullet: '- '
#: ../src/cookbook/custom-migration-template.md
msgid "`dropColumn`"
msgstr "`dropColumn`"

#. type: Bullet: '- '
#: ../src/cookbook/custom-migration-template.md
msgid "`junction`"
msgstr "`junction`"

#. type: Plain text
#: ../src/cookbook/custom-migration-template.md
msgid "To replace multiple templates at once, use `setTemplates()`:"
msgstr "Para substituir vários templates de uma vez, use `setTemplates()`:"

#. type: Fenced code block (php)
#: ../src/cookbook/custom-migration-template.md
#, no-wrap
msgid ""
"use Yiisoft\\Db\\Migration\\Service\\Generate\\CreateService;\n"
"\n"
"return [\n"
"    CreateService::class => [\n"
"        'setTemplates()' => [[\n"
"            'create' => dirname(__DIR__, 3) . '/resources/migration-templates/migration.php',\n"
"            'table' => dirname(__DIR__, 3) . '/resources/migration-templates/create-table.php',\n"
"            'dropTable' => dirname(__DIR__, 3) . '/resources/migration-templates/drop-table.php',\n"
"            'addColumn' => dirname(__DIR__, 3) . '/resources/migration-templates/add-column.php',\n"
"            'dropColumn' => dirname(__DIR__, 3) . '/resources/migration-templates/drop-column.php',\n"
"            'junction' => dirname(__DIR__, 3) . '/resources/migration-templates/create-junction.php',\n"
"        ]],\n"
"    ],\n"
"];\n"
msgstr ""
"use Yiisoft\\Db\\Migration\\Service\\Generate\\CreateService;\n"
"\n"
"return [\n"
"    CreateService::class => [\n"
"        'setTemplates()' => [[\n"
"            'create' => dirname(__DIR__, 3) . '/resources/migration-templates/migration.php',\n"
"            'table' => dirname(__DIR__, 3) . '/resources/migration-templates/create-table.php',\n"
"            'dropTable' => dirname(__DIR__, 3) . '/resources/migration-templates/drop-table.php',\n"
"            'addColumn' => dirname(__DIR__, 3) . '/resources/migration-templates/add-column.php',\n"
"            'dropColumn' => dirname(__DIR__, 3) . '/resources/migration-templates/drop-column.php',\n"
"            'junction' => dirname(__DIR__, 3) . '/resources/migration-templates/create-junction.php',\n"
"        ]],\n"
"    ],\n"
"];\n"

#. type: Plain text
#: ../src/cookbook/custom-migration-template.md
msgid "For table-oriented templates, copy the corresponding file from `vendor/yiisoft/db-migration/resources/views/` and adjust it. Those templates receive additional variables such as `$table`, `$columns`, `$foreignKeys`, and `$tableComment`."
msgstr "Para os templates voltados a tabelas, copie o arquivo correspondente de `vendor/yiisoft/db-migration/resources/views/` e ajuste-o. Esses templates recebem variáveis adicionais, como `$table`, `$columns`, `$foreignKeys` e `$tableComment`."

#. type: Title ##
#: ../src/cookbook/custom-migration-template.md
#, no-wrap
msgid "Keep templates maintainable"
msgstr "Mantenha os templates fáceis de manter"

#. type: Plain text
#: ../src/cookbook/custom-migration-template.md
msgid "Keep generated migrations independent from current application services. A migration may run years later, after service APIs have changed. Put stable schema operations in the generated class and leave business logic in console commands or application services."
msgstr "Mantenha as migrations geradas independentes dos serviços atuais da aplicação. Uma migration pode rodar anos depois, quando as APIs dos serviços já mudaram. Coloque operações de schema estáveis na classe gerada e deixe a lógica de negócio em comandos de console ou serviços da aplicação."

#. type: Plain text
#: ../src/cookbook/custom-migration-template.md
msgid "Do not edit templates under `vendor/`. Copy them into your project and configure `CreateService` to use the copies."
msgstr "Não edite templates dentro de `vendor/`. Copie-os para o seu projeto e configure o `CreateService` para usar as cópias."
