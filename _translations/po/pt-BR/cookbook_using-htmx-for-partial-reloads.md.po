"    ];\n"
"\n"
"    public array $jsOptions = [\n"
"        'integrity' => 'sha384-H5SrcfygHmAuTDZphMHqBJLc3FhssKjG7w/CeCpFReSfwBWDTKpkzPP8c+cLsK+V',\n"
