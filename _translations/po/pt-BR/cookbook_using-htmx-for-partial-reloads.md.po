#. type: Title ##
#: ../src/cookbook/using-htmx-for-partial-reloads.md
#, no-wrap
msgid "Add htmx attributes to the grid"
msgstr "Adicione atributos do htmx ao grid"

#. type: Plain text
#: ../src/cookbook/using-htmx-for-partial-reloads.md
msgid "Now update `UsersGrid` so the grid controls request a fragment and swap it into `#UsersGridView`:"
msgstr "Agora atualize o `UsersGrid` para que os controles do grid requisitem um fragmento e o troquem em `#UsersGridView`:"

#. type: Fenced code block (php)
#: ../src/cookbook/using-htmx-for-partial-reloads.md
#, no-wrap
msgid ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"namespace App\\Web\\Users\\Index;\n"
"\n"
"use Yiisoft\\Data\\Paginator\\PaginatorInterface;\n"
"use Yiisoft\\Data\\Reader\\Iterable\\IterableDataReader;\n"
"use Yiisoft\\Widget\\Widget;\n"
"use Yiisoft\\Yii\\DataView\\Column\\DataColumn;\n"
"use Yiisoft\\Yii\\DataView\\GridView\\GridView;\n"
"use Yiisoft\\Yii\\DataView\\Pagination\\OffsetPagination;\n"
"use Yiisoft\\Yii\\DataView\\Pagination\\PaginationWidgetInterface;\n"
"\n"
"final class UsersGrid extends Widget\n"
"{\n"
"    public function render(): string\n"
"    {\n"
"        $htmxLoadAttributes = [\n"
"            'hx-indicator' => '#UsersGridView',\n"
"            'hx-target' => '#UsersGridView',\n"
"            'hx-replace-url' => 'true',\n"
"            'hx-swap' => 'outerHTML',\n"
"        ];\n"
"\n"
"        /** @var PaginationWidgetInterface<PaginatorInterface> */\n"
"        $pagination = OffsetPagination::widget()->addLinkAttributes([\n"
"            'hx-boost' => 'true',\n"
"            ...$htmxLoadAttributes,\n"
"        ]);\n"
"\n"
"        return GridView::widget()\n"
"            ->containerAttributes([\n"
"                'id' => 'UsersGridView',\n"
"                'class' => 'mt-4 position-relative',\n"
"            ])\n"
"            ->dataReader($this->dataReader())\n"
"            ->pageSizeConstraint(5)\n"
"            ->sortableLinkAttributes([\n"
"                'hx-boost' => 'true',\n"
"                ...$htmxLoadAttributes,\n"
"            ])\n"
"            ->filterFormAttributes([\n"
"                'hx-boost' => 'true',\n"
"                ...$htmxLoadAttributes,\n"
"            ])\n"
"            ->paginationWidget($pagination)\n"
"            ->columns(\n"
"                new DataColumn('id', header: 'ID', filter: true),\n"
"                new DataColumn('login', header: 'Login', filter: true),\n"
"                new DataColumn('name', header: 'Name', filter: true),\n"
"                new DataColumn('status', header: 'Status', filter: true),\n"
"            )\n"
"            ->render();\n"
"    }\n"
"\n"
"    private function dataReader(): IterableDataReader\n"
"    {\n"
"        return new IterableDataReader([\n"
"            ['id' => 1, 'login' => 'admin', 'name' => 'Alice Adams', 'status' => 'Active'],\n"
"            ['id' => 2, 'login' => 'editor', 'name' => 'Eve Editor', 'status' => 'Active'],\n"
"            ['id' => 3, 'login' => 'author', 'name' => 'Arthur Author', 'status' => 'Active'],\n"
"            ['id' => 4, 'login' => 'reviewer', 'name' => 'Rita Reviewer', 'status' => 'Inactive'],\n"
"            ['id' => 5, 'login' => 'support', 'name' => 'Sam Support', 'status' => 'Active'],\n"
"            ['id' => 6, 'login' => 'guest', 'name' => 'Grace Guest', 'status' => 'Inactive'],\n"
"        ]);\n"
"    }\n"
"}\n"
msgstr ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"namespace App\\Web\\Users\\Index;\n"
"\n"
"use Yiisoft\\Data\\Paginator\\PaginatorInterface;\n"
"use Yiisoft\\Data\\Reader\\Iterable\\IterableDataReader;\n"
"use Yiisoft\\Widget\\Widget;\n"
"use Yiisoft\\Yii\\DataView\\Column\\DataColumn;\n"
"use Yiisoft\\Yii\\DataView\\GridView\\GridView;\n"
"use Yiisoft\\Yii\\DataView\\Pagination\\OffsetPagination;\n"
"use Yiisoft\\Yii\\DataView\\Pagination\\PaginationWidgetInterface;\n"
"\n"
"final class UsersGrid extends Widget\n"
"{\n"
"    public function render(): string\n"
"    {\n"
"        $htmxLoadAttributes = [\n"
"            'hx-indicator' => '#UsersGridView',\n"
"            'hx-target' => '#UsersGridView',\n"
"            'hx-replace-url' => 'true',\n"
"            'hx-swap' => 'outerHTML',\n"
"        ];\n"
"\n"
"        /** @var PaginationWidgetInterface<PaginatorInterface> */\n"
"        $pagination = OffsetPagination::widget()->addLinkAttributes([\n"
"            'hx-boost' => 'true',\n"
"            ...$htmxLoadAttributes,\n"
"        ]);\n"
"\n"
"        return GridView::widget()\n"
"            ->containerAttributes([\n"
"                'id' => 'UsersGridView',\n"
"                'class' => 'mt-4 position-relative',\n"
"            ])\n"
"            ->dataReader($this->dataReader())\n"
"            ->pageSizeConstraint(5)\n"
"            ->sortableLinkAttributes([\n"
"                'hx-boost' => 'true',\n"
"                ...$htmxLoadAttributes,\n"
"            ])\n"
"            ->filterFormAttributes([\n"
"                'hx-boost' => 'true',\n"
"                ...$htmxLoadAttributes,\n"
"            ])\n"
"            ->paginationWidget($pagination)\n"
"            ->columns(\n"
"                new DataColumn('id', header: 'ID', filter: true),\n"
"                new DataColumn('login', header: 'Login', filter: true),\n"
"                new DataColumn('name', header: 'Name', filter: true),\n"
"                new DataColumn('status', header: 'Status', filter: true),\n"
"            )\n"
"            ->render();\n"
"    }\n"
"\n"
"    private function dataReader(): IterableDataReader\n"
"    {\n"
"        return new IterableDataReader([\n"
"            ['id' => 1, 'login' => 'admin', 'name' => 'Alice Adams', 'status' => 'Active'],\n"
"            ['id' => 2, 'login' => 'editor', 'name' => 'Eve Editor', 'status' => 'Active'],\n"
"            ['id' => 3, 'login' => 'author', 'name' => 'Arthur Author', 'status' => 'Active'],\n"
"            ['id' => 4, 'login' => 'reviewer', 'name' => 'Rita Reviewer', 'status' => 'Inactive'],\n"
"            ['id' => 5, 'login' => 'support', 'name' => 'Sam Support', 'status' => 'Active'],\n"
"            ['id' => 6, 'login' => 'guest', 'name' => 'Grace Guest', 'status' => 'Inactive'],\n"
"        ]);\n"
"    }\n"
"}\n"

#. type: Plain text
#: ../src/cookbook/using-htmx-for-partial-reloads.md
msgid "The important part is the shared `$htmxLoadAttributes` array:"
msgstr "A parte importante é o array compartilhado `$htmxLoadAttributes`:"

#. type: Bullet: '- '
#: ../src/cookbook/using-htmx-for-partial-reloads.md
msgid "`hx-boost=\"true\"` makes the grid links and filter form send htmx requests."
msgstr "`hx-boost=\"true\"` faz os links e o formulário de filtro do grid enviarem requisições htmx."

#. type: Bullet: '- '
#: ../src/cookbook/using-htmx-for-partial-reloads.md
msgid "`hx-target=\"#UsersGridView\"` tells htmx which element to replace."
msgstr "`hx-target=\"#UsersGridView\"` diz ao htmx qual elemento substituir."

#. type: Bullet: '- '
#: ../src/cookbook/using-htmx-for-partial-reloads.md
msgid "`hx-swap=\"outerHTML\"` replaces the whole grid container with the response."
msgstr "`hx-swap=\"outerHTML\"` substitui todo o container do grid pela resposta."

#. type: Bullet: '- '
#: ../src/cookbook/using-htmx-for-partial-reloads.md
msgid "`hx-replace-url=\"true\"` keeps the browser URL in sync with the current sort, filter, and page."
msgstr "`hx-replace-url=\"true\"` mantém a URL do navegador sincronizada com a ordenação, o filtro e a página atuais."

#. type: Bullet: '- '
#: ../src/cookbook/using-htmx-for-partial-reloads.md
msgid "`hx-indicator=\"#UsersGridView\"` marks the grid as the loading indicator element while the request is active."
msgstr "`hx-indicator=\"#UsersGridView\"` marca o grid como o elemento indicador de carregamento enquanto a requisição está ativa."

#. type: Plain text
#: ../src/cookbook/using-htmx-for-partial-reloads.md
msgid "The target selector and the container `id` must match. In this example, both use `UsersGridView`."
msgstr "O seletor de destino e o `id` do container precisam coincidir. Neste exemplo, ambos usam `UsersGridView`."

#. type: Title ##
#: ../src/cookbook/using-htmx-for-partial-reloads.md
#, no-wrap
msgid "Return partial HTML for htmx requests"
msgstr "Retorne HTML parcial para requisições do htmx"

#. type: Plain text
#: ../src/cookbook/using-htmx-for-partial-reloads.md
msgid "htmx sends the `HX-Request` header with its requests."
msgstr "O htmx envia o header `HX-Request` nas suas requisições."

#. type: Plain text
#: ../src/cookbook/using-htmx-for-partial-reloads.md
msgid "In the action, return only the widget when the header is present:"
msgstr "Na action, retorne apenas o widget quando o header estiver presente:"

#. type: Fenced code block (php)
#: ../src/cookbook/using-htmx-for-partial-reloads.md
#, no-wrap
msgid ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"namespace App\\Web\\Users\\Index;\n"
"\n"
"use Psr\\Http\\Message\\ResponseInterface;\n"
"use Psr\\Http\\Message\\ServerRequestInterface;\n"
"use Yiisoft\\DataResponse\\ResponseFactory\\HtmlResponseFactory;\n"
"use Yiisoft\\Yii\\View\\Renderer\\WebViewRenderer;\n"
"\n"
"final readonly class Action\n"
"{\n"
"    public function __construct(\n"
"        private WebViewRenderer $viewRenderer,\n"
"        private HtmlResponseFactory $htmlResponseFactory,\n"
"    ) {\n"
"    }\n"
"\n"
"    public function __invoke(ServerRequestInterface $request): ResponseInterface\n"
"    {\n"
"        $response = $request->getHeaderLine('HX-Request') === 'true'\n"
"            ? $this->htmlResponseFactory->createResponse(UsersGrid::widget())\n"
"            : $this->viewRenderer->render(__DIR__ . '/template');\n"
"\n"
"        return $response->withAddedHeader('Vary', 'HX-Request');\n"
"    }\n"
"}\n"
msgstr ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"namespace App\\Web\\Users\\Index;\n"
"\n"
"use Psr\\Http\\Message\\ResponseInterface;\n"
"use Psr\\Http\\Message\\ServerRequestInterface;\n"
"use Yiisoft\\DataResponse\\ResponseFactory\\HtmlResponseFactory;\n"
"use Yiisoft\\Yii\\View\\Renderer\\WebViewRenderer;\n"
"\n"
"final readonly class Action\n"
"{\n"
"    public function __construct(\n"
"        private WebViewRenderer $viewRenderer,\n"
"        private HtmlResponseFactory $htmlResponseFactory,\n"
"    ) {\n"
"    }\n"
"\n"
"    public function __invoke(ServerRequestInterface $request): ResponseInterface\n"
"    {\n"
"        $response = $request->getHeaderLine('HX-Request') === 'true'\n"
"            ? $this->htmlResponseFactory->createResponse(UsersGrid::widget())\n"
"            : $this->viewRenderer->render(__DIR__ . '/template');\n"
"\n"
"        return $response->withAddedHeader('Vary', 'HX-Request');\n"
"    }\n"
"}\n"

#. type: Plain text
#: ../src/cookbook/using-htmx-for-partial-reloads.md
msgid "The `Vary` header matters when a browser, proxy, or CDN caches responses. The same URL can return a full page without `HX-Request` and a fragment with `HX-Request: true`, so caches must keep these responses separate."
msgstr "O header `Vary` importa quando um navegador, proxy ou CDN faz cache das respostas. A mesma URL pode retornar uma página completa sem `HX-Request` e um fragmento com `HX-Request: true`, então os caches precisam manter essas respostas separadas."

#. type: Title ##
#: ../src/cookbook/using-htmx-for-partial-reloads.md
#, no-wrap
msgid "Try it"
msgstr "Experimente"

#. type: Plain text
#: ../src/cookbook/using-htmx-for-partial-reloads.md
msgid "Open the list page and use sorting, filtering, or pagination. The browser URL should change, and only the grid HTML should be replaced."
msgstr "Abra a página da lista e use a ordenação, os filtros ou a paginação. A URL do navegador deve mudar, e apenas o HTML do grid deve ser substituído."

#. type: Plain text
#: ../src/cookbook/using-htmx-for-partial-reloads.md
msgid "In the browser developer tools, the htmx requests should include the `HX-Request` header. Their responses should contain only the grid container."
msgstr "Nas ferramentas de desenvolvedor do navegador, as requisições do htmx devem incluir o header `HX-Request`. As respostas devem conter apenas o container do grid."

#. type: Plain text
#: ../src/cookbook/using-htmx-for-partial-reloads.md
msgid "Use the same pattern for other widgets or page fragments:"
msgstr "Use o mesmo padrão para outros widgets ou fragmentos de página:"

#. type: Bullet: '1. '
#: ../src/cookbook/using-htmx-for-partial-reloads.md
msgid "Put the reloadable HTML into a widget or another small renderer."
msgstr "Coloque o HTML recarregável em um widget ou em outro pequeno renderizador."

#. type: Bullet: '2. '
#: ../src/cookbook/using-htmx-for-partial-reloads.md
msgid "Add htmx attributes to the links and forms that should refresh it."
msgstr "Adicione atributos do htmx aos links e formulários que devem atualizá-lo."

#. type: Bullet: '3. '
#: ../src/cookbook/using-htmx-for-partial-reloads.md
msgid "Return the fragment for htmx requests and the full page for regular requests."
msgstr "Retorne o fragmento para requisições do htmx e a página completa para requisições comuns."
