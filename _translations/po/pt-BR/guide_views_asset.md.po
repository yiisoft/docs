#, no-wrap
msgid "Using Asset Bundles"
msgstr "Usando asset bundles"

#. type: Title ###
#: ../src/guide/views/asset.md
#, no-wrap
msgid "In Controllers"
msgstr "Em controllers"

#. type: Plain text
#: ../src/guide/views/asset.md
msgid "Register asset bundles in your controllers or views:"
msgstr "Registre os asset bundles nos seus controllers ou views:"

#. type: Fenced code block (php)
#: ../src/guide/views/asset.md
#, no-wrap
msgid ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"namespace App\\Controller;\n"
"\n"
"use App\\Asset\\MainAsset;\n"
"use Psr\\Http\\Message\\ResponseInterface;\n"
"use Yiisoft\\Assets\\AssetManager;\n"
"use Yiisoft\\Yii\\View\\Renderer\\WebViewRenderer;\n"
"\n"
"final class SiteController\n"
"{\n"
"    public function __construct(\n"
"        private WebViewRenderer $viewRenderer,\n"
"        private AssetManager $assetManager,\n"
"    ) {}\n"
"\n"
"    public function index(): ResponseInterface\n"
"    {\n"
"        // Register the asset bundle\n"
"        $this->assetManager->register(MainAsset::class);\n"
"        \n"
"        return $this->viewRenderer->render('index', [\n"
"            'title' => 'Home Page',\n"
"        ]);\n"
"    }\n"
"    \n"
"    public function admin(): ResponseInterface\n"
"    {\n"
"        // Register multiple asset bundles\n"
"        $this->assetManager->registerMany([\n"
"            MainAsset::class,\n"
"            AdminAsset::class,\n"
"        ]);\n"
"        \n"
"        return $this->viewRenderer->render('admin/dashboard');\n"
"    }\n"
"}\n"
msgstr ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"namespace App\\Controller;\n"
"\n"
"use App\\Asset\\MainAsset;\n"
"use Psr\\Http\\Message\\ResponseInterface;\n"
"use Yiisoft\\Assets\\AssetManager;\n"
"use Yiisoft\\Yii\\View\\Renderer\\WebViewRenderer;\n"
"\n"
"final class SiteController\n"
"{\n"
"    public function __construct(\n"
"        private WebViewRenderer $viewRenderer,\n"
"        private AssetManager $assetManager,\n"
"    ) {}\n"
"\n"
"    public function index(): ResponseInterface\n"
"    {\n"
"        // Registra o asset bundle\n"
"        $this->assetManager->register(MainAsset::class);\n"
"        \n"
"        return $this->viewRenderer->render('index', [\n"
"            'title' => 'Home Page',\n"
"        ]);\n"
"    }\n"
"    \n"
"    public function admin(): ResponseInterface\n"
"    {\n"
"        // Registra vários asset bundles\n"
"        $this->assetManager->registerMany([\n"
"            MainAsset::class,\n"
"            AdminAsset::class,\n"
"        ]);\n"
"        \n"
"        return $this->viewRenderer->render('admin/dashboard');\n"
"    }\n"
"}\n"

#. type: Title ###
#: ../src/guide/views/asset.md
#, no-wrap
msgid "In Views"
msgstr "Em views"

#. type: Plain text
#: ../src/guide/views/asset.md
msgid "You can also register assets directly in views:"
msgstr "Você também pode registrar assets diretamente nas views:"

#. type: Fenced code block (php)
#: ../src/guide/views/asset.md
#, no-wrap
msgid ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"use App\\Asset\\ProductAsset;\n"
"use Yiisoft\\Assets\\AssetManager;\n"
"\n"
"/**\n"
" * @var \\Yiisoft\\View\\WebView $this\n"
" * @var AssetManager $assetManager\n"
" * @var array $product\n"
" */\n"
"\n"
"// Register product-specific assets\n"
"$assetManager->register(ProductAsset::class);\n"
"?>\n"
"\n"
"<div class=\"product-page\">\n"
"    <h1><?= Html::encode($product['name']) ?></h1>\n"
"    <!-- Product content -->\n"
"</div>\n"
msgstr ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"use App\\Asset\\ProductAsset;\n"
"use Yiisoft\\Assets\\AssetManager;\n"
"\n"
"/**\n"
" * @var \\Yiisoft\\View\\WebView $this\n"
" * @var AssetManager $assetManager\n"
" * @var array $product\n"
" */\n"
"\n"
"// Registra os assets específicos do produto\n"
"$assetManager->register(ProductAsset::class);\n"
"?>\n"
"\n"
"<div class=\"product-page\">\n"
"    <h1><?= Html::encode($product['name']) ?></h1>\n"
"    <!-- Conteúdo do produto -->\n"
"</div>\n"

#. type: Title ###
#: ../src/guide/views/asset.md
#, no-wrap
msgid "With WebView Integration"
msgstr "Com integração à WebView"

#. type: Plain text
#: ../src/guide/views/asset.md
msgid "The recommended approach is to integrate with WebView for automatic asset rendering:"
msgstr "A abordagem recomendada é integrar com a WebView para que os assets sejam renderizados automaticamente:"

#. type: Fenced code block (php)
#: ../src/guide/views/asset.md
#, no-wrap
msgid ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"use App\\Asset\\MainAsset;\n"
"\n"
"/**\n"
" * @var \\Yiisoft\\View\\WebView $this\n"
" * @var \\Yiisoft\\Assets\\AssetManager $assetManager\n"
" */\n"
"\n"
"// Register assets\n"
"$assetManager->register(MainAsset::class);\n"
"\n"
"// Add all registered assets to the view\n"
"$this->addCssFiles($assetManager->getCssFiles());\n"
"$this->addCssStrings($assetManager->getCssStrings());\n"
"$this->addJsFiles($assetManager->getJsFiles());\n"
"$this->addJsStrings($assetManager->getJsStrings());\n"
"$this->addJsVars($assetManager->getJsVars());\n"
"?>\n"
"\n"
"<div class=\"page-content\">\n"
"    <!-- Your page content -->\n"
"</div>\n"
msgstr ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"use App\\Asset\\MainAsset;\n"
"\n"
"/**\n"
" * @var \\Yiisoft\\View\\WebView $this\n"
" * @var \\Yiisoft\\Assets\\AssetManager $assetManager\n"
" */\n"
"\n"
"// Registra os assets\n"
"$assetManager->register(MainAsset::class);\n"
"\n"
"// Adiciona todos os assets registrados à view\n"
"$this->addCssFiles($assetManager->getCssFiles());\n"
"$this->addCssStrings($assetManager->getCssStrings());\n"
"$this->addJsFiles($assetManager->getJsFiles());\n"
"$this->addJsStrings($assetManager->getJsStrings());\n"
"$this->addJsVars($assetManager->getJsVars());\n"
"?>\n"
"\n"
"<div class=\"page-content\">\n"
"    <!-- Conteúdo da sua página -->\n"
"</div>\n"

#. type: Title ##
#: ../src/guide/views/asset.md
#, no-wrap
msgid "Asset Publishing"
msgstr "Publicação de assets"

#. type: Title ###
#: ../src/guide/views/asset.md
#, no-wrap
msgid "Source Path Publishing"
msgstr "Publicação a partir do source path"

#. type: Plain text
#: ../src/guide/views/asset.md
msgid "When assets are located in non-web-accessible directories (like vendor packages), they need to be published:"
msgstr "Quando os assets ficam em diretórios não acessíveis pela web (como pacotes do vendor), eles precisam ser publicados:"

#. type: Fenced code block (php)
#: ../src/guide/views/asset.md
#, no-wrap
msgid ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"namespace App\\Asset;\n"
"\n"
"use Yiisoft\\Assets\\AssetBundle;\n"
"\n"
"final class VendorAsset extends AssetBundle\n"
"{\n"
"    // Source directory (not web accessible)\n"
"    public ?string $sourcePath = '@vendor/company/package/assets';\n"
"    \n"
"    // Will be published to web-accessible directory\n"
"    public ?string $basePath = '@assets';\n"
"    public ?string $baseUrl = '@assetsUrl';\n"
"    \n"
"    public array $css = [\n"
"        'styles.css',\n"
"    ];\n"
"    \n"
"    public array $js = [\n"
"        'script.js',\n"
"    ];\n"
"}\n"
msgstr ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"namespace App\\Asset;\n"
"\n"
"use Yiisoft\\Assets\\AssetBundle;\n"
"\n"
"final class VendorAsset extends AssetBundle\n"
"{\n"
"    // Diretório de origem (não acessível pela web)\n"
"    public ?string $sourcePath = '@vendor/company/package/assets';\n"
"    \n"
"    // Será publicado em um diretório acessível pela web\n"
"    public ?string $basePath = '@assets';\n"
"    public ?string $baseUrl = '@assetsUrl';\n"
"    \n"
"    public array $css = [\n"
"        'styles.css',\n"
"    ];\n"
"    \n"
"    public array $js = [\n"
"        'script.js',\n"
"    ];\n"
"}\n"

#. type: Title ###
#: ../src/guide/views/asset.md
#, no-wrap
msgid "Custom Publishing"
msgstr "Publicação personalizada"

#. type: Plain text
#: ../src/guide/views/asset.md
msgid "You can also manually publish directories:"
msgstr "Você também pode publicar diretórios manualmente:"

#. type: Fenced code block (php)
#: ../src/guide/views/asset.md
#, no-wrap
msgid ""
"/**\n"
" * @var \\Yiisoft\\Assets\\AssetManager $assetManager\n"
" */\n"
"\n"
"// Publish a directory\n"
"$publishedPath = $assetManager->publish('@vendor/company/package/assets');\n"
"\n"
"// Get the published URL\n"
"$publishedUrl = $assetManager->getPublishedUrl('@vendor/company/package/assets');\n"
msgstr ""
"/**\n"
" * @var \\Yiisoft\\Assets\\AssetManager $assetManager\n"
" */\n"
"\n"
"// Publica um diretório\n"
"$publishedPath = $assetManager->publish('@vendor/company/package/assets');\n"
"\n"
"// Obtém a URL publicada\n"
"$publishedUrl = $assetManager->getPublishedUrl('@vendor/company/package/assets');\n"

