#. type: Title #
#: ../src/guide/views/asset.md
#, no-wrap
msgid "Assets"
msgstr "Assets"

#. type: Plain text
#: ../src/guide/views/asset.md
msgid "Asset management is crucial for modern web applications. Assets include CSS stylesheets, JavaScript files, images, fonts, and other static resources. Yii3 provides a comprehensive asset management system through the `yiisoft/assets` package that handles dependencies, optimization, and deployment of these resources."
msgstr "O gerenciamento de assets é essencial em aplicações web modernas. Assets incluem folhas de estilo CSS, arquivos JavaScript, imagens, fontes e outros recursos estáticos. O Yii3 oferece um sistema completo de gerenciamento de assets por meio do pacote `yiisoft/assets`, que cuida das dependências, da otimização e da publicação desses recursos."

#. type: Plain text
#: ../src/guide/views/asset.md
msgid "The asset management functionality is provided by the `yiisoft/assets` package:"
msgstr "A funcionalidade de gerenciamento de assets vem do pacote `yiisoft/assets`:"

#. type: Fenced code block (bash)
#: ../src/guide/views/asset.md
#, no-wrap
msgid "composer require yiisoft/assets\n"
msgstr "composer require yiisoft/assets\n"

#. type: Plain text
#: ../src/guide/views/asset.md
msgid "This package is included by default in the `yiisoft/app` application template."
msgstr "Esse pacote já vem incluído por padrão no template de aplicação `yiisoft/app`."

#. type: Title ##
#: ../src/guide/views/asset.md ../src/guide/views/view.md ../src/guide/views/widget.md
#, no-wrap
msgid "Basic Concepts"
msgstr "Conceitos básicos"

#. type: Title ###
#: ../src/guide/views/asset.md
#, no-wrap
msgid "Asset Bundles"
msgstr "Asset bundles"

#. type: Plain text
#: ../src/guide/views/asset.md
msgid "An asset bundle is a collection of related asset files (CSS, JavaScript, images) that are logically grouped together.  Asset bundles can depend on other bundles, allowing for proper dependency management."
msgstr "Um asset bundle é um conjunto de arquivos de asset relacionados (CSS, JavaScript, imagens) agrupados logicamente.  Asset bundles podem depender de outros bundles, o que permite gerenciar as dependências corretamente."

#. type: Title ###
#: ../src/guide/views/asset.md
#, no-wrap
msgid "Asset Manager"
msgstr "Asset Manager"

#. type: Plain text
#: ../src/guide/views/asset.md
msgid "The Asset Manager is responsible for: - Resolving asset bundle dependencies - Publishing assets from protected directories to web-accessible locations - Combining and minifying assets (when configured)  - Generating proper URLs for assets"
msgstr "O Asset Manager é responsável por: - Resolver as dependências dos asset bundles - Publicar assets de diretórios protegidos em locais acessíveis pela web - Combinar e minificar assets (quando configurado)  - Gerar as URLs corretas dos assets"

#. type: Title ##
#: ../src/guide/views/asset.md
#, no-wrap
msgid "Creating Asset Bundles"
msgstr "Criando asset bundles"

#. type: Title ###
#: ../src/guide/views/asset.md
#, no-wrap
msgid "Basic Asset Bundle"
msgstr "Asset bundle básico"

#. type: Plain text
#: ../src/guide/views/asset.md
msgid "Here's a simple asset bundle definition:"
msgstr "Esta é uma definição simples de asset bundle:"

#. type: Fenced code block (php)
#: ../src/guide/views/asset.md
#, no-wrap
msgid ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"namespace App\\Asset;\n"
"\n"
"use Yiisoft\\Assets\\AssetBundle;\n"
"\n"
"final class MainAsset extends AssetBundle\n"
"{\n"
"    public ?string $basePath = '@assets';\n"
"    public ?string $baseUrl = '@assetsUrl';\n"
"    \n"
"    public array $css = [\n"
"        'css/main.css',\n"
"        'css/responsive.css',\n"
"    ];\n"
"    \n"
"    public array $js = [\n"
"        'js/main.js',\n"
"        'js/utils.js',\n"
"    ];\n"
"    \n"
"    public array $depends = [\n"
"        BootstrapAsset::class,\n"
"        JqueryAsset::class,\n"
"    ];\n"
"}\n"
msgstr ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"namespace App\\Asset;\n"
"\n"
"use Yiisoft\\Assets\\AssetBundle;\n"
"\n"
"final class MainAsset extends AssetBundle\n"
"{\n"
"    public ?string $basePath = '@assets';\n"
"    public ?string $baseUrl = '@assetsUrl';\n"
"    \n"
"    public array $css = [\n"
"        'css/main.css',\n"
"        'css/responsive.css',\n"
"    ];\n"
"    \n"
"    public array $js = [\n"
"        'js/main.js',\n"
"        'js/utils.js',\n"
"    ];\n"
"    \n"
"    public array $depends = [\n"
"        BootstrapAsset::class,\n"
"        JqueryAsset::class,\n"
"    ];\n"
"}\n"

#. type: Title ###
#: ../src/guide/views/asset.md
#, no-wrap
msgid "Asset Bundle Properties"
msgstr "Propriedades do asset bundle"

#. type: Plain text
#: ../src/guide/views/asset.md
#, no-wrap
msgid ""
"**Path Configuration:**\n"
"- `$basePath` (`string|null`) - Physical path where web-accessible asset files are located.\n"
"- `$baseUrl` (`string|null`) - Web-accessible URL path for assets.\n"
"- `$sourcePath` (`string|null`) - Source directory for assets that need to be published.\n"
"- `$cdn` (`bool`) - Whether the bundle uses CDN files exclusively.\n"
msgstr ""
"**Configuração de caminhos:**\n"
"- `$basePath` (`string|null`) - Caminho físico onde ficam os arquivos de asset acessíveis pela web.\n"
"- `$baseUrl` (`string|null`) - Caminho da URL acessível pela web para os assets.\n"
"- `$sourcePath` (`string|null`) - Diretório de origem dos assets que precisam ser publicados.\n"
"- `$cdn` (`bool`) - Indica se o bundle usa exclusivamente arquivos de CDN.\n"

#. type: Plain text
#: ../src/guide/views/asset.md
#, no-wrap
msgid ""
"**Asset Files:**\n"
"- `$css` - Array of CSS files\n"
"- `$js` - Array of JavaScript files  \n"
msgstr ""
"**Arquivos de asset:**\n"
"- `$css` - Array de arquivos CSS\n"
"- `$js` - Array de arquivos JavaScript  \n"

#. type: Plain text
#: ../src/guide/views/asset.md
#, no-wrap
msgid ""
"**Dependencies:**\n"
"- `$depends` - Array of other asset bundles this bundle depends on\n"
msgstr ""
"**Dependências:**\n"
"- `$depends` - Array de outros asset bundles dos quais este bundle depende\n"

#. type: Plain text
#: ../src/guide/views/asset.md
#, no-wrap
msgid ""
"**Options:**\n"
"- `$jsOptions` - HTML attributes for JavaScript tags\n"
"- `$cssOptions` - HTML attributes for CSS link tags\n"
msgstr ""
"**Opções:**\n"
"- `$jsOptions` - Atributos HTML das tags de JavaScript\n"
"- `$cssOptions` - Atributos HTML das tags link de CSS\n"

#. type: Title ###
#: ../src/guide/views/asset.md
#, no-wrap
msgid "Advanced Asset Bundle"
msgstr "Asset bundle avançado"

#. type: Fenced code block (php)
#: ../src/guide/views/asset.md
#, no-wrap
msgid ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"namespace App\\Asset;\n"
"\n"
"use Yiisoft\\Assets\\AssetBundle;\n"
"\n"
"final class AdminAsset extends AssetBundle\n"
"{\n"
"    public ?string $basePath = '@assets';\n"
"    public ?string $baseUrl = '@assetsUrl';\n"
"    \n"
"    // CSS files with media queries\n"
"    public array $css = [\n"
"        'css/admin/main.css',\n"
"        ['css/admin/print.css', 'media' => 'print'],\n"
"        ['css/admin/mobile.css', 'media' => 'screen and (max-width: 768px)'],\n"
"    ];\n"
"    \n"
"    // JavaScript files with attributes\n"
"    public array $js = [\n"
"        'js/admin/core.js',\n"
"        ['js/admin/charts.js', 'defer' => true],\n"
"        ['js/admin/analytics.js', 'async' => true],\n"
"    ];\n"
"    \n"
"    // Global options for all JS files in this bundle\n"
"    public array $jsOptions = [\n"
"        'data-admin' => 'true',\n"
"    ];\n"
"    \n"
"    // Global options for all CSS files in this bundle\n"
"    public array $cssOptions = [\n"
"        'data-bundle' => 'admin',\n"
"    ];\n"
"    \n"
"    public array $depends = [\n"
"        MainAsset::class,\n"
"        ChartJsAsset::class,\n"
"    ];\n"
"}\n"
msgstr ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"namespace App\\Asset;\n"
"\n"
"use Yiisoft\\Assets\\AssetBundle;\n"
"\n"
"final class AdminAsset extends AssetBundle\n"
"{\n"
"    public ?string $basePath = '@assets';\n"
"    public ?string $baseUrl = '@assetsUrl';\n"
"    \n"
"    // Arquivos CSS com media queries\n"
"    public array $css = [\n"
"        'css/admin/main.css',\n"
"        ['css/admin/print.css', 'media' => 'print'],\n"
"        ['css/admin/mobile.css', 'media' => 'screen and (max-width: 768px)'],\n"
"    ];\n"
"    \n"
"    // Arquivos JavaScript com atributos\n"
"    public array $js = [\n"
"        'js/admin/core.js',\n"
"        ['js/admin/charts.js', 'defer' => true],\n"
"        ['js/admin/analytics.js', 'async' => true],\n"
"    ];\n"
"    \n"
"    // Opções globais para todos os arquivos JS deste bundle\n"
"    public array $jsOptions = [\n"
"        'data-admin' => 'true',\n"
"    ];\n"
"    \n"
"    // Opções globais para todos os arquivos CSS deste bundle\n"
"    public array $cssOptions = [\n"
"        'data-bundle' => 'admin',\n"
"    ];\n"
"    \n"
"    public array $depends = [\n"
"        MainAsset::class,\n"
"        ChartJsAsset::class,\n"
"    ];\n"
"}\n"

