#. type: Plain text
#: ../src/guide/views/asset.md
#, no-wrap
msgid "**config/web/params.php**\n"
msgstr "**config/web/params.php**\n"

#. type: Fenced code block (php)
#: ../src/guide/views/asset.md
#, no-wrap
msgid ""
"return [\n"
"    'yiisoft/assets' => [\n"
"        // Base path for published assets\n"
"        'basePath' => '@webroot/assets',\n"
"        \n"
"        // Base URL for assets\n"
"        'baseUrl' => '@web/assets',\n"
"        \n"
"        // Asset converter configuration\n"
"        'converter' => [\n"
"            'commands' => [\n"
"                'scss' => ['sass', '{from}', '{to}', '--style=compressed'],\n"
"                'ts' => ['tsc', '{from}', '--outFile', '{to}'],\n"
"            ],\n"
"        ],\n"
"    ],\n"
"];\n"
msgstr ""
"return [\n"
"    'yiisoft/assets' => [\n"
"        // Caminho base dos assets publicados\n"
"        'basePath' => '@webroot/assets',\n"
"        \n"
"        // URL base dos assets\n"
"        'baseUrl' => '@web/assets',\n"
"        \n"
"        // Configuração do conversor de assets\n"
"        'converter' => [\n"
"            'commands' => [\n"
