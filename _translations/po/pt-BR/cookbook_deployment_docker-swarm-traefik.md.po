msgstr "Pré-requisitos"

#. type: Bullet: '- '
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "A server with a fresh installation of a Linux distribution (Ubuntu 22.04 LTS or later recommended)"
msgstr "Um servidor com uma distribuição Linux recém-instalada (recomendado Ubuntu 22.04 LTS ou mais recente)"

#. type: Bullet: '- '
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "A domain name pointing to your server's IP address"
msgstr "Um nome de domínio apontando para o IP do seu servidor"

#. type: Bullet: '- '
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "SSH access to your server"
msgstr "Acesso SSH ao seu servidor"

#. type: Bullet: '- '
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "Basic knowledge of Docker and command-line tools"
msgstr "Conhecimento básico de Docker e de ferramentas de linha de comando"

#. type: Title ##
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "Server preparation"
msgstr "Preparando o servidor"

#. type: Title ###
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "Install Docker"
msgstr "Instale o Docker"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "For installation instructions, see the [official Docker documentation](https://docs.docker.com/engine/install/ubuntu/)."
msgstr "Para as instruções de instalação, veja a [documentação oficial do Docker](https://docs.docker.com/engine/install/ubuntu/)."

#. type: Title ###
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "Initialize Docker Swarm"
msgstr "Inicialize o Docker Swarm"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "Initialize your server as a Docker Swarm manager:"
msgstr "Inicialize o seu servidor como manager do Docker Swarm:"

#. type: Fenced code block (bash)
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "docker swarm init --advertise-addr <YOUR_SERVER_IP>\n"
msgstr "docker swarm init --advertise-addr <YOUR_SERVER_IP>\n"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "Replace `<YOUR_SERVER_IP>` with your server's public IP address.\n"
msgstr "Substitua `<YOUR_SERVER_IP>` pelo IP público do seu servidor.\n"

#. type: Title ###
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "Set up the reverse proxy network"
msgstr "Configure a rede do proxy reverso"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "Create a dedicated overlay network for reverse proxy to communicate with your services:"
msgstr "Crie uma rede overlay dedicada para o proxy reverso se comunicar com os seus serviços:"

#. type: Fenced code block (bash)
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "docker network create --driver=overlay reverse_proxy_public\n"
msgstr "docker network create --driver=overlay reverse_proxy_public\n"

#. type: Title ##
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "Setting up a container registry"
msgstr "Configurando um registro de containers"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "You need a container registry to store your Docker images. Choose one of the following options."
msgstr "Você precisa de um registro de containers para guardar as suas imagens Docker. Escolha uma das opções a seguir."

#. type: Title ###
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "Option 1: Using Forgejo"
msgstr "Opção 1: usando o Forgejo"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "To deploy Forgejo create a file `forgejo-stack.yml`:"
msgstr "Para fazer o deploy do Forgejo, crie um arquivo `forgejo-stack.yml`:"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "Deploy Forgejo:"
msgstr "Faça o deploy do Forgejo:"

#. type: Fenced code block (bash)
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "docker stack deploy -c forgejo-stack.yml forgejo\n"
msgstr "docker stack deploy -c forgejo-stack.yml forgejo\n"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "Replace `git.example.com` with your desired subdomain."
msgstr "Substitua `git.example.com` pelo subdomínio desejado."

#. type: Title ###
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "Option 2: Using Gitea"
msgstr "Opção 2: usando o Gitea"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "To deploy Gitea create a file `gitea-stack.yml`:"
msgstr "Para fazer o deploy do Gitea, crie um arquivo `gitea-stack.yml`:"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "Deploy Gitea:"
msgstr "Faça o deploy do Gitea:"

#. type: Fenced code block (bash)
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "docker stack deploy -c gitea-stack.yml gitea\n"
msgstr "docker stack deploy -c gitea-stack.yml gitea\n"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "After deployment, access Gitea at `https://git.example.com` and complete the initial setup.  Make sure to enable the container registry in the settings."
msgstr "Depois do deploy, acesse o Gitea em `https://git.example.com` e conclua a configuração inicial.  Não esqueça de habilitar o registro de containers nas configurações."

#. type: Title ##
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "Configuring your Yii application"
msgstr "Configurando a sua aplicação Yii"

#. type: Title ###
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "Update the Makefile configuration"
msgstr "Atualize a configuração do Makefile"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "The [Yii application template](https://github.com/yiisoft/app) includes a Makefile with deployment commands. Update the `docker/.env` file in your project:"
msgstr "O [template de aplicação do Yii](https://github.com/yiisoft/app) inclui um Makefile com comandos de deploy. Atualize o arquivo `docker/.env` do seu projeto:"

#. type: Fenced code block (bash)
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid ""
"STACK_NAME=myapp\n"
"\n"
"#\n"
"# Production\n"
"#\n"
"\n"
"PROD_HOST=app.example.com\n"
"PROD_SSH=\"ssh://user@your-server-ip\"\n"
"\n"
"IMAGE=git.example.com/username/myapp\n"
"IMAGE_TAG=latest\n"
msgstr ""
"STACK_NAME=myapp\n"
"\n"
"#\n"
"# Produção\n"
"#\n"
"\n"
"PROD_HOST=app.example.com\n"
"PROD_SSH=\"ssh://user@your-server-ip\"\n"
"\n"
"IMAGE=git.example.com/username/myapp\n"
"IMAGE_TAG=latest\n"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "Replace the values: - `STACK_NAME`: A unique name for your application stack - `PROD_HOST`: The domain name where your app will be accessible - `PROD_SSH`: SSH connection string to your server (format: `ssh://user@host`)  - `IMAGE`: Full path to your container image in the registry - `IMAGE_TAG`: Image tag, typically `latest` or a version number"
msgstr "Substitua os valores: - `STACK_NAME`: um nome único para a stack da sua aplicação - `PROD_HOST`: o nome de domínio em que a aplicação vai ficar acessível - `PROD_SSH`: a string de conexão SSH com o seu servidor (formato: `ssh://user@host`)  - `IMAGE`: o caminho completo da imagem do container no registro - `IMAGE_TAG`: a tag da imagem, normalmente `latest` ou um número de versão"

#. type: Title ###
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "Configure the production environment"
msgstr "Configure o ambiente de produção"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "Update `docker/prod/.env` with your production environment variables:"
msgstr "Atualize o `docker/prod/.env` com as variáveis de ambiente de produção:"

#. type: Fenced code block (bash)
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid ""
"APP_ENV=prod\n"
"YII_DEBUG=false\n"
"YII_ENV=prod\n"
"\n"
"# Database configuration\n"
"DB_HOST=db\n"
"DB_NAME=myapp\n"
"DB_USER=myapp\n"
"DB_PASSWORD=secure_password_here\n"
"\n"
"# Add other environment-specific variables\n"
msgstr ""
"APP_ENV=prod\n"
"YII_DEBUG=false\n"
"YII_ENV=prod\n"
"\n"
"# Configuração do banco de dados\n"
"DB_HOST=db\n"
"DB_NAME=myapp\n"
"DB_USER=myapp\n"
"DB_PASSWORD=secure_password_here\n"
"\n"
"# Adicione outras variáveis específicas do ambiente\n"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid ""
"> [!WARNING]\n"
"> Never commit sensitive credentials to version control. Use `docker/prod/override.env` for sensitive values and add it to `.gitignore`.\n"
msgstr ""
"> [!WARNING]\n"
"> Nunca faça commit de credenciais sensíveis no controle de versão. Use `docker/prod/override.env` para valores sensíveis e adicione-o ao `.gitignore`.\n"

#. type: Title ###
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "Review the production Docker Compose configuration"
msgstr "Revise a configuração do Docker Compose de produção"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid ""
"This configuration:\n"
"- Runs 2 replicas for high availability\n"
"- Uses a rolling update strategy with automatic rollback on failure\n"
"- Configures `labels` for automatic HTTPS on the reverse proxy\n"
"- Disables obtaining of HTTPs certificates on the container itself\n"
"  since proxy communicates with the container via HTTP. That is `auto_https off`.\n"
msgstr ""
"Essa configuração:\n"
"- Roda 2 réplicas para alta disponibilidade\n"
"- Usa uma estratégia de rolling update com rollback automático em caso de falha\n"
"- Configura `labels` para HTTPS automático no proxy reverso\n"
"- Desabilita a obtenção de certificados HTTPS no próprio container,\n"
"  já que o proxy se comunica com o container via HTTP. Isso é o `auto_https off`.\n"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "If you need a database, add it to the stack:"
msgstr "Se você precisa de um banco de dados, adicione-o à stack:"

#. type: Fenced code block (yaml)
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid ""
"services:\n"
"  app:\n"
"    # ... existing configuration ...\n"
"    \n"
"  db:\n"
"    image: postgres:18-alpine\n"
"    environment:\n"
"      POSTGRES_DB: myapp\n"
"      POSTGRES_USER: myapp\n"
"      POSTGRES_PASSWORD_FILE: /run/secrets/db_password\n"
"      POSTGRES_INITDB_ARGS: \"--locale-provider=icu --icu-locale=und --encoding=UTF8\"\n"
"    volumes:\n"
"      - db_data:/var/lib/postgresql\n"
"    networks:\n"
"      - reverse_proxy_public\n"
"    deploy:\n"
"      placement:\n"
"        constraints:\n"
"          - node.role == manager\n"
"    secrets:\n"
"      - db_password\n"
"\n"
"volumes:\n"
"  runtime:\n"
"  db_data:\n"
"\n"
"secrets:\n"
"  db_password:\n"
"    external: true\n"
msgstr ""
"services:\n"
"  app:\n"
"    # ... configuração existente ...\n"
"    \n"
"  db:\n"
"    image: postgres:18-alpine\n"
"    environment:\n"
"      POSTGRES_DB: myapp\n"
"      POSTGRES_USER: myapp\n"
"      POSTGRES_PASSWORD_FILE: /run/secrets/db_password\n"
"      POSTGRES_INITDB_ARGS: \"--locale-provider=icu --icu-locale=und --encoding=UTF8\"\n"
"    volumes:\n"
"      - db_data:/var/lib/postgresql\n"
"    networks:\n"
"      - reverse_proxy_public\n"
"    deploy:\n"
"      placement:\n"
"        constraints:\n"
"          - node.role == manager\n"
"    secrets:\n"
"      - db_password\n"
"\n"
"volumes:\n"
"  runtime:\n"
"  db_data:\n"
"\n"
"secrets:\n"
"  db_password:\n"
"    external: true\n"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "Create the database password secret on the server:"
msgstr "Crie o secret com a senha do banco de dados no servidor:"

#. type: Fenced code block (bash)
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "echo \"your_secure_password\" | docker secret create db_password -\n"
msgstr "echo \"your_secure_password\" | docker secret create db_password -\n"

#. type: Title ##
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "Building and pushing the image"
msgstr "Construindo e enviando a imagem"

#. type: Title ###
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "Set up Docker login on your local machine"
msgstr "Configure o login do Docker na sua máquina local"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "Configure Docker to authenticate with your container registry:"
msgstr "Configure o Docker para se autenticar no seu registro de containers:"

#. type: Fenced code block (bash)
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "docker login git.example.com\n"
msgstr "docker login git.example.com\n"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "Enter your username and password when prompted."
msgstr "Informe o seu usuário e a sua senha quando solicitado."

#. type: Title ###
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "Build the production image"
msgstr "Construa a imagem de produção"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "Use the Makefile to build your production image:"
msgstr "Use o Makefile para construir a imagem de produção:"

#. type: Fenced code block (bash)
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "make prod-build\n"
msgstr "make prod-build\n"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "This runs the command defined in the Makefile:"
msgstr "Isso executa o comando definido no Makefile:"

#. type: Fenced code block (bash)
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "docker build --file docker/Dockerfile --target prod --pull -t ${IMAGE}:${IMAGE_TAG} .\n"
msgstr "docker build --file docker/Dockerfile --target prod --pull -t ${IMAGE}:${IMAGE_TAG} .\n"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "The Dockerfile uses a multi-stage build: 1. Installs Composer dependencies in a builder stage 2. Creates a minimal production image with only the necessary files 3. Runs as a non-root user (`www-data`)"
msgstr "O Dockerfile usa um build multi-stage: 1. Instala as dependências do Composer em um estágio de build 2. Cria uma imagem de produção mínima, só com os arquivos necessários 3. Roda como um usuário não root (`www-data`)"

#. type: Title ###
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "Push the image to the registry"
msgstr "Envie a imagem para o registro"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "Push your built image to the container registry:"
msgstr "Envie a imagem construída para o registro de containers:"

#. type: Fenced code block (bash)
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "make prod-push\n"
msgstr "make prod-push\n"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "This executes:"
msgstr "Isso executa:"

#. type: Fenced code block (bash)
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "docker push ${IMAGE}:${IMAGE_TAG}\n"
msgstr "docker push ${IMAGE}:${IMAGE_TAG}\n"

#. type: Title ##
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "Deploying to Docker Swarm"
msgstr "Fazendo deploy no Docker Swarm"

#. type: Title ###
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "Configure SSH access"
msgstr "Configure o acesso SSH"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "Set up SSH key-based authentication to your server:"
msgstr "Configure a autenticação por chave SSH no seu servidor:"

#. type: Fenced code block (bash)
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid ""
"# Generate SSH key (if you don't have one)\n"
"ssh-keygen -t ed25519 -C \"your_email@example.com\"\n"
"\n"
"# Copy the key to your server\n"
"ssh-copy-id user@your-server-ip\n"
"\n"
"# Add the SSH host to your SSH config (~/.ssh/config)\n"
"cat >> ~/.ssh/config << EOF\n"
"Host docker-web\n"
"    HostName your-server-ip\n"
"    User user\n"
"    IdentityFile ~/.ssh/id_ed25519\n"
"EOF\n"
msgstr ""
"# Gera uma chave SSH (se você ainda não tiver uma)\n"
"ssh-keygen -t ed25519 -C \"your_email@example.com\"\n"
"\n"
"# Copia a chave para o seu servidor\n"
"ssh-copy-id user@your-server-ip\n"
"\n"
"# Adiciona o host SSH à sua configuração SSH (~/.ssh/config)\n"
"cat >> ~/.ssh/config << EOF\n"
"Host docker-web\n"
"    HostName your-server-ip\n"
"    User user\n"
"    IdentityFile ~/.ssh/id_ed25519\n"
"EOF\n"

#. type: Title ###
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "Set up Docker context"
msgstr "Configure o contexto do Docker"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "Create a Docker context for remote deployment:"
msgstr "Crie um contexto do Docker para o deploy remoto:"

#. type: Fenced code block (bash)
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "docker context create swarm-prod --docker \"host=ssh://docker-web\"\n"
msgstr "docker context create swarm-prod --docker \"host=ssh://docker-web\"\n"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "Alternatively, configure the `DOCKER_HOST` environment variable:"
msgstr "Como alternativa, configure a variável de ambiente `DOCKER_HOST`:"

#. type: Fenced code block (bash)
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "export DOCKER_HOST=ssh://docker-web\n"
msgstr "export DOCKER_HOST=ssh://docker-web\n"

#. type: Title ###
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "Deploy the application"
msgstr "Faça o deploy da aplicação"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "Deploy your application stack to Docker Swarm:"
msgstr "Faça o deploy da stack da sua aplicação no Docker Swarm:"

#. type: Fenced code block (bash)
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "make prod-deploy\n"
msgstr "make prod-deploy\n"

#. type: Fenced code block (bash)
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "docker -H ${PROD_SSH} stack deploy --prune --detach=false --with-registry-auth -c docker/compose.yml -c docker/prod/compose.yml ${STACK_NAME}\n"
msgstr "docker -H ${PROD_SSH} stack deploy --prune --detach=false --with-registry-auth -c docker/compose.yml -c docker/prod/compose.yml ${STACK_NAME}\n"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "The `--with-registry-auth` flag ensures the Swarm nodes can pull images from your private registry."
msgstr "A flag `--with-registry-auth` garante que os nós do Swarm consigam baixar imagens do seu registro privado."

#. type: Title ###
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "Verify the deployment"
msgstr "Verifique o deploy"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "Check the status of your services:"
msgstr "Verifique o status dos seus serviços:"

#. type: Fenced code block (bash)
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid ""
"docker -H ssh://docker-web service ls\n"
"docker -H ssh://docker-web service ps ${STACK_NAME}_app\n"
msgstr ""
"docker -H ssh://docker-web service ls\n"
"docker -H ssh://docker-web service ps ${STACK_NAME}_app\n"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "View logs:"
msgstr "Veja os logs:"

#. type: Fenced code block (bash)
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "docker -H ssh://docker-web service logs ${STACK_NAME}_app\n"
msgstr "docker -H ssh://docker-web service logs ${STACK_NAME}_app\n"

#. type: Title ##
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "Monitoring and maintenance"
msgstr "Monitoramento e manutenção"

#. type: Title ###
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "View service logs"
msgstr "Veja os logs do serviço"

#. type: Fenced code block (bash)
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid ""
"# View all logs\n"
"docker -H ssh://docker-web service logs -f ${STACK_NAME}_app\n"
"\n"
"# View logs from the last 100 lines\n"
"docker -H ssh://docker-web service logs --tail 100 ${STACK_NAME}_app\n"
"\n"
"# View logs with timestamps\n"
"docker -H ssh://docker-web service logs -t ${STACK_NAME}_app\n"
msgstr ""
"# Mostra todos os logs\n"
"docker -H ssh://docker-web service logs -f ${STACK_NAME}_app\n"
"\n"
"# Mostra as últimas 100 linhas de log\n"
"docker -H ssh://docker-web service logs --tail 100 ${STACK_NAME}_app\n"
"\n"
"# Mostra os logs com timestamps\n"
"docker -H ssh://docker-web service logs -t ${STACK_NAME}_app\n"

#. type: Title ###
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "Scale the application"
msgstr "Escale a aplicação"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "Adjust the number of replicas:"
msgstr "Ajuste o número de réplicas:"

#. type: Fenced code block (bash)
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "docker -H ssh://docker-web service scale ${STACK_NAME}_app=3\n"
msgstr "docker -H ssh://docker-web service scale ${STACK_NAME}_app=3\n"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "Or update the `replicas` value in `docker/prod/compose.yml` and redeploy."
msgstr "Ou atualize o valor de `replicas` em `docker/prod/compose.yml` e faça o deploy de novo."

#. type: Title ###
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "Resource limits"
msgstr "Limites de recursos"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "Add resource limits to prevent containers from consuming all server resources. Update `docker/prod/compose.yml`:"
msgstr "Adicione limites de recursos para evitar que os containers consumam todos os recursos do servidor. Atualize o `docker/prod/compose.yml`:"

#. type: Fenced code block (yaml)
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid ""
"services:\n"
"  app:\n"
"    # ... existing configuration ...\n"
"    deploy:\n"
"      resources:\n"
"        limits:\n"
"          cpus: '0.5'\n"
"          memory: 512M\n"
"        reservations:\n"
"          cpus: '0.25'\n"
"          memory: 256M\n"
msgstr ""
"services:\n"
"  app:\n"
"    # ... configuração existente ...\n"
"    deploy:\n"
"      resources:\n"
"        limits:\n"
"          cpus: '0.5'\n"
"          memory: 512M\n"
"        reservations:\n"
"          cpus: '0.25'\n"
"          memory: 256M\n"

#. type: Title ##
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md ../src/cookbook/disabling-csrf-protection.md
#, no-wrap
msgid "Security considerations"
msgstr "Considerações de segurança"

#. type: Title ###
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "Use Docker secrets for sensitive data"
msgstr "Use Docker secrets para dados sensíveis"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "Instead of environment variables, use Docker secrets for sensitive information:"
msgstr "Em vez de variáveis de ambiente, use Docker secrets para informações sensíveis:"

#. type: Fenced code block (bash)
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid ""
"# Create secrets\n"
"echo \"database_password\" | docker secret create db_password -\n"
"echo \"api_key\" | docker secret create api_key -\n"
msgstr ""
"# Cria os secrets\n"
"echo \"database_password\" | docker secret create db_password -\n"
"echo \"api_key\" | docker secret create api_key -\n"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "Update `docker/prod/compose.yml`:"
msgstr "Atualize o `docker/prod/compose.yml`:"

#. type: Fenced code block (yaml)
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid ""
"services:\n"
"  app:\n"
"    secrets:\n"
"      - db_password\n"
"      - api_key\n"
"\n"
"secrets:\n"
"  db_password:\n"
"    external: true\n"
"  api_key:\n"
"    external: true\n"
msgstr ""
"services:\n"
"  app:\n"
"    secrets:\n"
"      - db_password\n"
"      - api_key\n"
"\n"
"secrets:\n"
"  db_password:\n"
"    external: true\n"
"  api_key:\n"
"    external: true\n"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "Access secrets in your application at `/run/secrets/secret_name`."
msgstr "Acesse os secrets na sua aplicação em `/run/secrets/secret_name`."

#. type: Title ###
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "Set up a firewall"
msgstr "Configure um firewall"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "Configure UFW (Uncomplicated Firewall) on your server:"
msgstr "Configure o UFW (Uncomplicated Firewall) no seu servidor:"

#. type: Fenced code block (bash)
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid ""
"# Allow SSH\n"
"sudo ufw allow 22/tcp\n"
"\n"
"# Allow HTTP and HTTPS\n"
"sudo ufw allow 80/tcp\n"
"sudo ufw allow 443/tcp\n"
"\n"
"# Allow Docker Swarm ports (if you plan to add more nodes)\n"
"sudo ufw allow 2377/tcp\n"
"sudo ufw allow 7946/tcp\n"
"sudo ufw allow 7946/udp\n"
"sudo ufw allow 4789/udp\n"
"\n"
"# Enable the firewall\n"
"sudo ufw enable\n"
msgstr ""
"# Libera SSH\n"
"sudo ufw allow 22/tcp\n"
"\n"
"# Libera HTTP e HTTPS\n"
"sudo ufw allow 80/tcp\n"
"sudo ufw allow 443/tcp\n"
"\n"
"# Libera as portas do Docker Swarm (se você pretende adicionar mais nós)\n"
"sudo ufw allow 2377/tcp\n"
"sudo ufw allow 7946/tcp\n"
"sudo ufw allow 7946/udp\n"
"sudo ufw allow 4789/udp\n"
"\n"
"# Habilita o firewall\n"
"sudo ufw enable\n"

#. type: Title ###
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "Keep the system updated"
msgstr "Mantenha o sistema atualizado"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "Regularly update your server and Docker:"
msgstr "Atualize regularmente o seu servidor e o Docker:"

#. type: Fenced code block (bash)
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid ""
"# Update system packages\n"
"sudo apt-get update && sudo apt-get upgrade -y\n"
"\n"
"# Update Docker images\n"
"docker -H ssh://docker-web service update --image ${IMAGE}:${IMAGE_TAG} ${STACK_NAME}_app\n"
msgstr ""
"# Atualiza os pacotes do sistema\n"
"sudo apt-get update && sudo apt-get upgrade -y\n"
"\n"
"# Atualiza as imagens Docker\n"
"docker -H ssh://docker-web service update --image ${IMAGE}:${IMAGE_TAG} ${STACK_NAME}_app\n"

#. type: Title ###
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "Service won't start"
msgstr "O serviço não sobe"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "Check service events and logs:"
msgstr "Verifique os eventos e os logs do serviço:"

#. type: Fenced code block (bash)
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid ""
"docker -H ssh://docker-web service ps ${STACK_NAME}_app --no-trunc\n"
"docker -H ssh://docker-web service logs ${STACK_NAME}_app\n"
msgstr ""
"docker -H ssh://docker-web service ps ${STACK_NAME}_app --no-trunc\n"
"docker -H ssh://docker-web service logs ${STACK_NAME}_app\n"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "Common issues: - **Image pull errors**: Verify registry authentication with `docker -H ssh://docker-web login` - **Port conflicts**: Ensure no other services are using ports 80/443 - **Resource constraints**: Check available resources with `docker -H ssh://docker-web node ls`"
msgstr "Problemas comuns: - **Erros ao baixar a imagem**: verifique a autenticação no registro com `docker -H ssh://docker-web login` - **Conflitos de porta**: garanta que nenhum outro serviço esteja usando as portas 80/443 - **Limitação de recursos**: verifique os recursos disponíveis com `docker -H ssh://docker-web node ls`"

#. type: Title ###
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "SSL certificate issues"
msgstr "Problemas com certificados SSL"

#. type: Title ###
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "Container registry connection issues"
msgstr "Problemas de conexão com o registro de containers"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "Test registry connectivity:"
msgstr "Teste a conectividade com o registro:"

#. type: Fenced code block (bash)
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid ""
"# From your local machine\n"
"docker pull git.example.com/username/myapp:latest\n"
"\n"
"# From the server\n"
"docker -H ssh://docker-web pull git.example.com/username/myapp:latest\n"
msgstr ""
"# Na sua máquina local\n"
"docker pull git.example.com/username/myapp:latest\n"
"\n"
"# No servidor\n"
"docker -H ssh://docker-web pull git.example.com/username/myapp:latest\n"

#. type: Title ##
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "Summary"
msgstr "Resumo"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-caddy.md ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "The Makefile commands simplify the deployment workflow: - `make prod-build` - Build the production image - `make prod-push` - Push to the registry - `make prod-deploy` - Deploy to Docker Swarm"
msgstr "Os comandos do Makefile simplificam o fluxo de deploy: - `make prod-build` - Constrói a imagem de produção - `make prod-push` - Envia para o registro - `make prod-deploy` - Faz o deploy no Docker Swarm"

#. type: Title #
#: ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "Deploying Yii applications to Docker Swarm and Traefik"
msgstr "Fazendo deploy de aplicações Yii no Docker Swarm com Traefik"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "This guide walks you through deploying a Yii application to [Docker Swarm](https://docs.docker.com/engine/swarm/)  starting from a blank server, using [Traefik](https://traefik.io/traefik) as a reverse proxy and deploying from a container registry ([Forgejo](https://forgejo.org/) or [Gitea](https://about.gitea.com/))."
msgstr "Este guia mostra como fazer o deploy de uma aplicação Yii no [Docker Swarm](https://docs.docker.com/engine/swarm/)  a partir de um servidor vazio, usando o [Traefik](https://traefik.io/traefik) como proxy reverso e fazendo o deploy a partir de um registro de containers ([Forgejo](https://forgejo.org/) ou [Gitea](https://about.gitea.com/))."

#. type: Fenced code block (mermaid)
#: ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid ""
"graph LR\n"
"    A[Internet] --> B[Reverse Proxy: Traefik]\n"
"    B --> C[app1.example.com]\n"
"    B --> D[app2.example.com]\n"
"    \n"
"    subgraph Docker Swarm Cluster\n"
"        B\n"
"        C\n"
"        D\n"
"    end\n"
msgstr ""
"graph LR\n"
"    A[Internet] --> B[Proxy reverso: Traefik]\n"
"    B --> C[app1.example.com]\n"
"    B --> D[app2.example.com]\n"
"    \n"
"    subgraph Docker Swarm Cluster\n"
"        B\n"
"        C\n"
"        D\n"
"    end\n"

#. type: Title ##
#: ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "Setting up Traefik as reverse proxy"
msgstr "Configurando o Traefik como proxy reverso"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "To deploy Traefik as reverse proxy create a file `traefik-stack.yml`:"
msgstr "Para fazer o deploy do Traefik como proxy reverso, crie um arquivo `traefik-stack.yml`:"

#. type: Fenced code block (yaml)
#: ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid ""
"services:\n"
"  traefik:\n"
"    image: traefik:v2.10\n"
"    command:\n"
"      - \"--api.insecure=true\"\n"
"      - \"--providers.docker=true\"\n"
"      - \"--providers.docker.swarmMode=true\"\n"
"      - \"--providers.docker.exposedbydefault=false\"\n"
"      - \"--entrypoints.web.address=:80\"\n"
"      - \"--entrypoints.websecure.address=:443\"\n"
"      - \"--certificatesresolvers.letsencrypt.acme.tlschallenge=true\"\n"
"      - \"--certificatesresolvers.letsencrypt.acme.email=admin@example.com\"\n"
"      - \"--certificatesresolvers.letsencrypt.acme.storage=/letsencrypt/acme.json\"\n"
"    ports:\n"
"      - \"80:80\"\n"
"      - \"443:443\"\n"
"      - \"8080:8080\"\n"
"    volumes:\n"
"      - \"/var/run/docker.sock:/var/run/docker.sock:ro\"\n"
"      - \"traefik_certificates:/letsencrypt\"\n"
"    networks:\n"
"      - reverse_proxy_public\n"
"    deploy:\n"
"      placement:\n"
"        constraints:\n"
"          - node.role == manager\n"
"\n"
"volumes:\n"
"  traefik_certificates:\n"
"\n"
"networks:\n"
"  reverse_proxy_public:\n"
"    external: true\n"
msgstr ""
"services:\n"
"  traefik:\n"
"    image: traefik:v2.10\n"
"    command:\n"
"      - \"--api.insecure=true\"\n"
"      - \"--providers.docker=true\"\n"
"      - \"--providers.docker.swarmMode=true\"\n"
"      - \"--providers.docker.exposedbydefault=false\"\n"
"      - \"--entrypoints.web.address=:80\"\n"
"      - \"--entrypoints.websecure.address=:443\"\n"
"      - \"--certificatesresolvers.letsencrypt.acme.tlschallenge=true\"\n"
"      - \"--certificatesresolvers.letsencrypt.acme.email=admin@example.com\"\n"
"      - \"--certificatesresolvers.letsencrypt.acme.storage=/letsencrypt/acme.json\"\n"
"    ports:\n"
"      - \"80:80\"\n"
"      - \"443:443\"\n"
"      - \"8080:8080\"\n"
"    volumes:\n"
"      - \"/var/run/docker.sock:/var/run/docker.sock:ro\"\n"
"      - \"traefik_certificates:/letsencrypt\"\n"
"    networks:\n"
"      - reverse_proxy_public\n"
"    deploy:\n"
"      placement:\n"
"        constraints:\n"
"          - node.role == manager\n"
"\n"
"volumes:\n"
"  traefik_certificates:\n"
"\n"
"networks:\n"
"  reverse_proxy_public:\n"
"    external: true\n"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "Deploy Traefik:"
msgstr "Faça o deploy do Traefik:"

#. type: Fenced code block (bash)
#: ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid "docker stack deploy -c traefik-stack.yml traefik\n"
msgstr "docker stack deploy -c traefik-stack.yml traefik\n"

#. type: Fenced code block (yaml)
#: ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid ""
"services:\n"
"  forgejo:\n"
"    image: codeberg.org/forgejo/forgejo:1.21\n"
"    ports:\n"
"      - \"3000:3000\"\n"
"    volumes:\n"
"      - forgejo_data:/data\n"
"    networks:\n"
"      - reverse_proxy_public\n"
"    deploy:\n"
"      labels:\n"
"        - \"traefik.enable=true\"\n"
"        - \"traefik.http.routers.app.rule=Host(`git.example.com`)\"\n"
"        - \"traefik.http.routers.app.entrypoints=websecure\"\n"
"        - \"traefik.http.routers.app.tls.certresolver=letsencrypt\"\n"
"        - \"traefik.http.services.app.loadbalancer.server.port=3000\"        \n"
"\n"
"volumes:\n"
"  forgejo_data:\n"
"\n"
"networks:\n"
"  reverse_proxy_public:\n"
"    external: true\n"
msgstr ""
"services:\n"
"  forgejo:\n"
"    image: codeberg.org/forgejo/forgejo:1.21\n"
"    ports:\n"
"      - \"3000:3000\"\n"
"    volumes:\n"
"      - forgejo_data:/data\n"
"    networks:\n"
"      - reverse_proxy_public\n"
"    deploy:\n"
"      labels:\n"
"        - \"traefik.enable=true\"\n"
"        - \"traefik.http.routers.app.rule=Host(`git.example.com`)\"\n"
"        - \"traefik.http.routers.app.entrypoints=websecure\"\n"
"        - \"traefik.http.routers.app.tls.certresolver=letsencrypt\"\n"
"        - \"traefik.http.services.app.loadbalancer.server.port=3000\"        \n"
"\n"
"volumes:\n"
"  forgejo_data:\n"
"\n"
"networks:\n"
"  reverse_proxy_public:\n"
"    external: true\n"

#. type: Plain text
#: ../src/cookbook/deployment/docker-swarm-traefik.md
msgid "After deployment, access Forgejo at `https://git.example.com` and complete the initial setup.  Make sure to enable the container registry in the settings."
msgstr "Depois do deploy, acesse o Forgejo em `https://git.example.com` e conclua a configuração inicial.  Não esqueça de habilitar o registro de containers nas configurações."

#. type: Fenced code block (yaml)
#: ../src/cookbook/deployment/docker-swarm-traefik.md
#, no-wrap
msgid ""
"services:\n"
"  gitea:\n"
"    image: gitea/gitea:latest\n"
"    ports:\n"
"      - \"3000:3000\"\n"
"    volumes:\n"
"      - gitea_data:/data\n"
