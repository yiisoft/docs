"        order: start-first\n"
"        failure_action: rollback\n"
"        monitor: 10s\n"
"      rollback_config:\n"
"        parallelism: 0\n"
"        order: stop-first\n"
"      restart_policy:\n"
"        condition: on-failure\n"
"        delay: 5s\n"
"        max_attempts: 3\n"
