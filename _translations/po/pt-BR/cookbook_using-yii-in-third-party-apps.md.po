#. type: Title #
#: ../src/cookbook/using-yii-in-third-party-apps.md
#, no-wrap
msgid "Using Yii in third-party applications"
msgstr "Usando o Yii em aplicações de terceiros"

#. type: Plain text
#: ../src/cookbook/using-yii-in-third-party-apps.md
msgid "Sometimes a project already has an entry point owned by another framework, CMS, or legacy application, but you still want to reuse Yii services: configuration, DI definitions, domain services, logging, mailers, database connections, or console-oriented application code."
msgstr "Às vezes um projeto já tem um ponto de entrada controlado por outro framework, CMS ou aplicação legada, mas você ainda quer reaproveitar serviços do Yii: configuração, definições de DI, serviços de domínio, logs, mailers, conexões com banco de dados ou código de aplicação voltado ao console."

#. type: Plain text
#: ../src/cookbook/using-yii-in-third-party-apps.md
msgid "Yii3 has no global application singleton. Bootstrap the Yii container explicitly and pass the services you need to the third-party code."
msgstr "O Yii3 não tem um singleton global de aplicação. Inicialize o container do Yii explicitamente e passe os serviços de que você precisa ao código de terceiros."

#. type: Title ##
#: ../src/cookbook/using-yii-in-third-party-apps.md
#, no-wrap
msgid "Bootstrap the Yii container"
msgstr "Inicialize o container do Yii"

#. type: Plain text
#: ../src/cookbook/using-yii-in-third-party-apps.md
msgid "Create a small adapter in the host application, for example `bootstrap-yii-services.php`:"
msgstr "Crie um pequeno adaptador na aplicação hospedeira, por exemplo `bootstrap-yii-services.php`:"

#. type: Fenced code block (php)
#: ../src/cookbook/using-yii-in-third-party-apps.md
#, no-wrap
msgid ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"use App\\Environment;\n"
"use Psr\\Container\\ContainerInterface;\n"
"use Yiisoft\\Config\\Config;\n"
"use Yiisoft\\Config\\ConfigInterface;\n"
"use Yiisoft\\Config\\ConfigPaths;\n"
"use Yiisoft\\Config\\Modifier\\RecursiveMerge;\n"
"use Yiisoft\\Config\\Modifier\\ReverseMerge;\n"
"use Yiisoft\\Di\\Container;\n"
"use Yiisoft\\Di\\ContainerConfig;\n"
"\n"
"function yiiContainer(string $yiiRoot): ContainerInterface\n"
"{\n"
"    require_once $yiiRoot . '/src/bootstrap.php';\n"
"\n"
"    $paramsGroup = 'params-console';\n"
"    $eventsGroups = ['events-console', 'events'];\n"
"\n"
"    $config = new Config(\n"
"        paths: new ConfigPaths($yiiRoot, 'config', 'vendor'),\n"
"        environment: Environment::appEnv(),\n"
"        modifiers: [\n"
"            ReverseMerge::groups(...$eventsGroups),\n"
"            RecursiveMerge::groups($paramsGroup, 'params', ...$eventsGroups),\n"
"        ],\n"
"        paramsGroup: $paramsGroup,\n"
"    );\n"
"\n"
"    $containerConfig = ContainerConfig::create()\n"
"        ->withValidate(Environment::appDebug())\n"
"        ->withDefinitions(array_merge(\n"
"            $config->get('di-console'),\n"
"            [ConfigInterface::class => $config],\n"
"        ))\n"
"        ->withProviders($config->get('di-providers-console'))\n"
"        ->withDelegates($config->get('di-delegates-console'));\n"
"\n"
"    if ($config->has('di-tags-console')) {\n"
"        $containerConfig = $containerConfig->withTags($config->get('di-tags-console'));\n"
"    }\n"
"\n"
"    $container = new Container($containerConfig);\n"
"\n"
"    foreach ($config->get('bootstrap-console') as $callback) {\n"
"        if (!is_callable($callback)) {\n"
"            throw new RuntimeException(sprintf(\n"
"                'Bootstrap callback must be callable, \"%s\" given.',\n"
"                get_debug_type($callback),\n"
"            ));\n"
"        }\n"
"\n"
"        $callback($container);\n"
"    }\n"
"\n"
"    return $container;\n"
"}\n"
msgstr ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"use App\\Environment;\n"
"use Psr\\Container\\ContainerInterface;\n"
"use Yiisoft\\Config\\Config;\n"
"use Yiisoft\\Config\\ConfigInterface;\n"
"use Yiisoft\\Config\\ConfigPaths;\n"
"use Yiisoft\\Config\\Modifier\\RecursiveMerge;\n"
"use Yiisoft\\Config\\Modifier\\ReverseMerge;\n"
"use Yiisoft\\Di\\Container;\n"
"use Yiisoft\\Di\\ContainerConfig;\n"
"\n"
"function yiiContainer(string $yiiRoot): ContainerInterface\n"
"{\n"
"    require_once $yiiRoot . '/src/bootstrap.php';\n"
"\n"
"    $paramsGroup = 'params-console';\n"
"    $eventsGroups = ['events-console', 'events'];\n"
"\n"
"    $config = new Config(\n"
"        paths: new ConfigPaths($yiiRoot, 'config', 'vendor'),\n"
"        environment: Environment::appEnv(),\n"
"        modifiers: [\n"
"            ReverseMerge::groups(...$eventsGroups),\n"
"            RecursiveMerge::groups($paramsGroup, 'params', ...$eventsGroups),\n"
"        ],\n"
"        paramsGroup: $paramsGroup,\n"
"    );\n"
"\n"
"    $containerConfig = ContainerConfig::create()\n"
"        ->withValidate(Environment::appDebug())\n"
"        ->withDefinitions(array_merge(\n"
"            $config->get('di-console'),\n"
"            [ConfigInterface::class => $config],\n"
"        ))\n"
"        ->withProviders($config->get('di-providers-console'))\n"
"        ->withDelegates($config->get('di-delegates-console'));\n"
"\n"
"    if ($config->has('di-tags-console')) {\n"
"        $containerConfig = $containerConfig->withTags($config->get('di-tags-console'));\n"
"    }\n"
"\n"
"    $container = new Container($containerConfig);\n"
"\n"
"    foreach ($config->get('bootstrap-console') as $callback) {\n"
"        if (!is_callable($callback)) {\n"
"            throw new RuntimeException(sprintf(\n"
"                'Bootstrap callback must be callable, \"%s\" given.',\n"
"                get_debug_type($callback),\n"
"            ));\n"
"        }\n"
"\n"
"        $callback($container);\n"
"    }\n"
"\n"
"    return $container;\n"
"}\n"

#. type: Plain text
#: ../src/cookbook/using-yii-in-third-party-apps.md
msgid "The adapter builds only the Yii configuration and DI container, then runs the configured bootstrap callbacks. It does not create or run a Yii application runner, so the third-party application keeps ownership of the entry point and process lifecycle."
msgstr "O adaptador monta apenas a configuração e o container de DI do Yii e depois executa os callbacks de bootstrap configurados. Ele não cria nem executa um runner de aplicação do Yii, então a aplicação de terceiros continua dona do ponto de entrada e do ciclo de vida do processo."

#. type: Plain text
#: ../src/cookbook/using-yii-in-third-party-apps.md
msgid "Use console configuration groups when you need common services and console-safe services. Use web groups instead only when you intentionally need web-specific definitions from the `di-web` group, such as PSR-17 HTTP factories or web middleware dependencies."
msgstr "Use os grupos de configuração de console quando precisar de serviços comuns e serviços seguros para o console. Use os grupos web apenas quando precisar intencionalmente de definições específicas da web do grupo `di-web`, como as factories HTTP da PSR-17 ou dependências de middlewares web."

#. type: Title ##
#: ../src/cookbook/using-yii-in-third-party-apps.md
#, no-wrap
msgid "Get Yii services from the host application"
msgstr "Obtenha serviços do Yii a partir da aplicação hospedeira"

#. type: Plain text
#: ../src/cookbook/using-yii-in-third-party-apps.md
msgid "Use the adapter from the third-party application:"
msgstr "Use o adaptador a partir da aplicação de terceiros:"

#. type: Fenced code block (php)
#: ../src/cookbook/using-yii-in-third-party-apps.md
#, no-wrap
msgid ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"use App\\Shared\\ApplicationParams;\n"
"\n"
"require_once __DIR__ . '/path/to/yii-app/vendor/autoload.php';\n"
"require_once __DIR__ . '/bootstrap-yii-services.php';\n"
"\n"
"$container = yiiContainer(__DIR__ . '/path/to/yii-app');\n"
"\n"
"/** @var ApplicationParams $params */\n"
"$params = $container->get(ApplicationParams::class);\n"
"\n"
"echo $params->name;\n"
msgstr ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"use App\\Shared\\ApplicationParams;\n"
"\n"
"require_once __DIR__ . '/path/to/yii-app/vendor/autoload.php';\n"
"require_once __DIR__ . '/bootstrap-yii-services.php';\n"
"\n"
"$container = yiiContainer(__DIR__ . '/path/to/yii-app');\n"
"\n"
"/** @var ApplicationParams $params */\n"
"$params = $container->get(ApplicationParams::class);\n"
"\n"
"echo $params->name;\n"

#. type: Plain text
#: ../src/cookbook/using-yii-in-third-party-apps.md
msgid "In real integrations, prefer getting your own application services instead of framework infrastructure. For example, expose `InvoiceSender`, `ReportBuilder`, or `CatalogImporter` from Yii and call that service from the host application."
msgstr "Em integrações reais, prefira obter os serviços da sua própria aplicação em vez da infraestrutura do framework. Por exemplo, exponha `InvoiceSender`, `ReportBuilder` ou `CatalogImporter` a partir do Yii e chame esse serviço na aplicação hospedeira."

#. type: Title ##
#: ../src/cookbook/using-yii-in-third-party-apps.md
#, no-wrap
msgid "Keep boundaries explicit"
msgstr "Mantenha os limites explícitos"

#. type: Plain text
#: ../src/cookbook/using-yii-in-third-party-apps.md
msgid "Avoid mixing request lifecycles. Let the host application continue to own its HTTP request and response. Let Yii provide services that do not assume Yii is handling the current request."
msgstr "Evite misturar ciclos de vida de requisição. Deixe a aplicação hospedeira continuar dona da requisição e da resposta HTTP. Deixe o Yii fornecer serviços que não pressupõem que o Yii está tratando a requisição atual."

#. type: Plain text
#: ../src/cookbook/using-yii-in-third-party-apps.md
msgid "Good candidates for reuse:"
msgstr "Bons candidatos para reaproveitamento:"

#. type: Bullet: '- '
#: ../src/cookbook/using-yii-in-third-party-apps.md
msgid "domain services;"
msgstr "serviços de domínio;"

#. type: Bullet: '- '
#: ../src/cookbook/using-yii-in-third-party-apps.md
msgid "repositories and database connections;"
msgstr "repositórios e conexões com banco de dados;"

#. type: Bullet: '- '
#: ../src/cookbook/using-yii-in-third-party-apps.md
msgid "mailers and notification services;"
msgstr "mailers e serviços de notificação;"

#. type: Bullet: '- '
#: ../src/cookbook/using-yii-in-third-party-apps.md
msgid "loggers;"
msgstr "loggers;"

#. type: Bullet: '- '
#: ../src/cookbook/using-yii-in-third-party-apps.md
msgid "validators;"
msgstr "validadores;"

#. type: Bullet: '- '
#: ../src/cookbook/using-yii-in-third-party-apps.md
msgid "queue producers;"
msgstr "produtores de fila;"

#. type: Bullet: '- '
#: ../src/cookbook/using-yii-in-third-party-apps.md
msgid "command-like application services."
msgstr "serviços de aplicação no estilo de comandos."

#. type: Plain text
#: ../src/cookbook/using-yii-in-third-party-apps.md
msgid "Avoid pulling in Yii actions, middleware stacks, sessions, CSRF middleware, or view rendering unless the host application explicitly delegates that whole responsibility to Yii."
msgstr "Evite trazer actions, pilhas de middlewares, sessões, middleware de CSRF ou renderização de views do Yii, a menos que a aplicação hospedeira delegue explicitamente essa responsabilidade inteira ao Yii."

#. type: Title ##
#: ../src/cookbook/using-yii-in-third-party-apps.md
#, no-wrap
msgid "Configuration groups"
msgstr "Grupos de configuração"

#. type: Plain text
#: ../src/cookbook/using-yii-in-third-party-apps.md
msgid "The default application template separates configuration by group:"
msgstr "O template de aplicação padrão separa a configuração por grupo:"

#. type: Bullet: '- '
#: ../src/cookbook/using-yii-in-third-party-apps.md
msgid "`di` is shared by web and console entry points;"
msgstr "`di` é compartilhado pelos pontos de entrada web e de console;"

#. type: Bullet: '- '
#: ../src/cookbook/using-yii-in-third-party-apps.md
msgid "`di-console` is console-specific and includes `di` in the template;"
msgstr "`di-console` é específico do console e inclui `di` no template;"

#. type: Bullet: '- '
#: ../src/cookbook/using-yii-in-third-party-apps.md
msgid "`di-web` is web-specific and includes `di`;"
msgstr "`di-web` é específico da web e inclui `di`;"

#. type: Bullet: '- '
#: ../src/cookbook/using-yii-in-third-party-apps.md
msgid "`params-console` and `params-web` extend common `params`."
msgstr "`params-console` e `params-web` estendem o `params` comum."

#. type: Plain text
#: ../src/cookbook/using-yii-in-third-party-apps.md
msgid "Choose the smallest group that contains the services you need. If the host application only needs domain services, keep those definitions in `config/common/di/*.php` so both Yii and the third-party app can use them without web-only dependencies."
msgstr "Escolha o menor grupo que contém os serviços de que você precisa. Se a aplicação hospedeira só precisa de serviços de domínio, mantenha essas definições em `config/common/di/*.php` para que tanto o Yii quanto a aplicação de terceiros possam usá-las sem dependências exclusivas da web."

#. type: Plain text
#: ../src/cookbook/using-yii-in-third-party-apps.md
msgid "After changing `config/configuration.php`, rebuild the merge plan:"
msgstr "Depois de alterar `config/configuration.php`, reconstrua o merge plan:"

#. type: Title ##
#: ../src/cookbook/using-yii-in-third-party-apps.md
#, no-wrap
msgid "Error handling and logging"
msgstr "Tratamento de erros e logs"

#. type: Plain text
#: ../src/cookbook/using-yii-in-third-party-apps.md
msgid "The host application should remain responsible for top-level error handling. Catch exceptions at the integration boundary when the host app needs to convert them into its own response or error format."
msgstr "A aplicação hospedeira deve continuar responsável pelo tratamento de erros de nível mais alto. Capture as exceções na fronteira da integração quando a aplicação hospedeira precisar convertê-las na sua própria resposta ou formato de erro."

#. type: Plain text
#: ../src/cookbook/using-yii-in-third-party-apps.md
msgid "Yii services can still use `Psr\\Log\\LoggerInterface`. Configure the Yii logger to write to the same destination as the host application or bridge both applications to the same PSR-3 logger."
msgstr "Os serviços do Yii ainda podem usar `Psr\\Log\\LoggerInterface`. Configure o logger do Yii para gravar no mesmo destino da aplicação hospedeira ou conecte as duas aplicações ao mesmo logger PSR-3."

#. type: Title ##
#: ../src/cookbook/using-yii-in-third-party-apps.md
#, no-wrap
msgid "Long-running host processes"
msgstr "Processos hospedeiros de longa duração"

#. type: Plain text
#: ../src/cookbook/using-yii-in-third-party-apps.md
msgid "If the third-party application is a worker, daemon, or event-loop server, avoid mutable shared state in services. Yii services resolved from the container are shared by default, so design them as stateless services or create a fresh container for each isolated job when stateful dependencies are unavoidable."
msgstr "Se a aplicação de terceiros for um worker, um daemon ou um servidor com event loop, evite estado mutável compartilhado nos serviços. Os serviços do Yii obtidos do container são compartilhados por padrão, então projete-os como serviços sem estado ou crie um container novo para cada job isolado quando dependências com estado forem inevitáveis."
