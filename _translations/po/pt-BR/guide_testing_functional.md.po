#. type: Title ##
#: ../src/guide/testing/functional.md
#, no-wrap
msgid "Send request data"
msgstr "Enviar dados na requisição"

#. type: Plain text
#: ../src/guide/testing/functional.md
msgid "Use PSR-7 methods to model the request:"
msgstr "Use os métodos PSR-7 para modelar a requisição:"

#. type: Fenced code block (php)
#: ../src/guide/testing/functional.md
#, no-wrap
msgid ""
"$request = (new ServerRequest(uri: '/contact', method: 'POST'))\n"
"    ->withHeader('Content-Type', 'application/x-www-form-urlencoded')\n"
"    ->withParsedBody([\n"
"        'ContactForm' => [\n"
"            'name' => 'Sam',\n"
"            'email' => 'sam@example.test',\n"
"            'body' => 'Hello.',\n"
"        ],\n"
"    ]);\n"
"\n"
"$response = $tester->sendRequest($request);\n"
"\n"
"assertSame(302, $response->getStatusCode());\n"
"assertSame('/contact/sent', $response->getHeaderLine('Location'));\n"
msgstr ""
"$request = (new ServerRequest(uri: '/contact', method: 'POST'))\n"
"    ->withHeader('Content-Type', 'application/x-www-form-urlencoded')\n"
"    ->withParsedBody([\n"
"        'ContactForm' => [\n"
"            'name' => 'Sam',\n"
"            'email' => 'sam@example.test',\n"
"            'body' => 'Hello.',\n"
"        ],\n"
"    ]);\n"
"\n"
"$response = $tester->sendRequest($request);\n"
"\n"
"assertSame(302, $response->getStatusCode());\n"
"assertSame('/contact/sent', $response->getHeaderLine('Location'));\n"

#. type: Plain text
#: ../src/guide/testing/functional.md
msgid "For JSON APIs, write the JSON body into a PSR-7 stream and set `Content-Type: application/json`."
msgstr "Para APIs JSON, escreva o corpo JSON em um stream PSR-7 e defina `Content-Type: application/json`."

#. type: Plain text
#: ../src/guide/testing/functional.md
msgid "Functional tests often touch runtime files, sessions, cache, and a database. Reset changed state in the Cest `_before()` hook or in a project helper:"
msgstr "Testes funcionais costumam mexer em arquivos de runtime, sessões, cache e banco de dados. Redefina o estado alterado no hook `_before()` do Cest ou em um helper do projeto:"

#. type: Fenced code block (php)
#: ../src/guide/testing/functional.md
#, no-wrap
msgid ""
"public function _before(FunctionalTester $tester): void\n"
"{\n"
"    // Reset database tables, cache pools, queues, and outgoing messages.\n"
"}\n"
msgstr ""
"public function _before(FunctionalTester $tester): void\n"
"{\n"
"    // Redefina tabelas do banco de dados, pools de cache, filas e mensagens de saída.\n"
"}\n"

#. type: Plain text
#: ../src/guide/testing/functional.md
msgid "Keep pure domain rules in unit tests. Put request and response behavior in functional tests."
msgstr "Mantenha as regras de domínio puras nos testes unitários. Coloque o comportamento de requisição e resposta nos testes funcionais."
