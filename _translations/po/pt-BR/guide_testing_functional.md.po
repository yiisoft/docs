msgid "Functional tests"
msgstr "Testes funcionais"

#. type: Plain text
#: ../src/guide/testing/functional.md
msgid "Functional tests run application code in the same PHP process. In the Yii application template they live in `tests/Functional` and use `App\\Tests\\Support\\FunctionalTester`."
msgstr "Testes funcionais executam o código da aplicação no mesmo processo PHP. No template de aplicação Yii eles ficam em `tests/Functional` e usam `App\\Tests\\Support\\FunctionalTester`."

#. type: Plain text
#: ../src/guide/testing/functional.md
msgid "Use them for routing, middleware, action handlers, views, container configuration, headers, cookies, and sessions."
msgstr "Use-os para roteamento, middlewares, action handlers, views, configuração do container, headers, cookies e sessões."

#. type: Title ##
#: ../src/guide/testing/functional.md
#, no-wrap
msgid "Functional tester"
msgstr "Functional tester"

#. type: Plain text
#: ../src/guide/testing/functional.md
msgid "The template already has a helper method for sending PSR-7 requests:"
msgstr "O template já tem um método helper para enviar requisições PSR-7:"

#. type: Fenced code block (php)
#: ../src/guide/testing/functional.md
#, no-wrap
msgid ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"namespace App\\Tests\\Support;\n"
"\n"
"use App\\Environment;\n"
"use Psr\\Http\\Message\\ResponseInterface;\n"
"use Psr\\Http\\Message\\ServerRequestInterface;\n"
"use Yiisoft\\Yii\\Runner\\Http\\HttpApplicationRunner;\n"
"\n"
"use function dirname;\n"
"\n"
"class FunctionalTester extends \\Codeception\\Actor\n"
"{\n"
"    use _generated\\FunctionalTesterActions;\n"
"\n"
"    public function sendRequest(ServerRequestInterface $request): ResponseInterface\n"
"    {\n"
"        $runner = new HttpApplicationRunner(\n"
"            rootPath: dirname(__DIR__, 2),\n"
"            environment: Environment::appEnv(),\n"
"        );\n"
"\n"
"        $response = $runner->runAndGetResponse($request);\n"
"        $body = $response->getBody();\n"
"        if ($body->isSeekable()) {\n"
"            $body->rewind();\n"
"        }\n"
"\n"
"        return $response;\n"
"    }\n"
"}\n"
msgstr ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"namespace App\\Tests\\Support;\n"
"\n"
"use App\\Environment;\n"
"use Psr\\Http\\Message\\ResponseInterface;\n"
"use Psr\\Http\\Message\\ServerRequestInterface;\n"
"use Yiisoft\\Yii\\Runner\\Http\\HttpApplicationRunner;\n"
"\n"
"use function dirname;\n"
"\n"
"class FunctionalTester extends \\Codeception\\Actor\n"
"{\n"
"    use _generated\\FunctionalTesterActions;\n"
"\n"
"    public function sendRequest(ServerRequestInterface $request): ResponseInterface\n"
"    {\n"
"        $runner = new HttpApplicationRunner(\n"
"            rootPath: dirname(__DIR__, 2),\n"
"            environment: Environment::appEnv(),\n"
"        );\n"
"\n"
"        $response = $runner->runAndGetResponse($request);\n"
"        $body = $response->getBody();\n"
"        if ($body->isSeekable()) {\n"
"            $body->rewind();\n"
"        }\n"
"\n"
"        return $response;\n"
"    }\n"
"}\n"

#. type: Plain text
#: ../src/guide/testing/functional.md
msgid "The template includes `tests/Functional/HomePageCest.php`:"
msgstr "O template inclui `tests/Functional/HomePageCest.php`:"

#. type: Fenced code block (php)
#: ../src/guide/testing/functional.md
#, no-wrap
msgid ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"namespace App\\Tests\\Functional;\n"
"\n"
"use App\\Tests\\Support\\FunctionalTester;\n"
"use HttpSoft\\Message\\ServerRequest;\n"
"\n"
"use function PHPUnit\\Framework\\assertSame;\n"
"use function PHPUnit\\Framework\\assertStringContainsString;\n"
"\n"
"final class HomePageCest\n"
"{\n"
"    public function base(FunctionalTester $tester): void\n"
"    {\n"
"        $response = $tester->sendRequest(\n"
"            new ServerRequest(uri: '/'),\n"
"        );\n"
"\n"
"        assertSame(200, $response->getStatusCode());\n"
"        assertStringContainsString(\n"
"            'Don\\'t forget to check the guide',\n"
"            $response->getBody()->getContents(),\n"
"        );\n"
"    }\n"
"}\n"
msgstr ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"namespace App\\Tests\\Functional;\n"
"\n"
"use App\\Tests\\Support\\FunctionalTester;\n"
"use HttpSoft\\Message\\ServerRequest;\n"
"\n"
"use function PHPUnit\\Framework\\assertSame;\n"
"use function PHPUnit\\Framework\\assertStringContainsString;\n"
"\n"
"final class HomePageCest\n"
"{\n"
"    public function base(FunctionalTester $tester): void\n"
"    {\n"
"        $response = $tester->sendRequest(\n"
"            new ServerRequest(uri: '/'),\n"
"        );\n"
"\n"
"        assertSame(200, $response->getStatusCode());\n"
"        assertStringContainsString(\n"
"            'Don\\'t forget to check the guide',\n"
"            $response->getBody()->getContents(),\n"
"        );\n"
"    }\n"
"}\n"

