msgid "Body"
msgstr "Corpo"

#. type: Title #
#: ../src/en/internals/006-git-commit-messages.md
#, no-wrap
msgid "006 — Git commit messages"
msgstr "006 — Mensagens de commit do Git"

#. type: Title ##
#: ../src/en/internals/006-git-commit-messages.md
#, no-wrap
msgid "Subject line"
msgstr "Linha de assunto"

#. type: Bullet: '- '
#: ../src/en/internals/006-git-commit-messages.md
msgid "Use `#123` to reference issue by number"
msgstr "Use `#123` para referenciar uma issue pelo número"

#. type: Bullet: '- '
#: ../src/en/internals/006-git-commit-messages.md
msgid "Use imperative mood that's `Fix`, not `Fixed`"
msgstr "Use o modo imperativo, ou seja, `Fix`, e não `Fixed`"

#. type: Bullet: '- '
#: ../src/en/internals/006-git-commit-messages.md
msgid "Don't add a period at the end"
msgstr "Não coloque ponto final"

#. type: Bullet: '- '
#: ../src/en/internals/006-git-commit-messages.md
msgid "Use `[skip ci]` if there is no need to run unit tests"
msgstr "Use `[skip ci]` se não houver necessidade de rodar os testes unitários"

#. type: Bullet: '- '
#: ../src/en/internals/006-git-commit-messages.md
msgid "Start with a capital letter"
msgstr "Comece com letra maiúscula"

#. type: Bullet: '- '
#: ../src/en/internals/006-git-commit-messages.md
msgid "Limit to 50 characters"
msgstr "Limite a 50 caracteres"

#. type: Plain text
#: ../src/en/internals/006-git-commit-messages.md
msgid "Use the message body **if** you need an extra explanation. Explain why, not how."
msgstr "Use o corpo da mensagem **se** precisar de uma explicação extra. Explique o porquê, não o como."

#. type: Bullet: '- '
#: ../src/en/internals/006-git-commit-messages.md
msgid "Limit line length to 72 characters"
msgstr "Limite o tamanho das linhas a 72 caracteres"
