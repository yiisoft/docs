"                    ->action(Web\\Page\\ListAction::class)\n"
"                    ->name('page/list'),\n"
"                Route::get('/{slug}')\n"
"                    ->action(Web\\Page\\ViewAction::class)\n"
"                    ->name('page/view'),\n"
