#. type: Title #
#: ../src/guide/testing/environment-setup.md
#, no-wrap
msgid "Testing environment setup"
msgstr "Configuração do ambiente de testes"

#. type: Plain text
#: ../src/guide/testing/environment-setup.md
msgid "The Yii application template has the test environment configured. Use this page when creating a new project from the template, restoring removed test files, or adding a new suite."
msgstr "O template de aplicação Yii já vem com o ambiente de testes configurado. Use esta página ao criar um novo projeto a partir do template, restaurar arquivos de teste removidos ou adicionar uma nova suíte."

#. type: Title ##
#: ../src/guide/testing/environment-setup.md
#, no-wrap
msgid "Composer configuration"
msgstr "Configuração do Composer"

#. type: Plain text
#: ../src/guide/testing/environment-setup.md
msgid "The template requires Codeception, PHPUnit, and the modules used by the suites:"
msgstr "O template exige o Codeception, o PHPUnit e os módulos usados pelas suítes:"

#. type: Fenced code block (json)
#: ../src/guide/testing/environment-setup.md
#, no-wrap
msgid ""
"{\n"
"  \"require-dev\": {\n"
"    \"codeception/codeception\": \"^5.3\",\n"
"    \"codeception/module-asserts\": \"^3.2\",\n"
"    \"codeception/module-cli\": \"^2.0\",\n"
"    \"codeception/module-phpbrowser\": \"^3.0\",\n"
"    \"phpunit/phpunit\": \"^11.5\"\n"
"  },\n"
"  \"autoload-dev\": {\n"
"    \"psr-4\": {\n"
"      \"App\\\\Tests\\\\\": \"tests\"\n"
"    }\n"
"  },\n"
"  \"scripts\": {\n"
"    \"test\": \"codecept run\"\n"
"  }\n"
"}\n"
msgstr ""
"{\n"
"  \"require-dev\": {\n"
"    \"codeception/codeception\": \"^5.3\",\n"
"    \"codeception/module-asserts\": \"^3.2\",\n"
"    \"codeception/module-cli\": \"^2.0\",\n"
"    \"codeception/module-phpbrowser\": \"^3.0\",\n"
"    \"phpunit/phpunit\": \"^11.5\"\n"
"  },\n"
"  \"autoload-dev\": {\n"
"    \"psr-4\": {\n"
"      \"App\\\\Tests\\\\\": \"tests\"\n"
"    }\n"
"  },\n"
"  \"scripts\": {\n"
"    \"test\": \"codecept run\"\n"
"  }\n"
"}\n"

#. type: Plain text
#: ../src/guide/testing/environment-setup.md
msgid "If these entries are already in your project, keep the installed versions from `composer.lock`."
msgstr "Se essas entradas já estiverem no seu projeto, mantenha as versões instaladas do `composer.lock`."

#. type: Title ##
#: ../src/guide/testing/environment-setup.md
#, no-wrap
msgid "Main Codeception file"
msgstr "Arquivo principal do Codeception"

#. type: Plain text
#: ../src/guide/testing/environment-setup.md
msgid "The root `codeception.yml` defines the test namespace, paths, bootstrap file, and coverage source:"
msgstr "O `codeception.yml` na raiz define o namespace dos testes, os caminhos, o arquivo de bootstrap e a origem da cobertura:"

#. type: Fenced code block (yaml)
#: ../src/guide/testing/environment-setup.md
#, no-wrap
msgid ""
"namespace: App\\Tests\n"
"support_namespace: Support\n"
"bootstrap: bootstrap.php\n"
"\n"
"settings:\n"
"  shuffle: true\n"
"  colors: true\n"
"\n"
"paths:\n"
"  tests: tests\n"
"  output: tests/_output\n"
"  data: tests/Support/Data\n"
"  support: tests/Support\n"
"\n"
"coverage:\n"
"  enabled: true\n"
"  show_uncovered: true\n"
"  show_only_summary: true\n"
"  include:\n"
"    - src/*\n"
"    - public/index.php\n"
"    - yii\n"
"\n"
"extensions:\n"
"  enabled:\n"
"    - Codeception\\Extension\\RunFailed\n"
msgstr ""
"namespace: App\\Tests\n"
"support_namespace: Support\n"
"bootstrap: bootstrap.php\n"
"\n"
"settings:\n"
"  shuffle: true\n"
"  colors: true\n"
"\n"
"paths:\n"
"  tests: tests\n"
"  output: tests/_output\n"
"  data: tests/Support/Data\n"
"  support: tests/Support\n"
"\n"
"coverage:\n"
"  enabled: true\n"
"  show_uncovered: true\n"
"  show_only_summary: true\n"
"  include:\n"
"    - src/*\n"
"    - public/index.php\n"
"    - yii\n"
"\n"
"extensions:\n"
"  enabled:\n"
"    - Codeception\\Extension\\RunFailed\n"

#. type: Plain text
#: ../src/guide/testing/environment-setup.md
msgid "`tests/bootstrap.php` prepares the application environment for every suite:"
msgstr "`tests/bootstrap.php` prepara o ambiente da aplicação para todas as suítes:"

#. type: Fenced code block (php)
#: ../src/guide/testing/environment-setup.md
#, no-wrap
msgid ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"App\\Environment::prepare();\n"
msgstr ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"App\\Environment::prepare();\n"

#. type: Plain text
#: ../src/guide/testing/environment-setup.md
msgid "Set `APP_ENV=test` when running tests locally:"
msgstr "Defina `APP_ENV=test` ao executar os testes localmente:"

#. type: Fenced code block (shell)
#: ../src/guide/testing/environment-setup.md ../src/guide/testing/overview.md
#, no-wrap
msgid "APP_ENV=test vendor/bin/codecept run\n"
msgstr "APP_ENV=test vendor/bin/codecept run\n"

#. type: Plain text
#: ../src/guide/testing/environment-setup.md
msgid "The Docker test service reads the same value from `docker/test/.env`:"
msgstr "O serviço de testes do Docker lê o mesmo valor de `docker/test/.env`:"

#. type: Fenced code block (dotenv)
#: ../src/guide/testing/environment-setup.md
#, no-wrap
msgid ""
"APP_ENV=test\n"
"APP_DEBUG=false\n"
"APP_C3=true\n"
"SERVER_NAME=:80\n"
"XDEBUG_MODE=coverage\n"
"COMPOSER_CACHE_DIR=/app/runtime/cache/composer\n"
msgstr ""
"APP_ENV=test\n"
"APP_DEBUG=false\n"
"APP_C3=true\n"
"SERVER_NAME=:80\n"
"XDEBUG_MODE=coverage\n"
"COMPOSER_CACHE_DIR=/app/runtime/cache/composer\n"

#. type: Title ##
#: ../src/guide/testing/environment-setup.md
#, no-wrap
msgid "Suites"
msgstr "Suítes"

#. type: Plain text
#: ../src/guide/testing/environment-setup.md
msgid "The template has one suite file per test type."
msgstr "O template tem um arquivo de suíte por tipo de teste."

#. type: Plain text
#: ../src/guide/testing/environment-setup.md
msgid "`tests/Unit.suite.yml` enables PHPUnit assertions through Codeception:"
msgstr "`tests/Unit.suite.yml` habilita as asserções do PHPUnit por meio do Codeception:"

#. type: Fenced code block (yaml)
#: ../src/guide/testing/environment-setup.md
#, no-wrap
msgid ""
"actor: UnitTester\n"
"modules:\n"
"    enabled:\n"
"        - Asserts\n"
msgstr ""
"actor: UnitTester\n"
"modules:\n"
"    enabled:\n"
"        - Asserts\n"

#. type: Plain text
#: ../src/guide/testing/environment-setup.md
msgid "`tests/Functional.suite.yml` uses the project `FunctionalTester` helper:"
msgstr "`tests/Functional.suite.yml` usa o helper `FunctionalTester` do projeto:"

#. type: Fenced code block (yaml)
#: ../src/guide/testing/environment-setup.md
#, no-wrap
msgid "actor: FunctionalTester\n"
msgstr "actor: FunctionalTester\n"

#. type: Plain text
#: ../src/guide/testing/environment-setup.md
msgid "`tests/Web.suite.yml` starts the built-in server and sends HTTP requests with PhpBrowser:"
msgstr "`tests/Web.suite.yml` inicia o servidor embutido e envia requisições HTTP com o PhpBrowser:"

#. type: Plain text
#: ../src/guide/testing/environment-setup.md
msgid "`tests/Console.suite.yml` enables console command testing:"
msgstr "`tests/Console.suite.yml` habilita os testes de comandos de console:"

#. type: Fenced code block (yaml)
#: ../src/guide/testing/environment-setup.md
#, no-wrap
msgid ""
"actor: ConsoleTester\n"
"modules:\n"
"  enabled:\n"
"    - Cli\n"
msgstr ""
"actor: ConsoleTester\n"
"modules:\n"
"  enabled:\n"
"    - Cli\n"

#. type: Plain text
#: ../src/guide/testing/environment-setup.md
msgid "After adding or changing a suite, rebuild generated actor actions:"
msgstr "Depois de adicionar ou alterar uma suíte, reconstrua as ações geradas dos actors:"

#. type: Fenced code block (shell)
#: ../src/guide/testing/environment-setup.md ../src/guide/testing/overview.md
#, no-wrap
msgid "vendor/bin/codecept build\n"
msgstr "vendor/bin/codecept build\n"

#. type: Fenced code block (shell)
#: ../src/guide/testing/environment-setup.md ../src/guide/testing/overview.md
#, no-wrap
msgid "make codecept build\n"
msgstr "make codecept build\n"

#. type: Title ##
#: ../src/guide/testing/environment-setup.md
#, no-wrap
msgid "Test configuration"
msgstr "Configuração de testes"

#. type: Plain text
#: ../src/guide/testing/environment-setup.md
msgid "Put test-only application parameters into `config/environments/test/params.php`. The application loads this file when `APP_ENV=test`."
msgstr "Coloque os parâmetros da aplicação exclusivos de teste em `config/environments/test/params.php`. A aplicação carrega esse arquivo quando `APP_ENV=test`."

#. type: Plain text
#: ../src/guide/testing/environment-setup.md
msgid "Use the test environment for values such as:"
msgstr "Use o ambiente de teste para valores como:"

#. type: Bullet: '- '
#: ../src/guide/testing/environment-setup.md
msgid "Database name and credentials."
msgstr "Nome e credenciais do banco de dados."

#. type: Bullet: '- '
#: ../src/guide/testing/environment-setup.md
msgid "Mailer transport."
msgstr "Transporte do mailer."

#. type: Bullet: '- '
#: ../src/guide/testing/environment-setup.md
msgid "Queue transport."
msgstr "Transporte da fila."

#. type: Bullet: '- '
#: ../src/guide/testing/environment-setup.md
msgid "Cache storage."
msgstr "Armazenamento do cache."

#. type: Bullet: '- '
#: ../src/guide/testing/environment-setup.md
msgid "Log target paths."
msgstr "Caminhos dos destinos de log."

#. type: Plain text
#: ../src/guide/testing/environment-setup.md
msgid "Keep test credentials separate from development and production credentials."
msgstr "Mantenha as credenciais de teste separadas das credenciais de desenvolvimento e produção."

#. type: Title ##
#: ../src/guide/testing/environment-setup.md
#, no-wrap
msgid "State reset"
msgstr "Redefinição de estado"

#. type: Plain text
#: ../src/guide/testing/environment-setup.md
msgid "Each test must leave the next test with predictable state. Choose a reset strategy for every external resource the test changes:"
msgstr "Cada teste deve deixar para o próximo um estado previsível. Escolha uma estratégia de redefinição para cada recurso externo que o teste altera:"

#. type: Bullet: '- '
#: ../src/guide/testing/environment-setup.md
msgid "Recreate or truncate database tables before application-level tests."
msgstr "Recrie ou trunque as tabelas do banco de dados antes dos testes de nível de aplicação."

#. type: Bullet: '- '
#: ../src/guide/testing/environment-setup.md
msgid "Clear cache pools used by the test environment."
msgstr "Limpe os pools de cache usados pelo ambiente de teste."

#. type: Bullet: '- '
#: ../src/guide/testing/environment-setup.md
msgid "Clear sessions and cookies in web tests."
msgstr "Limpe sessões e cookies nos testes web."

#. type: Bullet: '- '
#: ../src/guide/testing/environment-setup.md
msgid "Remove generated files from `runtime`."
msgstr "Remova arquivos gerados de `runtime`."

#. type: Bullet: '- '
#: ../src/guide/testing/environment-setup.md
msgid "Replace outgoing mail, queues, and HTTP clients with test doubles where practical."
msgstr "Substitua e-mails enviados, filas e clientes HTTP por test doubles quando for viável."

#. type: Plain text
#: ../src/guide/testing/environment-setup.md
msgid "For database tests, prefer one project-wide fixture or migration flow. Mixing reset strategies makes failures hard to reproduce."
msgstr "Para testes de banco de dados, prefira um único fluxo de fixtures ou migrations para todo o projeto. Misturar estratégias de redefinição torna as falhas difíceis de reproduzir."

#. type: Title ##
#: ../src/guide/testing/environment-setup.md
#, no-wrap
msgid "Coverage"
msgstr "Cobertura"

#. type: Plain text
#: ../src/guide/testing/environment-setup.md
msgid "Run coverage locally when Xdebug or another coverage driver is enabled:"
msgstr "Execute a cobertura localmente quando o Xdebug ou outro driver de cobertura estiver habilitado:"

#. type: Fenced code block (shell)
#: ../src/guide/testing/environment-setup.md
#, no-wrap
msgid "APP_ENV=test APP_C3=true XDEBUG_MODE=coverage vendor/bin/codecept run --coverage --coverage-html --disable-coverage-php\n"
msgstr "APP_ENV=test APP_C3=true XDEBUG_MODE=coverage vendor/bin/codecept run --coverage --coverage-html --disable-coverage-php\n"

#. type: Plain text
#: ../src/guide/testing/environment-setup.md
msgid "With Docker, coverage variables are already in `docker/test/.env`:"
msgstr "Com Docker, as variáveis de cobertura já estão em `docker/test/.env`:"

#. type: Fenced code block (shell)
#: ../src/guide/testing/environment-setup.md
#, no-wrap
msgid "make test-coverage\n"
msgstr "make test-coverage\n"
