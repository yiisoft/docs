#. type: Title ###
#: ../src/guide/views/template-engines.md
#, no-wrap
msgid "Rendering Twig Templates"
msgstr "Renderizando templates Twig"

#. type: Plain text
#: ../src/guide/views/template-engines.md
msgid "Use Twig templates the same way as PHP templates:"
msgstr "Use templates Twig da mesma forma que templates PHP:"

#. type: Fenced code block (php)
#: ../src/guide/views/template-engines.md
#, no-wrap
msgid ""
"// In your controller\n"
"public function about(): ResponseInterface\n"
"{\n"
"    return $this->viewRenderer->render('about.twig', [\n"
"        'user' => $this->getCurrentUser(),\n"
"        'posts' => $this->getRecentPosts(),\n"
"    ]);\n"
"}\n"
msgstr ""
"// No seu controller\n"
"public function about(): ResponseInterface\n"
"{\n"
"    return $this->viewRenderer->render('about.twig', [\n"
"        'user' => $this->getCurrentUser(),\n"
"        'posts' => $this->getRecentPosts(),\n"
"    ]);\n"
"}\n"

#. type: Title ##
#: ../src/guide/views/template-engines.md
#, no-wrap
msgid "Custom Template Engines"
msgstr "Template engines personalizadas"

#. type: Plain text
#: ../src/guide/views/template-engines.md
msgid "You can create custom template engines by implementing the `TemplateRendererInterface`:"
msgstr "Você pode criar template engines personalizadas implementando a `TemplateRendererInterface`:"

#. type: Fenced code block (php)
#: ../src/guide/views/template-engines.md
#, no-wrap
msgid ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"namespace App\\View;\n"
"\n"
"use Yiisoft\\View\\TemplateRendererInterface;\n"
"\n"
"final class MarkdownRenderer implements TemplateRendererInterface\n"
"{\n"
"    public function __construct(\n"
"        private MarkdownParserInterface $parser,\n"
"    ) {}\n"
"\n"
"    public function render(string $template, array $parameters = []): string\n"
"    {\n"
"        $content = file_get_contents($template);\n"
"        \n"
"        // Replace placeholders with parameters\n"
"        foreach ($parameters as $key => $value) {\n"
"            $content = str_replace(\"{{$key}}\", (string) $value, $content);\n"
"        }\n"
"        \n"
"        return $this->parser->parse($content);\n"
"    }\n"
"}\n"
msgstr ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"namespace App\\View;\n"
"\n"
"use Yiisoft\\View\\TemplateRendererInterface;\n"
"\n"
"final class MarkdownRenderer implements TemplateRendererInterface\n"
"{\n"
"    public function __construct(\n"
"        private MarkdownParserInterface $parser,\n"
"    ) {}\n"
"\n"
"    public function render(string $template, array $parameters = []): string\n"
"    {\n"
"        $content = file_get_contents($template);\n"
"        \n"
"        // Substitui os placeholders pelos parâmetros\n"
"        foreach ($parameters as $key => $value) {\n"
"            $content = str_replace(\"{{$key}}\", (string) $value, $content);\n"
"        }\n"
"        \n"
"        return $this->parser->parse($content);\n"
"    }\n"
"}\n"

#. type: Plain text
#: ../src/guide/views/template-engines.md
msgid "Register your custom renderer:"
msgstr "Registre o seu renderer personalizado:"

#. type: Fenced code block (php)
#: ../src/guide/views/template-engines.md
#, no-wrap
msgid ""
"use Yiisoft\\Container\\Reference;\n"
"\n"
"// In configuration\n"
"'yiisoft/view' => [\n"
"    'renderers' => [\n"
"        'md' => Reference::to(App\\View\\MarkdownRenderer::class),\n"
"    ],\n"
"],\n"
msgstr ""
"use Yiisoft\\Container\\Reference;\n"
"\n"
"// Na configuração\n"
"'yiisoft/view' => [\n"
"    'renderers' => [\n"
"        'md' => Reference::to(App\\View\\MarkdownRenderer::class),\n"
"    ],\n"
"],\n"

