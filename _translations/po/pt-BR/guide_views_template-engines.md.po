#. type: Title ##
#: ../src/guide/views/asset.md ../src/guide/views/script-style-meta.md ../src/guide/views/template-engines.md
#, no-wrap
msgid "Best Practices"
msgstr "Boas práticas"

#. type: Title #
#: ../src/guide/views/template-engines.md
#, no-wrap
msgid "Template engines"
msgstr "Template engines"

#. type: Plain text
#: ../src/guide/views/template-engines.md
msgid "Yii3 supports multiple template engines through a flexible renderer system. By default, PHP is used as the template engine, but you can easily add support for other engines like Twig and [Blade](https://github.com/lee-to/yii-blade), or create your own custom renderers."
msgstr "O Yii3 suporta várias template engines por meio de um sistema flexível de renderers. Por padrão, o PHP é usado como template engine, mas você pode adicionar suporte a outras engines como Twig e [Blade](https://github.com/lee-to/yii-blade), ou criar seus próprios renderers."

#. type: Plain text
#: ../src/guide/views/template-engines.md
msgid "PHP templates were described in the \"[View](view.md)\" guide section."
msgstr "Os templates PHP foram descritos na seção \"[View](view.md)\" do guia."

#. type: Title ##
#: ../src/guide/views/template-engines.md
#, no-wrap
msgid "Twig Template Engine"
msgstr "Template engine Twig"

#. type: Plain text
#: ../src/guide/views/template-engines.md
msgid "Twig is a modern template engine that provides a more designer-friendly syntax. To use Twig in your Yii3 application, you need to install the Twig extension."
msgstr "O Twig é uma template engine moderna, com uma sintaxe mais amigável para designers. Para usar o Twig na sua aplicação Yii3, instale a extensão do Twig."

#. type: Fenced code block (bash)
#: ../src/guide/views/template-engines.md
#, no-wrap
msgid "composer require yiisoft/view-twig\n"
msgstr "composer require yiisoft/view-twig\n"

#. type: Plain text
#: ../src/guide/views/template-engines.md
msgid "Now you can use `.twig` templates. For example, `views/site/about.twig`:"
msgstr "Agora você pode usar templates `.twig`. Por exemplo, `views/site/about.twig`:"

#. type: Fenced code block (twig)
#: ../src/guide/views/template-engines.md
#, no-wrap
msgid ""
"{# Variable type hints for IDE support #}\n"
"{# @var user \\App\\Entity\\User #}\n"
"{# @var posts \\App\\Entity\\Post[] #}\n"
"\n"
"<div class=\"user-profile\">\n"
"    <h1>{{ user.name }}</h1>\n"
"    <p>Email: {{ user.email }}</p>\n"
"    \n"
"    {% if posts is not empty %}\n"
"        <h2>Recent Posts</h2>\n"
"        <ul class=\"posts\">\n"
"            {% for post in posts %}\n"
"                <li>\n"
"                    <h3>{{ post.title }}</h3>\n"
"                    <p>{{ post.excerpt }}</p>\n"
"                    <time>{{ post.publishedAt|date('F j, Y') }}</time>\n"
"                </li>\n"
"            {% endfor %}\n"
"        </ul>\n"
"    {% else %}\n"
"        <p>No posts available.</p>\n"
"    {% endif %}\n"
"</div>\n"
msgstr ""
"{# Dicas de tipo das variáveis para suporte na IDE #}\n"
"{# @var user \\App\\Entity\\User #}\n"
"{# @var posts \\App\\Entity\\Post[] #}\n"
"\n"
"<div class=\"user-profile\">\n"
"    <h1>{{ user.name }}</h1>\n"
"    <p>Email: {{ user.email }}</p>\n"
"    \n"
"    {% if posts is not empty %}\n"
"        <h2>Recent Posts</h2>\n"
"        <ul class=\"posts\">\n"
"            {% for post in posts %}\n"
"                <li>\n"
"                    <h3>{{ post.title }}</h3>\n"
"                    <p>{{ post.excerpt }}</p>\n"
"                    <time>{{ post.publishedAt|date('F j, Y') }}</time>\n"
"                </li>\n"
"            {% endfor %}\n"
"        </ul>\n"
"    {% else %}\n"
"        <p>No posts available.</p>\n"
"    {% endif %}\n"
"</div>\n"

#. type: Title ###
#: ../src/guide/views/template-engines.md
#, no-wrap
msgid "Twig Features"
msgstr "Recursos do Twig"

#. type: Plain text
#: ../src/guide/views/template-engines.md
#, no-wrap
msgid "**Automatic Escaping**: Twig automatically escapes variables for HTML context:\n"
msgstr "**Escape automático**: o Twig escapa as variáveis automaticamente para o contexto HTML:\n"

#. type: Fenced code block (twig)
#: ../src/guide/views/template-engines.md
#, no-wrap
msgid ""
"{# Automatically escaped #}\n"
"<h1>{{ title }}</h1>\n"
"\n"
"{# Raw output (use carefully) #}\n"
"<div>{{ content|raw }}</div>\n"
msgstr ""
"{# Escapado automaticamente #}\n"
"<h1>{{ title }}</h1>\n"
"\n"
"{# Saída bruta (use com cuidado) #}\n"
"<div>{{ content|raw }}</div>\n"

#. type: Plain text
#: ../src/guide/views/template-engines.md
#, no-wrap
msgid "**Filters and Functions**: Twig provides many built-in filters and functions:\n"
msgstr "**Filtros e funções**: o Twig oferece muitos filtros e funções nativos:\n"

#. type: Fenced code block (twig)
#: ../src/guide/views/template-engines.md
#, no-wrap
msgid ""
"{# Date formatting #}\n"
"<time>{{ post.createdAt|date('Y-m-d H:i') }}</time>\n"
"\n"
"{# String manipulation #}\n"
"<p>{{ description|truncate(100) }}</p>\n"
"\n"
"{# URL generation #}\n"
"<a href=\"{{ path('user.profile', {'id': user.id}) }}\">Profile</a>\n"
msgstr ""
"{# Formatação de data #}\n"
"<time>{{ post.createdAt|date('Y-m-d H:i') }}</time>\n"
"\n"
"{# Manipulação de strings #}\n"
"<p>{{ description|truncate(100) }}</p>\n"
"\n"
"{# Geração de URLs #}\n"
"<a href=\"{{ path('user.profile', {'id': user.id}) }}\">Profile</a>\n"

#. type: Plain text
#: ../src/guide/views/template-engines.md
#, no-wrap
msgid "**Template Inheritance**: Twig supports template inheritance:\n"
msgstr "**Herança de templates**: o Twig suporta herança de templates:\n"

#. type: Plain text
#: ../src/guide/views/template-engines.md
#, no-wrap
msgid "**views/layout/main.twig**\n"
msgstr "**views/layout/main.twig**\n"

#. type: Fenced code block (twig)
#: ../src/guide/views/template-engines.md
#, no-wrap
msgid ""
"<!DOCTYPE html>\n"
"<html>\n"
"<head>\n"
"    <title>{% block title %}Default Title{% endblock %}</title>\n"
"</head>\n"
"<body>\n"
"    <main>\n"
"        {% block content %}{% endblock %}\n"
"    </main>\n"
"</body>\n"
"</html>\n"
msgstr ""
"<!DOCTYPE html>\n"
"<html>\n"
"<head>\n"
"    <title>{% block title %}Default Title{% endblock %}</title>\n"
"</head>\n"
"<body>\n"
"    <main>\n"
"        {% block content %}{% endblock %}\n"
"    </main>\n"
"</body>\n"
"</html>\n"

#. type: Plain text
#: ../src/guide/views/template-engines.md
#, no-wrap
msgid "**views/site/about.twig**\n"
msgstr "**views/site/about.twig**\n"

#. type: Fenced code block (twig)
