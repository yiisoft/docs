msgstr "Faça o profiling do seu código para encontrar os gargalos de desempenho e tomar as medidas adequadas.  As seguintes ferramentas de profiling podem ser úteis:"

#. type: Plain text
#: ../src/guide/tutorial/performance-tuning.md
#, no-wrap
msgid "<!-- - [Yii debug toolbar and debugger](https://github.com/yiisoft/yii2-debug/blob/master/docs/guide/README.md) -->\n"
msgstr "<!-- - [Yii debug toolbar and debugger](https://github.com/yiisoft/yii2-debug/blob/master/docs/guide/README.md) -->\n"

#. type: Bullet: '- '
#: ../src/guide/tutorial/performance-tuning.md
msgid "[Blackfire](https://blackfire.io/)"
msgstr "[Blackfire](https://blackfire.io/)"

#. type: Bullet: '- '
#: ../src/guide/tutorial/performance-tuning.md
msgid "[XHProf](https://secure.php.net/manual/en/book.xhprof.php)"
msgstr "[XHProf](https://secure.php.net/manual/en/book.xhprof.php)"

#. type: Bullet: '- '
#: ../src/guide/tutorial/performance-tuning.md
msgid "[XDebug profiler](https://xdebug.org/docs/profiler)"
msgstr "[Profiler do XDebug](https://xdebug.org/docs/profiler)"
