#. type: Title ###
#: ../src/cookbook/making-http-requests.md ../src/guide/index.md ../src/guide/testing/overview.md ../src/guide/tutorial/docker.md
#, no-wrap
msgid "Testing"
msgstr "Testes"

#. type: Fenced code block (shell)
#: ../src/guide/testing/environment-setup.md ../src/guide/testing/overview.md
#, no-wrap
msgid "APP_ENV=test vendor/bin/codecept run\n"
msgstr "APP_ENV=test vendor/bin/codecept run\n"

#. type: Fenced code block (shell)
#: ../src/guide/testing/environment-setup.md ../src/guide/testing/overview.md
#, no-wrap
msgid "vendor/bin/codecept build\n"
msgstr "vendor/bin/codecept build\n"

#. type: Fenced code block (shell)
#: ../src/guide/testing/environment-setup.md ../src/guide/testing/overview.md
#, no-wrap
msgid "make codecept build\n"
msgstr "make codecept build\n"

#. type: Plain text
#: ../src/guide/testing/overview.md
msgid "The Yii application template includes a ready test setup. It uses Codeception with PHPUnit assertions and has four suites:"
msgstr "O template de aplicação Yii inclui uma configuração de testes pronta. Ele usa o Codeception com asserções do PHPUnit e tem quatro suítes:"

#. type: Bullet: '- '
#: ../src/guide/testing/overview.md
msgid "`Unit` for isolated PHP classes."
msgstr "`Unit` para classes PHP isoladas."

#. type: Bullet: '- '
#: ../src/guide/testing/overview.md
msgid "`Functional` for application code called in the same PHP process."
msgstr "`Functional` para código da aplicação chamado no mesmo processo PHP."

#. type: Bullet: '- '
#: ../src/guide/testing/overview.md
msgid "`Web` for requests sent through an HTTP server."
msgstr "`Web` para requisições enviadas por um servidor HTTP."

#. type: Bullet: '- '
#: ../src/guide/testing/overview.md
msgid "`Console` for console commands."
msgstr "`Console` para comandos de console."

#. type: Plain text
#: ../src/guide/testing/overview.md
msgid "The main files are:"
msgstr "Os arquivos principais são:"

#. type: Bullet: '- '
#: ../src/guide/testing/overview.md
msgid "`codeception.yml`."
msgstr "`codeception.yml`."

#. type: Bullet: '- '
#: ../src/guide/testing/overview.md
msgid "`tests/bootstrap.php`."
msgstr "`tests/bootstrap.php`."

#. type: Bullet: '- '
#: ../src/guide/testing/overview.md
msgid "`tests/Unit.suite.yml`."
msgstr "`tests/Unit.suite.yml`."

#. type: Bullet: '- '
#: ../src/guide/testing/overview.md
msgid "`tests/Functional.suite.yml`."
msgstr "`tests/Functional.suite.yml`."

#. type: Bullet: '- '
#: ../src/guide/testing/overview.md
msgid "`tests/Web.suite.yml`."
msgstr "`tests/Web.suite.yml`."

#. type: Bullet: '- '
#: ../src/guide/testing/overview.md
msgid "`tests/Console.suite.yml`."
msgstr "`tests/Console.suite.yml`."

#. type: Bullet: '- '
#: ../src/guide/testing/overview.md
msgid "`tests/Support/*Tester.php`."
msgstr "`tests/Support/*Tester.php`."

#. type: Title ##
#: ../src/guide/testing/overview.md
#, no-wrap
msgid "Run tests locally"
msgstr "Executar testes localmente"

#. type: Plain text
#: ../src/guide/testing/overview.md
msgid "Build actor classes after installing dependencies or changing a suite:"
msgstr "Gere as classes de actor depois de instalar as dependências ou alterar uma suíte:"

#. type: Plain text
#: ../src/guide/testing/overview.md
msgid "Run all tests:"
msgstr "Execute todos os testes:"

#. type: Plain text
#: ../src/guide/testing/overview.md
msgid "The template also defines a Composer script:"
msgstr "O template também define um script do Composer:"

#. type: Fenced code block (shell)
#: ../src/guide/testing/overview.md
#, no-wrap
msgid "APP_ENV=test composer test\n"
msgstr "APP_ENV=test composer test\n"

#. type: Plain text
#: ../src/guide/testing/overview.md
msgid "Run one suite:"
msgstr "Execute uma suíte:"

#. type: Fenced code block (shell)
#: ../src/guide/testing/overview.md
#, no-wrap
msgid ""
"APP_ENV=test vendor/bin/codecept run Unit\n"
"APP_ENV=test vendor/bin/codecept run Functional\n"
"APP_ENV=test vendor/bin/codecept run Web\n"
"APP_ENV=test vendor/bin/codecept run Console\n"
msgstr ""
"APP_ENV=test vendor/bin/codecept run Unit\n"
"APP_ENV=test vendor/bin/codecept run Functional\n"
"APP_ENV=test vendor/bin/codecept run Web\n"
"APP_ENV=test vendor/bin/codecept run Console\n"

#. type: Plain text
#: ../src/guide/testing/overview.md
msgid "Run one test class or method:"
msgstr "Execute uma classe ou um método de teste:"

#. type: Fenced code block (shell)
#: ../src/guide/testing/overview.md
#, no-wrap
msgid ""
"APP_ENV=test vendor/bin/codecept run Functional HomePageCest\n"
"APP_ENV=test vendor/bin/codecept run Functional HomePageCest:base\n"
msgstr ""
"APP_ENV=test vendor/bin/codecept run Functional HomePageCest\n"
"APP_ENV=test vendor/bin/codecept run Functional HomePageCest:base\n"

#. type: Plain text
#: ../src/guide/testing/overview.md
msgid "`APP_ENV=test` is required for local commands because `tests/bootstrap.php` prepares the application environment before tests run."
msgstr "`APP_ENV=test` é obrigatório nos comandos locais porque `tests/bootstrap.php` prepara o ambiente da aplicação antes da execução dos testes."

#. type: Title ##
#: ../src/guide/testing/overview.md
#, no-wrap
msgid "Run tests in Docker"
msgstr "Executar testes no Docker"

#. type: Plain text
#: ../src/guide/testing/overview.md
msgid "Build actor classes:"
msgstr "Gere as classes de actor:"

#. type: Fenced code block (shell)
#: ../src/guide/testing/overview.md
#, no-wrap
msgid "make test\n"
msgstr "make test\n"

#. type: Fenced code block (shell)
#: ../src/guide/testing/overview.md
#, no-wrap
msgid ""
"make test Unit\n"
"make test Functional\n"
"make test Web\n"
"make test Console\n"
msgstr ""
"make test Unit\n"
"make test Functional\n"
"make test Web\n"
"make test Console\n"

#. type: Plain text
#: ../src/guide/testing/overview.md
msgid "The Docker test environment reads `docker/test/.env`, where `APP_ENV=test` is already set."
msgstr "O ambiente de testes do Docker lê `docker/test/.env`, onde `APP_ENV=test` já está definido."

#. type: Title ##
#: ../src/guide/testing/overview.md
#, no-wrap
msgid "Choose a suite"
msgstr "Escolher uma suíte"

#. type: Plain text
#: ../src/guide/testing/overview.md
msgid "Start with unit tests for code that has no framework boundary: value objects, validators, domain services, and transformers."
msgstr "Comece com testes unitários para código que não tem fronteira com o framework: value objects, validadores, serviços de domínio e transformadores."

#. type: Plain text
#: ../src/guide/testing/overview.md
msgid "Use functional tests when code needs Yii configuration, dependency injection, routing, middleware, request handling, or template rendering."
msgstr "Use testes funcionais quando o código precisa da configuração do Yii, injeção de dependência, roteamento, middlewares, tratamento de requisições ou renderização de templates."

#. type: Plain text
#: ../src/guide/testing/overview.md
msgid "Use web tests for behavior that must go through an HTTP server: status codes, links, redirects, cookies, and rendered pages as seen by a client."
msgstr "Use testes web para comportamentos que precisam passar por um servidor HTTP: códigos de status, links, redirecionamentos, cookies e páginas renderizadas como o cliente as vê."

#. type: Plain text
#: ../src/guide/testing/overview.md
msgid "Use console tests for commands in `src/Console`."
msgstr "Use testes de console para os comandos em `src/Console`."

#. type: Plain text
#: ../src/guide/testing/overview.md
msgid "Run static analysis in CI and before changing shared contracts."
msgstr "Execute a análise estática no CI e antes de alterar contratos compartilhados."
