#. type: Plain text
#: ../src/cookbook/configuring-xdebug.md ../src/guide/testing/end-to-end.md ../src/guide/testing/environment-setup.md ../src/guide/testing/quality-tools.md
msgid "With Docker:"
msgstr "Com Docker:"

#. type: Title #
#: ../src/guide/testing/end-to-end.md
#, no-wrap
msgid "End-to-end tests"
msgstr "Testes end-to-end"

#. type: Plain text
#: ../src/guide/testing/end-to-end.md
msgid "The Yii application template uses the `Web` Codeception suite for tests that go through an HTTP server. These tests live in `tests/Web` and use `App\\Tests\\Support\\WebTester`."
msgstr "O template de aplicação Yii usa a suíte `Web` do Codeception para testes que passam por um servidor HTTP. Esses testes ficam em `tests/Web` e usam `App\\Tests\\Support\\WebTester`."

#. type: Plain text
#: ../src/guide/testing/end-to-end.md
msgid "Use web tests for user-visible HTTP behavior: pages, links, forms, redirects, cookies, and error pages."
msgstr "Use testes web para o comportamento HTTP visível ao usuário: páginas, links, formulários, redirecionamentos, cookies e páginas de erro."

#. type: Title ##
#: ../src/guide/testing/end-to-end.md
#, no-wrap
msgid "Web suite"
msgstr "Suíte Web"

#. type: Plain text
#: ../src/guide/testing/end-to-end.md
msgid "The template configures `tests/Web.suite.yml` like this:"
msgstr "O template configura `tests/Web.suite.yml` assim:"

#. type: Fenced code block (yaml)
#: ../src/guide/testing/end-to-end.md ../src/guide/testing/environment-setup.md
#, no-wrap
msgid ""
"actor: WebTester\n"
"extensions:\n"
"  enabled:\n"
"    - Codeception\\Extension\\RunProcess:\n"
"        0: composer serve\n"
"        sleep: 3\n"
"modules:\n"
"  enabled:\n"
"    - PhpBrowser:\n"
"        url: http://127.0.0.1:8080\n"
msgstr ""
"actor: WebTester\n"
"extensions:\n"
"  enabled:\n"
"    - Codeception\\Extension\\RunProcess:\n"
"        0: composer serve\n"
"        sleep: 3\n"
"modules:\n"
"  enabled:\n"
"    - PhpBrowser:\n"
"        url: http://127.0.0.1:8080\n"

#. type: Plain text
#: ../src/guide/testing/end-to-end.md
msgid "`RunProcess` starts the application with the Composer `serve` script. `PhpBrowser` sends HTTP requests to the server."
msgstr "`RunProcess` inicia a aplicação com o script `serve` do Composer. `PhpBrowser` envia requisições HTTP ao servidor."

#. type: Title ##
#: ../src/guide/testing/end-to-end.md ../src/guide/testing/functional.md
#, no-wrap
msgid "Test a page"
msgstr "Testar uma página"

#. type: Plain text
#: ../src/guide/testing/end-to-end.md
msgid "The template includes `tests/Web/HomePageCest.php`:"
msgstr "O template inclui `tests/Web/HomePageCest.php`:"

#. type: Fenced code block (php)
#: ../src/guide/testing/end-to-end.md
#, no-wrap
msgid ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"namespace App\\Tests\\Web;\n"
"\n"
"use App\\Tests\\Support\\WebTester;\n"
"\n"
"final class HomePageCest\n"
"{\n"
"    public function base(WebTester $I): void\n"
"    {\n"
"        $I->wantTo('home page works.');\n"
"        $I->amOnPage('/');\n"
"        $I->expectTo('see page home.');\n"
"        $I->see('Hello!');\n"
"    }\n"
"}\n"
msgstr ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"namespace App\\Tests\\Web;\n"
"\n"
"use App\\Tests\\Support\\WebTester;\n"
"\n"
"final class HomePageCest\n"
"{\n"
"    public function base(WebTester $I): void\n"
"    {\n"
"        $I->wantTo('home page works.');\n"
"        $I->amOnPage('/');\n"
"        $I->expectTo('see page home.');\n"
"        $I->see('Hello!');\n"
"    }\n"
"}\n"

#. type: Plain text
#: ../src/guide/testing/end-to-end.md
msgid "Run the web suite locally:"
msgstr "Execute a suíte web localmente:"

#. type: Fenced code block (shell)
#: ../src/guide/testing/end-to-end.md
#, no-wrap
msgid "APP_ENV=test vendor/bin/codecept run Web\n"
msgstr "APP_ENV=test vendor/bin/codecept run Web\n"

#. type: Plain text
#: ../src/guide/testing/end-to-end.md ../src/guide/testing/unit.md
msgid "Run only this test:"
msgstr "Execute apenas este teste:"

#. type: Fenced code block (shell)
#: ../src/guide/testing/end-to-end.md
#, no-wrap
msgid "APP_ENV=test vendor/bin/codecept run Web HomePageCest\n"
msgstr "APP_ENV=test vendor/bin/codecept run Web HomePageCest\n"

#. type: Fenced code block (shell)
#: ../src/guide/testing/end-to-end.md
#, no-wrap
msgid "make test Web\n"
msgstr "make test Web\n"

#. type: Title ##
#: ../src/guide/testing/end-to-end.md
#, no-wrap
msgid "Test links and error pages"
msgstr "Testar links e páginas de erro"

#. type: Plain text
#: ../src/guide/testing/end-to-end.md
msgid "Use the same actor methods for navigation and response assertions:"
msgstr "Use os mesmos métodos do actor para navegação e asserções sobre a resposta:"

#. type: Fenced code block (php)
#: ../src/guide/testing/end-to-end.md
#, no-wrap
msgid ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"namespace App\\Tests\\Web;\n"
"\n"
"use App\\Tests\\Support\\WebTester;\n"
"\n"
"final class NotFoundHandlerCest\n"
"{\n"
"    public function nonExistentPage(WebTester $I): void\n"
"    {\n"
"        $I->wantTo('see 404 page.');\n"
"        $I->amOnPage('/non-existent-page');\n"
"        $I->canSeeResponseCodeIs(404);\n"
"        $I->see('404');\n"
"        $I->see('The page /non-existent-page not found.');\n"
"    }\n"
"}\n"
msgstr ""
"<?php\n"
"\n"
"declare(strict_types=1);\n"
"\n"
"namespace App\\Tests\\Web;\n"
"\n"
"use App\\Tests\\Support\\WebTester;\n"
"\n"
"final class NotFoundHandlerCest\n"
"{\n"
"    public function nonExistentPage(WebTester $I): void\n"
"    {\n"
"        $I->wantTo('see 404 page.');\n"
"        $I->amOnPage('/non-existent-page');\n"
"        $I->canSeeResponseCodeIs(404);\n"
"        $I->see('404');\n"
"        $I->see('The page /non-existent-page not found.');\n"
"    }\n"
"}\n"

#. type: Title ##
#: ../src/guide/testing/end-to-end.md
#, no-wrap
msgid "Smoke test with curl"
msgstr "Smoke test com curl"

#. type: Plain text
#: ../src/guide/testing/end-to-end.md
msgid "For a deployment smoke test, start the application and check one URL:"
msgstr "Para um smoke test de deploy, inicie a aplicação e verifique uma URL:"

#. type: Fenced code block (shell)
#: ../src/guide/testing/end-to-end.md
#, no-wrap
msgid "APP_ENV=test ./yii serve --port=8080\n"
msgstr "APP_ENV=test ./yii serve --port=8080\n"

#. type: Plain text
#: ../src/guide/testing/end-to-end.md
msgid "In another terminal:"
msgstr "Em outro terminal:"

#. type: Fenced code block (shell)
#: ../src/guide/testing/end-to-end.md
#, no-wrap
msgid ""
"curl -fsS http://127.0.0.1:8080/ > /tmp/home.html\n"
"grep -q \"Hello!\" /tmp/home.html\n"
msgstr ""
"curl -fsS http://127.0.0.1:8080/ > /tmp/home.html\n"
"grep -q \"Hello!\" /tmp/home.html\n"

#. type: Title ##
#: ../src/guide/testing/end-to-end.md ../src/guide/testing/functional.md
#, no-wrap
msgid "Reset state"
msgstr "Redefinir o estado"

#. type: Plain text
#: ../src/guide/testing/end-to-end.md
msgid "Web tests use real infrastructure, so reset state before each scenario:"
msgstr "Testes web usam infraestrutura real, então redefina o estado antes de cada cenário:"

#. type: Bullet: '- '
#: ../src/guide/testing/end-to-end.md
msgid "Load only the records required by the scenario."
msgstr "Carregue apenas os registros exigidos pelo cenário."

#. type: Bullet: '- '
#: ../src/guide/testing/end-to-end.md
msgid "Clear session and cookie storage."
msgstr "Limpe o armazenamento de sessão e de cookies."

#. type: Bullet: '- '
#: ../src/guide/testing/end-to-end.md
msgid "Clear generated files and outgoing messages."
msgstr "Limpe arquivos gerados e mensagens de saída."

#. type: Bullet: '- '
#: ../src/guide/testing/end-to-end.md
msgid "Stop background workers, or make their effects deterministic."
msgstr "Pare os workers em segundo plano ou torne seus efeitos determinísticos."

#. type: Plain text
#: ../src/guide/testing/end-to-end.md
msgid "If the scenario changes a database, reset it in the Cest `_before()` hook or in a project-specific helper:"
msgstr "Se o cenário altera um banco de dados, redefina-o no hook `_before()` do Cest ou em um helper específico do projeto:"

#. type: Fenced code block (php)
#: ../src/guide/testing/end-to-end.md
#, no-wrap
msgid ""
"public function _before(WebTester $I): void\n"
"{\n"
"    // Reset database tables, files, queues, and outgoing messages.\n"
"}\n"
msgstr ""
"public function _before(WebTester $I): void\n"
"{\n"
"    // Redefina tabelas do banco de dados, arquivos, filas e mensagens de saída.\n"
"}\n"
