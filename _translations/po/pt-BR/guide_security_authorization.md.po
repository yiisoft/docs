#. type: Plain text
#: ../src/guide/security/authorization.md
msgid "Before we set off to define authorization data and perform access checking, you need to configure the `Yiisoft\\Access\\AccessCheckerInterface` in dependency container:"
msgstr "Antes de definir os dados de autorização e fazer verificações de acesso, você precisa configurar a `Yiisoft\\Access\\AccessCheckerInterface` no container de dependências:"

#. type: Fenced code block (php)
#: ../src/guide/security/authorization.md
#, no-wrap
msgid ""
"use Yiisoft\\Rbac\\ItemsStorageInterface;\n"
"use Yiisoft\\Rbac\\AssignmentsStorageInterface;\n"
"use Yiisoft\\Rbac\\ManagerInterface;\n"
"use Yiisoft\\Rbac\\Php\\ItemsStorage;\n"
"use Yiisoft\\Rbac\\Php\\AssignmentsStorage;\n"
"use Yiisoft\\Access\\AccessCheckerInterface;\n"
"use Yiisoft\\User\\CurrentUser;\n"
"\n"
"return [\n"
"    // ...\n"
"    ItemsStorageInterface::class => [\n"
"        'class' => ItemsStorage::class,\n"
"        '__construct()' => [\n"
"            'filePath' => $params['rbacItemsStorageFilePath']\n"
"        ]\n"
"    ],\n"
"    AssignmentsStorageInterface::class => [\n"
"        'class' => AssignmentsStorage::class,\n"
"        '__construct()' => [\n"
"            'filePath' => $params['rbacAssignmentsStorageFilePath']\n"
"        ]\n"
"    ],\n"
"    AccessCheckerInterface::class => ManagerInterface::class,\n"
"\n"
"    CurrentUser::class => [\n"
"        'withAccessChecker()' => [Reference::to(AccessCheckerInterface::class)]\n"
"    ],\n"
"];\n"
msgstr ""
"use Yiisoft\\Rbac\\ItemsStorageInterface;\n"
"use Yiisoft\\Rbac\\AssignmentsStorageInterface;\n"
"use Yiisoft\\Rbac\\ManagerInterface;\n"
"use Yiisoft\\Rbac\\Php\\ItemsStorage;\n"
"use Yiisoft\\Rbac\\Php\\AssignmentsStorage;\n"
"use Yiisoft\\Access\\AccessCheckerInterface;\n"
"use Yiisoft\\User\\CurrentUser;\n"
"\n"
"return [\n"
"    // ...\n"
"    ItemsStorageInterface::class => [\n"
"        'class' => ItemsStorage::class,\n"
"        '__construct()' => [\n"
"            'filePath' => $params['rbacItemsStorageFilePath']\n"
"        ]\n"
"    ],\n"
"    AssignmentsStorageInterface::class => [\n"
"        'class' => AssignmentsStorage::class,\n"
"        '__construct()' => [\n"
"            'filePath' => $params['rbacAssignmentsStorageFilePath']\n"
"        ]\n"
"    ],\n"
"    AccessCheckerInterface::class => ManagerInterface::class,\n"
"\n"
"    CurrentUser::class => [\n"
"        'withAccessChecker()' => [Reference::to(AccessCheckerInterface::class)]\n"
"    ],\n"
"];\n"

#. type: Plain text
#: ../src/guide/security/authorization.md
msgid "`Yiisoft\\Rbac\\Manager` uses PHP script files to store authorization data.  Make sure the directory and all the files in it are writable by the Web server process if you want to change permission hierarchy online."
msgstr "O `Yiisoft\\Rbac\\Manager` usa arquivos de script PHP para armazenar os dados de autorização.  Garanta que o diretório e todos os arquivos dentro dele tenham permissão de escrita para o processo do servidor web, se você quiser alterar a hierarquia de permissões em tempo de execução."

