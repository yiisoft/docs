#. type: Title ##
#: ../src/guide/security/authorization.md
#, no-wrap
msgid "Implementing your own access checker"
msgstr "Implementando seu próprio verificador de acesso"

#. type: Plain text
#: ../src/guide/security/authorization.md
msgid "If RBAC doesn't suit your needs, you can implement your own access checker without changing the application code:"
msgstr "Se o RBAC não atende às suas necessidades, você pode implementar seu próprio verificador de acesso sem alterar o código da aplicação:"

#. type: Fenced code block (php)
#: ../src/guide/security/authorization.md
#, no-wrap
msgid ""
"namespace App\\User;\n"
"\n"
"use \\Yiisoft\\Access\\AccessCheckerInterface;\n"
"\n"
"final readonly class AccessChecker implements AccessCheckerInterface\n"
"{\n"
"    private const PERMISSIONS = [\n"
"        [\n"
"            1 => ['editPost'],\n"
"            42 => ['editPost', 'deletePost'],\n"
"        ],\n"
"    ];\n"
"\n"
"    public function userHasPermission($userId, string $permissionName, array $parameters = []) : bool\n"
"    {\n"
"        if (!array_key_exists($userId, self::PERMISSIONS)) {\n"
"            return false;\n"
"        }\n"
"\n"
"        return in_array($permissionName, self::PERMISSIONS[$userId], true); \n"
"    }\n"
"}\n"
msgstr ""
"namespace App\\User;\n"
"\n"
"use \\Yiisoft\\Access\\AccessCheckerInterface;\n"
"\n"
"final readonly class AccessChecker implements AccessCheckerInterface\n"
"{\n"
"    private const PERMISSIONS = [\n"
"        [\n"
"            1 => ['editPost'],\n"
"            42 => ['editPost', 'deletePost'],\n"
"        ],\n"
"    ];\n"
"\n"
"    public function userHasPermission($userId, string $permissionName, array $parameters = []) : bool\n"
"    {\n"
"        if (!array_key_exists($userId, self::PERMISSIONS)) {\n"
"            return false;\n"
"        }\n"
"\n"
"        return in_array($permissionName, self::PERMISSIONS[$userId], true); \n"
"    }\n"
"}\n"
