#. type: Plain text
#: ../src/guide/security/authorization.md
#, no-wrap
msgid "TODO: update when signup implemented in demo / template.\n"
msgstr "TODO: atualizar quando o cadastro for implementado no demo / template.\n"

#. type: Plain text
#: ../src/guide/security/authorization.md
msgid "The author can create a post, admin can update the post and do everything the author can."
msgstr "O autor pode criar um post, o admin pode atualizar o post e fazer tudo o que o autor pode."

#. type: Plain text
#: ../src/guide/security/authorization.md
msgid "If your application allows user signup, you need to assign roles to these new users at once.  For example, in order for all signed-up users to become authors in your advanced project template, you need to change `frontend\\models\\SignupForm::signup()` as follows:"
msgstr "Se sua aplicação permite o cadastro de usuários, você precisa atribuir papéis a esses novos usuários imediatamente.  Por exemplo, para que todos os usuários cadastrados se tornem autores no seu template de projeto avançado, você precisa alterar `frontend\\models\\SignupForm::signup()` da seguinte forma:"

#. type: Fenced code block (php)
#: ../src/guide/security/authorization.md
#, no-wrap
msgid ""
"public function signup()\n"
"{\n"
"    if ($this->validate()) {\n"
"        $user = new User();\n"
"        $user->username = $this->username;\n"
"        $user->email = $this->email;\n"
"        $user->setPassword($this->password);\n"
"        $user->generateAuthKey();\n"
"        $user->save(false);\n"
"\n"
"        // the following three lines were added:\n"
"        $authorRole = $this->manager->getRole('author');\n"
"        if ($authorRole !== null) {\n"
"            $this->manager->assign($authorRole->getName(), $user->getId());\n"
"        }\n"
"\n"
"        return $user;\n"
"    }\n"
"\n"
"    return null;\n"
"}\n"
msgstr ""
"public function signup()\n"
"{\n"
"    if ($this->validate()) {\n"
"        $user = new User();\n"
"        $user->username = $this->username;\n"
"        $user->email = $this->email;\n"
"        $user->setPassword($this->password);\n"
"        $user->generateAuthKey();\n"
"        $user->save(false);\n"
"\n"
"        // as três linhas a seguir foram adicionadas:\n"
"        $authorRole = $this->manager->getRole('author');\n"
"        if ($authorRole !== null) {\n"
"            $this->manager->assign($authorRole->getName(), $user->getId());\n"
"        }\n"
"\n"
"        return $user;\n"
"    }\n"
"\n"
"    return null;\n"
"}\n"

#. type: Plain text
#: ../src/guide/security/authorization.md
msgid "For applications that require complex access control with dynamically updated authorization data (such as an admin panel), you many need to develop special user interfaces using APIs offered by `Yiisoft\\Rbac\\Manager`."
msgstr "Para aplicações que exigem controle de acesso complexo com dados de autorização atualizados dinamicamente (como um painel administrativo), talvez você precise desenvolver interfaces de usuário específicas usando as APIs oferecidas por `Yiisoft\\Rbac\\Manager`."

#. type: Title ###
#: ../src/guide/security/authorization.md
#, no-wrap
msgid "Using rules"
msgstr "Usando regras"

#. type: Plain text
#: ../src/guide/security/authorization.md
msgid "As aforementioned, rules add extra constraint to roles and permissions.  A rule is a class extending from `\\Yiisoft\\Rbac\\Rule`.  It must implement the `execute()` method.  In the hierarchy you've created before, the author can't edit his own post.  Let's fix it. First, you need a rule to verify that the user is the post author:"
msgstr "Como mencionado, regras adicionam restrições extras a papéis e permissões.  Uma regra é uma classe que estende `\\Yiisoft\\Rbac\\Rule`.  Ela deve implementar o método `execute()`.  Na hierarquia que você criou antes, o autor não pode editar o próprio post.  Vamos corrigir isso. Primeiro, você precisa de uma regra para verificar se o usuário é o autor do post:"

#. type: Fenced code block (php)
#: ../src/guide/security/authorization.md
#, no-wrap
msgid ""
"namespace App\\User\\Rbac;\n"
"\n"
"use Yiisoft\\Rbac\\Item;\n"
"use Yiisoft\\Rbac\\RuleContext;\n"
"use Yiisoft\\Rbac\\RuleInterface;\n"
"\n"
"/**\n"
" * Checks if the authorID matches user passed via params.\n"
" */\n"
"final readonly class AuthorRule implements RuleInterface\n"
"{\n"
"    public function execute(?string $userId, Item $item, RuleContext $context): bool\n"
"    {\n"
"        $post = $context->getParameterValue('post');\n"
"        return $post !== null && $post->getAuthorId() == $userId;\n"
"    }\n"
"}\n"
msgstr ""
"namespace App\\User\\Rbac;\n"
"\n"
"use Yiisoft\\Rbac\\Item;\n"
"use Yiisoft\\Rbac\\RuleContext;\n"
"use Yiisoft\\Rbac\\RuleInterface;\n"
"\n"
"/**\n"
" * Checks if the authorID matches user passed via params.\n"
" */\n"
"final readonly class AuthorRule implements RuleInterface\n"
"{\n"
"    public function execute(?string $userId, Item $item, RuleContext $context): bool\n"
"    {\n"
"        $post = $context->getParameterValue('post');\n"
"        return $post !== null && $post->getAuthorId() == $userId;\n"
"    }\n"
"}\n"

#. type: Plain text
#: ../src/guide/security/authorization.md
msgid "The rule checks if user created the `post`. Create a special permission `updateOwnPost` in the command you've used before:"
msgstr "A regra verifica se o usuário criou o `post`. Crie uma permissão especial `updateOwnPost` no comando que você usou antes:"

#. type: Fenced code block (php)
#: ../src/guide/security/authorization.md
#, no-wrap
msgid ""
"use Yiisoft\\Rbac\\Permission;\n"
"use Yiisoft\\Rbac\\ManagerInterface;\n"
"\n"
"// add the \"updateOwnPost\" permission and associate the rule with it.\n"
"$updateOwnPost = (new Permission('updateOwnPost'))\n"
"    ->withDescription('Update own post')\n"
"    ->withRuleName(AuthorRule::class);\n"
"$this->manager->addPermission($updateOwnPost);\n"
"\n"
"// \"updateOwnPost\" will be used from \"updatePost\"\n"
"$this->manager->addChild($updateOwnPost->getName(), $updatePost->getName());\n"
"\n"
"// allow \"author\" to update their own posts\n"
"$this->manager->addChild($authorRole->getName(), $updateOwnPost->getName());\n"
"\n"
"// Remove this line since we don't want the AuthorRule to be applied to the 'admin' role\n"
"$this->manager->addChild('admin', 'author');\n"
msgstr ""
"use Yiisoft\\Rbac\\Permission;\n"
"use Yiisoft\\Rbac\\ManagerInterface;\n"
"\n"
"// adiciona a permissão \"updateOwnPost\" e associa a regra a ela.\n"
"$updateOwnPost = (new Permission('updateOwnPost'))\n"
"    ->withDescription('Update own post')\n"
"    ->withRuleName(AuthorRule::class);\n"
"$this->manager->addPermission($updateOwnPost);\n"
"\n"
"// \"updateOwnPost\" será usada a partir de \"updatePost\"\n"
"$this->manager->addChild($updateOwnPost->getName(), $updatePost->getName());\n"
"\n"
"// permite que \"author\" atualize os próprios posts\n"
"$this->manager->addChild($authorRole->getName(), $updateOwnPost->getName());\n"
"\n"
"// Remova esta linha, já que não queremos que a AuthorRule seja aplicada ao papel 'admin'\n"
"$this->manager->addChild('admin', 'author');\n"

#. type: Plain text
#: ../src/guide/security/authorization.md
msgid "Now you've got the following hierarchy:"
msgstr "Agora você tem a seguinte hierarquia:"

#. type: Plain text
#: ../src/guide/security/authorization.md
msgid "![RBAC hierarchy with a rule](/images/guide/security/rbac-hierarchy-2.svg \"RBAC hierarchy with a rule\")"
msgstr "![Hierarquia RBAC com uma regra](/images/guide/security/rbac-hierarchy-2.svg \"Hierarquia RBAC com uma regra\")"

#. type: Title ###
#: ../src/guide/security/authorization.md
#, no-wrap
msgid "Access check"
msgstr "Verificação de acesso"

#. type: Plain text
#: ../src/guide/security/authorization.md
msgid "The check is done similarly to how it was done in the first section of this guide:"
msgstr "A verificação é feita de forma semelhante à da primeira seção deste guia:"

#. type: Fenced code block (php)
#: ../src/guide/security/authorization.md
#, no-wrap
msgid ""
"namespace App\\Blog\\Post;\n"
"\n"
"use Yiisoft\\User\\CurrentUser;\n"
"use Yiisoft\\Router\\HydratorAttribute\\RouteArgument;\n"
"use Psr\\Http\\Message\\ResponseInterface;\n"
"\n"
"final readonly class PostController\n"
"{\n"
"    public function __construct(\n"
"        private PostRepositoryInterface $postRepository,\n"
"        private CurrentUser $user\n"
"    )\n"
"    {\n"
"    }\n"
"\n"
"    public function update(#[RouteArgument('id')] int $id): ResponseInterface\n"
"    {\n"
"        $post = $this->postRepository->findByPK($id);\n"
"        if ($post === null) {\n"
"            // respond with 404\n"
"        }\n"
"\n"
"        if (!$this->canCurrentUserUpdatePost($post)) {\n"
"            // respond with 403\n"
"        }\n"
"\n"
"        // continue with updating the post\n"
"    }\n"
"\n"
"    private function canCurrentUserUpdatePost(Post $post): bool\n"
"    {\n"
"        return $this->user->can('updatePost', ['post' => $post]);\n"
"    }\n"
"}\n"
msgstr ""
"namespace App\\Blog\\Post;\n"
"\n"
"use Yiisoft\\User\\CurrentUser;\n"
"use Yiisoft\\Router\\HydratorAttribute\\RouteArgument;\n"
"use Psr\\Http\\Message\\ResponseInterface;\n"
"\n"
"final readonly class PostController\n"
"{\n"
"    public function __construct(\n"
"        private PostRepositoryInterface $postRepository,\n"
"        private CurrentUser $user\n"
"    )\n"
"    {\n"
"    }\n"
"\n"
"    public function update(#[RouteArgument('id')] int $id): ResponseInterface\n"
"    {\n"
"        $post = $this->postRepository->findByPK($id);\n"
"        if ($post === null) {\n"
"            // responda com 404\n"
"        }\n"
"\n"
"        if (!$this->canCurrentUserUpdatePost($post)) {\n"
"            // responda com 403\n"
"        }\n"
"\n"
"        // continue com a atualização do post\n"
"    }\n"
"\n"
"    private function canCurrentUserUpdatePost(Post $post): bool\n"
"    {\n"
"        return $this->user->can('updatePost', ['post' => $post]);\n"
"    }\n"
"}\n"

