#. type: Title ##
#: ../src/en/guide/concept/immutability.md ../src/en/internals/017-tags.md ../src/en/internals/018-widgets.md
#, no-wrap
msgid "Immutability"
msgstr "Imutabilidade"

#. type: Plain text
#: ../src/en/guide/concept/immutability.md
msgid "Immutability means an object's state cannot change after it has been created.  Instead of modifying an instance, you create a new instance with the desired changes.  This approach is common for value objects such as Money, IDs, and DTOs. It helps to avoid accidental side effects: methods cannot silently change shared state, which makes code easier to reason about."
msgstr "Imutabilidade significa que o estado de um objeto não pode mudar depois que ele é criado.  Em vez de modificar uma instância, você cria uma nova instância com as mudanças desejadas.  Essa abordagem é comum em value objects como Money, IDs e DTOs. Ela ajuda a evitar efeitos colaterais acidentais: os métodos não conseguem alterar silenciosamente um estado compartilhado, o que torna o código mais fácil de entender."

#. type: Title ##
#: ../src/en/guide/concept/immutability.md
#, no-wrap
msgid "Mutable pitfalls (what we avoid)"
msgstr "Armadilhas da mutabilidade (o que evitamos)"

#. type: Fenced code block (php)
#: ../src/en/guide/concept/immutability.md
#, no-wrap
msgid ""
"// A shared base query built once and reused:\n"
"$base = Post::find()->where(['status' => Post::STATUS_PUBLISHED]);\n"
"\n"
"// Somewhere deep in the code we only need one post:\n"
"$one = $base->limit(1)->one(); // mutates the underlying builder (sticky limit!)\n"
"\n"
"// Later we reuse the same $base expecting a full list:\n"
"$list = $base->orderBy(['created_at' => SORT_DESC])->all();\n"
"// Oops: still limited to 1 because the previous limit(1) modified $base.\n"
msgstr ""
"// Uma query base compartilhada, montada uma vez e reutilizada:\n"
"$base = Post::find()->where(['status' => Post::STATUS_PUBLISHED]);\n"
"\n"
"// Em algum lugar profundo do código, precisamos de um só post:\n"
"$one = $base->limit(1)->one(); // altera o builder subjacente (o limit fica grudado!)\n"
"\n"
"// Depois reutilizamos o mesmo $base esperando a lista completa:\n"
"$list = $base->orderBy(['created_at' => SORT_DESC])->all();\n"
"// Ops: continua limitado a 1, porque o limit(1) anterior modificou $base.\n"

#. type: Title ##
#: ../src/en/guide/concept/immutability.md
#, no-wrap
msgid "Creating an immutable object in PHP"
msgstr "Criando um objeto imutável em PHP"

#. type: Plain text
#: ../src/en/guide/concept/immutability.md
msgid "There is no direct way to modify an instance, but you can use clone to create a new instance with the desired changes.  That is what `with*` methods do."
msgstr "Não há como modificar uma instância diretamente, mas você pode usar clone para criar uma nova instância com as mudanças desejadas.  É isso que os métodos `with*` fazem."

#. type: Fenced code block (php)
#: ../src/en/guide/concept/immutability.md
#, no-wrap
msgid ""
"final class Money\n"
"{\n"
"    public function __construct(\n"
"        private int $amount,\n"
"        private string $currency,\n"
"    ) {\n"
"        $this->validateAmount($amount);\n"
"        $this->validateCurrency($currency);\n"
"    }\n"
"    \n"
"    private function validateAmount(string $amount) \n"
"    {\n"
"     if ($amount < 0) {\n"
"            throw new InvalidArgumentException('Amount must be positive.');\n"
"        }\n"
"    }\n"
"    \n"
"    private function validateCurrency(string $currency)\n"
"    {\n"
"        if (!in_array($currency, ['USD', 'EUR'])) {\n"
"            throw new InvalidArgumentException('Invalid currency. Only USD and EUR are supported.');\n"
"        }\n"
"    } \n"
"\n"
"    public function withAmount(int $amount): self\n"
"    {\n"
"        $this->validateAmount($amount);\n"
"    \n"
"        if ($amount === $this->amount) {\n"
"            return $this;\n"
"        }\n"
"    \n"
"        $clone = clone $this;\n"
"        $clone->amount = $amount;\n"
"        return $clone;\n"
"    }\n"
"    \n"
"    public function withCurrency(string $currency): self\n"
"    {\n"
"        $this->validateCurrency($currency);\n"
"    \n"
"        if ($currency === $this->currency) {\n"
"            return $this;\n"
"        }\n"
"    \n"
"        $clone = clone $this;\n"
"        $clone->currency = $currency;\n"
"        return $clone;\n"
"    }\n"
"    \n"
"    public function amount(): int \n"
"    {\n"
"        return $this->amount;\n"
"    }\n"
"    \n"
"    public function currency(): string \n"
"    {\n"
"        return $this->currency;\n"
"    }\n"
"\n"
"    public function add(self $money): self\n"
"    {\n"
"        if ($money->currency !== $this->currency) {\n"
"            throw new InvalidArgumentException('Currency mismatch. Cannot add money of different currency.');\n"
"        }\n"
"        return $this->withAmount($this->amount + $money->amount);\n"
"    }\n"
"}\n"
"\n"
"$price = new Money(1000, 'USD');\n"
"$discounted = $price->withAmount(800);\n"
"// $price is still 1000 USD, $discounted is 800 USD\n"
msgstr ""
"final class Money\n"
"{\n"
"    public function __construct(\n"
"        private int $amount,\n"
"        private string $currency,\n"
"    ) {\n"
"        $this->validateAmount($amount);\n"
"        $this->validateCurrency($currency);\n"
"    }\n"
"    \n"
"    private function validateAmount(string $amount) \n"
"    {\n"
"     if ($amount < 0) {\n"
"            throw new InvalidArgumentException('Amount must be positive.');\n"
"        }\n"
"    }\n"
"    \n"
"    private function validateCurrency(string $currency)\n"
"    {\n"
"        if (!in_array($currency, ['USD', 'EUR'])) {\n"
"            throw new InvalidArgumentException('Invalid currency. Only USD and EUR are supported.');\n"
"        }\n"
"    } \n"
"\n"
"    public function withAmount(int $amount): self\n"
"    {\n"
"        $this->validateAmount($amount);\n"
"    \n"
"        if ($amount === $this->amount) {\n"
"            return $this;\n"
"        }\n"
"    \n"
"        $clone = clone $this;\n"
"        $clone->amount = $amount;\n"
"        return $clone;\n"
"    }\n"
"    \n"
"    public function withCurrency(string $currency): self\n"
"    {\n"
"        $this->validateCurrency($currency);\n"
"    \n"
"        if ($currency === $this->currency) {\n"
"            return $this;\n"
"        }\n"
"    \n"
"        $clone = clone $this;\n"
"        $clone->currency = $currency;\n"
"        return $clone;\n"
"    }\n"
"    \n"
"    public function amount(): int \n"
"    {\n"
"        return $this->amount;\n"
"    }\n"
"    \n"
"    public function currency(): string \n"
"    {\n"
"        return $this->currency;\n"
"    }\n"
"\n"
"    public function add(self $money): self\n"
"    {\n"
"        if ($money->currency !== $this->currency) {\n"
"            throw new InvalidArgumentException('Currency mismatch. Cannot add money of different currency.');\n"
"        }\n"
"        return $this->withAmount($this->amount + $money->amount);\n"
"    }\n"
"}\n"
"\n"
"$price = new Money(1000, 'USD');\n"
"$discounted = $price->withAmount(800);\n"
"// $price continua 1000 USD, $discounted é 800 USD\n"

#. type: Bullet: '- '
#: ../src/en/guide/concept/immutability.md
msgid "We mark the class `final` to prevent subclass mutations; alternatively, design for extension carefully."
msgstr "Marcamos a classe como `final` para impedir mutações por subclasses; como alternativa, projete a extensão com cuidado."

#. type: Bullet: '- '
#: ../src/en/guide/concept/immutability.md
msgid "Validate in the constructor and `with*` methods so every instance is always valid."
msgstr "Valide no construtor e nos métodos `with*`, para que toda instância seja sempre válida."

#. type: Plain text
#: ../src/en/guide/concept/immutability.md
#, no-wrap
msgid ""
"> [!TIP]\n"
"> If you define a simple DTO, you can use modern PHP `readonly` and leave properties `public`. The `readonly` keyword\n"
"> would ensure that the properties cannot be modified after the object is created.\n"
msgstr ""
"> [!TIP]\n"
"> Se você define um DTO simples, pode usar o `readonly` do PHP moderno e deixar as propriedades `public`. A palavra-chave `readonly`\n"
"> garante que as propriedades não possam ser modificadas depois que o objeto é criado.\n"

#. type: Title ##
#: ../src/en/guide/concept/immutability.md
#, no-wrap
msgid "Using clone (and why it is inexpensive)"
msgstr "Usando clone (e por que é barato)"

#. type: Plain text
#: ../src/en/guide/concept/immutability.md
msgid "PHP's clone performs a shallow copy of the object. For immutable value objects that contain only scalars or other immutable objects, shallow cloning is enough and fast. In modern PHP, cloning small value objects is inexpensive in both time and memory."
msgstr "O clone do PHP faz uma cópia rasa do objeto. Para value objects imutáveis que contêm apenas escalares ou outros objetos imutáveis, a clonagem rasa é suficiente e rápida. No PHP moderno, clonar value objects pequenos é barato em tempo e em memória."

#. type: Plain text
#: ../src/en/guide/concept/immutability.md
msgid "If your object holds mutable sub-objects that must also be copied, implement `__clone` to deep-clone them:"
msgstr "Se o seu objeto guarda subobjetos mutáveis que também precisam ser copiados, implemente `__clone` para fazer a clonagem profunda deles:"

#. type: Fenced code block (php)
#: ../src/en/guide/concept/immutability.md
#, no-wrap
msgid ""
"final class Order\n"
"{\n"
"    public function __construct(\n"
"        private Money $total\n"
"    ) {}\n"
"    \n"
"    public function total(): Money \n"
"    {\n"
"        return $this->total;\n"
"    }\n"
"\n"
"    public function __clone(): void\n"
"    {\n"
"        // Money is immutable in our example, so a deep clone is not required.\n"
"        // If it were mutable, you could do: $this->total = clone $this->total;\n"
"    }\n"
"\n"
"    public function withTotal(Money $total): self\n"
"    {\n"
"        $clone = clone $this;\n"
"        $clone->total = $total;\n"
"        return $clone;\n"
"    }\n"
"}\n"
msgstr ""
"final class Order\n"
"{\n"
"    public function __construct(\n"
"        private Money $total\n"
"    ) {}\n"
"    \n"
"    public function total(): Money \n"
"    {\n"
"        return $this->total;\n"
"    }\n"
"\n"
"    public function __clone(): void\n"
"    {\n"
"        // Money é imutável no nosso exemplo, então a clonagem profunda não é necessária.\n"
"        // Se fosse mutável, você poderia fazer: $this->total = clone $this->total;\n"
"    }\n"
"\n"
"    public function withTotal(Money $total): self\n"
"    {\n"
"        $clone = clone $this;\n"
"        $clone->total = $total;\n"
"        return $clone;\n"
"    }\n"
"}\n"

#. type: Title ##
#: ../src/en/guide/concept/immutability.md
#, no-wrap
msgid "Usage style"
msgstr "Estilo de uso"

#. type: Bullet: '- '
#: ../src/en/guide/concept/immutability.md
msgid "Build a value object once and pass it around. If you need a change, use a `with*` method that returns a new instance."
msgstr "Crie um value object uma vez e passe-o adiante. Se precisar de uma mudança, use um método `with*` que retorna uma nova instância."

#. type: Bullet: '- '
#: ../src/en/guide/concept/immutability.md
msgid "Prefer scalar/immutable fields inside immutable objects; if a field can mutate, isolate it and deep-clone in `__clone` when needed."
msgstr "Prefira campos escalares/imutáveis dentro de objetos imutáveis; se um campo puder mudar, isole-o e faça a clonagem profunda em `__clone` quando necessário."

#. type: Plain text
#: ../src/en/guide/concept/immutability.md
msgid "Immutability aligns well with Yii's preference for predictable, side-effect-free code and makes services, caching, and configuration more robust."
msgstr "A imutabilidade combina bem com a preferência do Yii por código previsível e sem efeitos colaterais, e torna serviços, cache e configuração mais robustos."
