"                ->name('home'),\n"
"            Route::methods([Method::GET, Method::POST], '/say')\n"
"                ->action(Web\\Echo\\Action::class)\n"
"                ->name('echo/say'),\n"
"\n"
"            Group::create('/pages')->routes(\n"
"                Route::get('')\n"
"                    ->action(Web\\Page\\ListAction::class)\n"
"                    ->name('page/list'),\n"
"                Route::get('/{slug}')\n"
"                    ->action(Web\\Page\\ViewAction::class)\n"
"                    ->name('page/view'),\n"
