"        }\n"
"\n"
"        return $this->viewRenderer->render(__DIR__ . '/edit', [\n"
"            'form' => $form,\n"
"            'isNew' => $isNew,\n"
"            'slug' => $slug,\n"
"        ]);\n"
"    }\n"
"}\n"
