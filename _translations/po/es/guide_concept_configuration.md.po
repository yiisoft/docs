#. type: Title ##
#: ../src/cookbook/sentry-integration.md ../src/guide/concept/configuration.md
#: ../src/guide/tutorial/using-yii-with-frankenphp.md
#: ../src/guide/tutorial/using-yii-with-roadrunner.md
#: ../src/guide/views/view-injections.md
#, no-wrap
msgid "Configuration"
msgstr "Configuración"

#. type: Plain text
#: ../src/guide/concept/configuration.md
msgid "There are many ways to configure your application. We will focus on concepts used in the [default project template](https://github.com/yiisoft/app)."
msgstr "Hay muchas formas de configurar tu aplicación. Nos centraremos en los conceptos que usa la [plantilla de proyecto predeterminada](https://github.com/yiisoft/app)."

#. type: Plain text
#: ../src/guide/concept/configuration.md
msgid "Yii3 configs are part of the application. You can change many aspects of how the application works by editing configuration under `config/` directory."
msgstr "Las configuraciones de Yii3 forman parte de la aplicación. Puedes cambiar muchos aspectos del funcionamiento de la aplicación editando la configuración del directorio `config/`."

#. type: Title ##
#: ../src/guide/concept/configuration.md
#, no-wrap
msgid "Config plugin"
msgstr "Plugin de configuración"

#. type: Plain text
#: ../src/guide/concept/configuration.md
msgid "The application template uses [yiisoft/config](https://github.com/yiisoft/config) as a composer plugin to assemble configs."
msgstr "La plantilla de aplicación usa [yiisoft/config](https://github.com/yiisoft/config) como plugin de Composer para ensamblar las configuraciones."

#. type: Plain text
#: ../src/guide/concept/configuration.md
msgid "Packages provide default configurations through defined [config groups](https://github.com/yiisoft/config#config-groups)  in the `config-plugin` key in the `extra` section of the `composer.json`:"
msgstr "Los paquetes proporcionan configuraciones predeterminadas mediante [grupos de configuración](https://github.com/yiisoft/config#config-groups) definidos en la clave `config-plugin` de la sección `extra` de `composer.json`:"

#. type: Fenced code block (json)
#: ../src/guide/concept/configuration.md
#, no-wrap
msgid ""
"\"extra\": {\n"
"    \"config-plugin-options\": {\n"
"        \"source-directory\": \"config\",\n"
"    },\n"
"    \"config-plugin\": {\n"
"        \"params\": \"params.php\",\n"
"        \"web\": \"web.php\"\n"
"    }\n"
"}\n"
msgstr ""
"\"extra\": {\n"
"    \"config-plugin-options\": {\n"
"        \"source-directory\": \"config\",\n"
"    },\n"
"    \"config-plugin\": {\n"
"        \"params\": \"params.php\",\n"
"        \"web\": \"web.php\"\n"
"    }\n"
"}\n"

#. type: Plain text
#: ../src/guide/concept/configuration.md
msgid "After Composer updates autoload files, such as during `dump-autoload`, `install`, `require`, `update`, or `remove`, the plugin scans installed packages for configurations and writes a merge plan to `config/.merge-plan.php`.  The merge plan declares the order of merging found configurations into the final configuration to be passed to [DI container](di-container.md)."
msgstr "Cada vez que Composer actualiza los archivos de autocarga, por ejemplo durante `dump-autoload`, `install`, `require`, `update` o `remove`, el plugin examina los paquetes instalados en busca de configuraciones y escribe un plan de fusión en `config/.merge-plan.php`. El plan de fusión declara el orden en que se fusionan las configuraciones encontradas para obtener la configuración final que se pasa al [contenedor DI](di-container.md)."

#. type: Plain text
#: ../src/guide/concept/configuration.md
msgid "At runtime, `Yiisoft\\Config\\Config` loads the defined config groups according to that merge plan.  Configs are read in three layers:"
msgstr "En tiempo de ejecución, `Yiisoft\\Config\\Config` carga los grupos de configuración definidos según ese plan de fusión. Las configuraciones se leen en tres capas:"

#. type: Bullet: '1. '
#: ../src/guide/concept/configuration.md
msgid "Vendor package configs with default values."
msgstr "Configuraciones de los paquetes de terceros (vendor), con los valores predeterminados."

#. type: Bullet: '2. '
#: ../src/guide/concept/configuration.md
msgid "Root package configs from the application `config/` directory."
msgstr "Configuraciones del paquete raíz, del directorio `config/` de la aplicación."

#. type: Bullet: '3. '
#: ../src/guide/concept/configuration.md
msgid "Environment-specific configs from the application."
msgstr "Configuraciones de la aplicación específicas de cada entorno."

#. type: Plain text
#: ../src/guide/concept/configuration.md
#, no-wrap
msgid ""
"> [!WARNING]\n"
"> Config keys with the same name are not allowed within a single layer.\n"
msgstr ""
"> [!WARNING]\n"
"> No se permiten claves de configuración con el mismo nombre dentro de una misma capa.\n"

#. type: Plain text
#: ../src/guide/concept/configuration.md
msgid "The application template stores configurations in a PHP file instead of inline JSON:"
msgstr "La plantilla de aplicación guarda las configuraciones en un archivo PHP en lugar de escribirlas directamente en JSON:"

#. type: Fenced code block (json)
#: ../src/guide/concept/configuration.md
#, no-wrap
msgid ""
"\"extra\": {\n"
"    \"config-plugin-file\": \"config/configuration.php\"\n"
"}\n"
msgstr ""
"\"extra\": {\n"
"    \"config-plugin-file\": \"config/configuration.php\"\n"
"}\n"

#. type: Plain text
#: ../src/guide/concept/configuration.md
msgid "That file returns the same keys you could otherwise define in `composer.json`: `config-plugin`, `config-plugin-options`, and `config-plugin-environments`."
msgstr "Ese archivo devuelve las mismas claves que, de otro modo, podrías definir en `composer.json`: `config-plugin`, `config-plugin-options` y `config-plugin-environments`."

#. type: Fenced code block (php)
#: ../src/guide/concept/configuration.md
#, no-wrap
msgid ""
"use App\\Environment;\n"
"\n"
"return [\n"
"    'config-plugin-options' => [\n"
"        'source-directory' => 'config',\n"
"    ],\n"
"    'config-plugin' => [\n"
"        'params' => 'common/params.php',\n"
"        'params-web' => [\n"
"            '$params',\n"
"            'web/params.php',\n"
"        ],\n"
"        'params-console' => [\n"
"            '$params',\n"
"            'console/params.php',\n"
"        ],\n"
"        'bootstrap' => 'common/bootstrap.php',\n"
"        'bootstrap-web' => '$bootstrap',\n"
"        'bootstrap-console' => '$bootstrap',\n"
"        'di' => 'common/di/*.php',\n"
"        'di-web' => [\n"
"            '$di',\n"
"            'web/di/*.php',\n"
"        ],\n"
"        'di-console' => '$di',\n"
"        'di-delegates' => [],\n"
"        'di-delegates-console' => '$di-delegates',\n"
"        'di-delegates-web' => '$di-delegates',\n"
"        'di-providers' => [],\n"
"        'di-providers-web' => '$di-providers',\n"
"        'di-providers-console' => '$di-providers',\n"
"        'events' => [],\n"
"        'events-web' => '$events',\n"
"        'events-console' => '$events',\n"
"        'routes' => 'common/routes.php',\n"
"    ],\n"
"    'config-plugin-environments' => [\n"
"        Environment::DEV => [\n"
"            'params' => [\n"
"                'environments/dev/params.php',\n"
"            ],\n"
"        ],\n"
"        Environment::TEST => [\n"
"            'params' => [\n"
"                'environments/test/params.php',\n"
"            ],\n"
"        ],\n"
"        Environment::PROD => [\n"
"            'params' => [\n"
"                'environments/prod/params.php',\n"
"            ],\n"
"        ],\n"
"    ],\n"
"];\n"
msgstr ""
"use App\\Environment;\n"
"\n"
"return [\n"
"    'config-plugin-options' => [\n"
"        'source-directory' => 'config',\n"
"    ],\n"
"    'config-plugin' => [\n"
"        'params' => 'common/params.php',\n"
"        'params-web' => [\n"
"            '$params',\n"
"            'web/params.php',\n"
"        ],\n"
"        'params-console' => [\n"
"            '$params',\n"
"            'console/params.php',\n"
"        ],\n"
"        'bootstrap' => 'common/bootstrap.php',\n"
"        'bootstrap-web' => '$bootstrap',\n"
"        'bootstrap-console' => '$bootstrap',\n"
"        'di' => 'common/di/*.php',\n"
"        'di-web' => [\n"
"            '$di',\n"
"            'web/di/*.php',\n"
"        ],\n"
"        'di-console' => '$di',\n"
"        'di-delegates' => [],\n"
